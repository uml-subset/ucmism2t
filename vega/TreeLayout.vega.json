{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A Cartesian layout for a node-link diagram of hierarchical data. Built according to the Vega 'Tree Layout Example' at https://vega.github.io/vega/examples/tree-layout/.",
  "width": 1300,
  "height": 1600,
  "padding": 5,
  "signals": [
    {
      "name": "labels",
      "value": true
    },
    {
      "name": "layout",
      "value": "tidy"
    },
    {
      "name": "links",
      "value": "diagonal",
      "bind": {
        "input": "select",
        "options": [
          "line",
          "curve",
          "diagonal",
          "orthogonal"
        ]
      }
    },
    {
      "name": "separation",
      "value": true
    }
  ],
  "data": [
    {
      "name": "tree",
      "values": classData,
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": {
            "signal": "layout"
          },
          "size": [
            {
              "signal": "height"
            },
            {
              "signal": "width - 100"
            }
          ],
          "separation": {
            "signal": "separation"
          },
          "as": [
            "y",
            "x",
            "depth",
            "children"
          ]
        },
        {
          "type": "formula",
          "expr": "'../../rewrite.html#' + substring(datum.name, indexof(datum.name, '::')+2)",
          "as": "url"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": {
            "signal": "links"
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "range": {
        "scheme": "magma"
      },
      "domain": {
        "data": "tree",
        "field": "depth"
      },
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#ccc"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "size": {
            "value": 100
          },
          "stroke": {
            "value": "#fff"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "fill": {
            "scale": "color",
            "field": "depth"
          },
          "tooltip": {
            "signal": "{'Name': datum.name, 'Definition': datum.definition, 'Click': 'to open the details page (Ctrl+click for new tab, Shift+click for new window)'}"
          },
          "href": {
            "signal": "isValid(datum[\"url\"]) ? datum[\"url\"] : \"\"+datum[\"url\"]"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "text": {
            "field": "name"
          },
          "fontSize": {
            "value": 10
          },
          "baseline": {
            "value": "middle"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "dx": {
            "signal": "datum.children ? -7 : 7"
          },
          "align": {
            "signal": "datum.children ? 'right' : 'left'"
          },
          "opacity": {
            "signal": "labels ? 1 : 0"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Name': datum.name, 'Definition': datum.definition, 'Click': 'to open the details page (Ctrl+click for new tab, Shift+click for new window)'}"
          },
          "href": {
            "signal": "isValid(datum[\"url\"]) ? datum[\"url\"] : \"\"+datum[\"url\"]"
          }
        }
      }
    }
  ],
  "title": {
    "text": "Class Inheritance of the Model",
    "fontSize": 20,
    "subtitle": [
      "Class hierarchy from left to right.",
      "Sorted by package name and class name from top to bottom.",
      "⠀",
      "Move the mouse pointer over a class to see its definition.",
      "Click on a class to open the details page (Ctrl+click for new tab, Shift+click for new window)"
    ],
    "subtitleFontSize": 11,
    "subtitlePadding": 10
  }
}
