<project name="step1_generate" default="generate">
	
	<property name="pipeline.properties" value="pipeline.properties"/>
	<property file="${pipeline.properties}"/>
    
    <condition property="isWindows">
        <os family="windows" />
    </condition>

    <condition property="isUnix">
        <os family="unix" />
    </condition>
    
    <!-- <echoproperties /> -->
    
    <target name="generate" depends="generate_windows, generate_unix"/>

    <target name="generate_windows" if="isWindows">
        <exec dir="." executable="cmd">
            <arg line="/c TODO" />
        </exec>
    </target>

    <target name="generate_unix" if="isUnix">
        <exec executable="./ucmism2t-wrapper.sh">
            <env key="LAUNCHER" value="${launcher}"/>
            <arg line="-input ${model_file_eclipse}" />
            <arg line="-output ${generated_folder}" />
            <arg line="-config ${generic_properties},${model_properties}" />
        </exec>
    </target>

</project>
