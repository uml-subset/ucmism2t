<project name="step1_generate" default="generate">
    
    <!-- <property file="${generated_folder}/_currentModel.properties"/> -->

    <condition property="isWindows">
        <os family="windows" />
    </condition>

    <condition property="isUnix">
        <os family="unix" />
    </condition>
    
    <!-- <echoproperties /> -->
    
    <target name="generate" depends="startmessage, generate_windows, generate_unix, endmessage"/>
    
    <target name="startmessage">
        <echo message="--------------------" />				
        <echo message="Step 1 - generate started ..." />
    </target>
    
    <target name="endmessage">
        <echo message="----------" />				
        <echo message="Step 1 - generate completed. Files in: ${generated_folder}" />
    </target>
    
    <!-- TODO -->
    <target name="generate_windows" if="isWindows">
        <exec executable="cmd">
            <arg line="/c TODO" />
        </exec>
    </target>

    <target name="generate_unix" if="isUnix">
        <mkdir dir="${log_folder}" />
        <exec executable="${ucmism2t_dir}/pipeline/script/ucmism2t-wrapper.sh">
            <env key="LAUNCHER" value="${launcher}"/>
            <arg line="-input ${model_file_eclipse}" />
            <arg line="-output ${generated_folder}" />
            <arg line="-log ${log_folder}/step1_ucmism2t_acceleo.log" />
            <arg line="-config ${generic_properties},${model_properties}" />
            <!-- Split streams cleanly to both files and console logs -->
            <redirector output="${log_folder}/step1_generate.log" 
                        error="${log_folder}/step1_generate_error.log" 
                        alwayslog="true" />
        </exec>
    </target>

</project>
