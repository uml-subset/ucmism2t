<project name="step3_sphinx" default="sphinx">
	
	<property file="${generated_folder}/_currentModel.properties"/>
	<property name="html_title" value="UML Model: ${MODEL_TITLE} (${MODEL_ACRONYM} ${MODEL_MAJORVERSION}.${MODEL_MINORVERSION})"/>
	
	<!-- <echoproperties /> -->
	
	<target name="sphinx">
		<echo message="--------------------" />				
		<echo message="Step 3 - sphinx started ..." />
		<exec executable="sphinx-build">
			<env key="generated_folder" value="${generated_folder}"/>
			<env key="plantuml_jar" value="${plantuml_jar}"/>
			<arg line="-b html" />
			<arg line="-c ${ucmism2t_dir}/pipeline/sphinx/bookTheme" />
			<!-- similar output as in terminal window -->
			<arg line="-w ${log_folder}/step3_sphinx_error.log" />
			<arg line="-n" />
			<!-- suppresses terminal codes -->
			<arg line="-q" />
			<arg line="-D copyright=&quot;${COPYRIGHT}&quot;" />
			<arg line="-D html_logo=&quot;${logo_file}&quot;" />
			<arg line="-D html_title=&quot;${html_title}&quot;" />
			<arg line="${generated_folder}/${MODEL_SHORTNAME}/doc/_rst" />
			<arg line="${generated_folder}/${MODEL_SHORTNAME}/doc/_build" />
		</exec>
		<echo message="----------" />				
		<echo message="Step 3 - sphinx completed." />
		<echo message="Files in: ${generated_folder}/${MODEL_SHORTNAME}" />
		<echo message="Log files in: ${log_folder}" />
	</target>

</project>