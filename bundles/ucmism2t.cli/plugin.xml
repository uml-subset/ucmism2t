<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!--
  CLI Application Extension
  
  Registers the command-line application with the Eclipse runtime.
  This allows the application to be launched as a standalone executable.
-->
<plugin>
   <extension id="app" point="org.eclipse.core.runtime.applications">
      <application cardinality="singleton-global" thread="main" visible="true">
         <run class="ucmism2t.cli.Main"/>
      </application>
   </extension>
</plugin>
