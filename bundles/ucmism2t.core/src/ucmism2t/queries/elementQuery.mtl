[comment encoding = UTF-8 /]

[**
Module contains queries with a UML element or named element as receiver.
/]
[module elementQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::modelQuery/]
[import ucmism2t::services::PropertiesService /]

[**
 * Returns the root model that owns the specified element,
 * by navigating up the containment hierarchy to the first
 * uml::Model ancestor. Returns the element itself if it
 * is already a uml::Model. AQL equivalent of getModel().
 *
 * @param anElement - A UML element whose owning model is
 *                    to be retrieved. May itself be a
 *                    uml::Model.
/]
[query public u_model(
  anElement : uml::Element) : uml::Model =
  if anElement.oclIsKindOf(uml::Model)
  then anElement.oclAsType(uml::Model)
  else anElement.ancestors(uml::Model)->first()
  endif
/]

[**
Returns the direct parent of the specified element in the UML
containment hierarchy. AQL equivalent of eContainer().

@param anElement - A UML element whose direct parent is to be retrieved.
/]
[comment] [query public u_parent(
  anElement : uml::Element) : uml::Element =
  anElement.ancestors(uml::Element)->first()
/]
[/comment]
[**
Returns the direct parent of the specified named element in the UML
containment hierarchy. AQL equivalent of eContainer().

@param aNamedElement - A UML named element whose direct parent is to be retrieved.
/]
[query public u_parent(
  aNamedElement : uml::NamedElement) : uml::NamedElement =
  aNamedElement.ancestors(uml::NamedElement)->first()
/]

[**
Returns the nearest containing package of the specified named
element, by navigating up the containment hierarchy to the
first uml::Package ancestor.
- For a uml::Class or any non-package element: returns the
  directly owning package.
- For a uml::Package: returns the parent package.
- For a uml::Model (no container): returns itself as there
  is no parent package to navigate to.

@param aNamedElement - A UML named element.
/]
[query public u_nearestPackage(
  aNamedElement : uml::NamedElement) : uml::Package =
  if aNamedElement.oclIsKindOf(uml::Model)
  then aNamedElement.oclAsType(uml::Model)
  else aNamedElement.ancestors(uml::Package)->first()
  endif
/]

[**
Returns the nearest package that directly or indirectly owns the
specified element, by navigating up the containment hierarchy to
the first uml::Package ancestor.

@param anElement - A UML element whose nearest containing package
                   is to be retrieved.
/]
[comment] [query public u_nearestPackage(
  anElement : uml::Element) : uml::Package =
  anElement.ancestors(uml::Package)->first()
/]
[/comment]
[**
Returns the nearest package that directly or indirectly owns the
specified named element, by navigating up the containment hierarchy to
the first uml::Package ancestor.

@param aNamedElement - A UML named element whose nearest containing package
                   is to be retrieved.
/]
[comment] [query public OK2u_nearestPackage(
  aNamedElement : uml::NamedElement) : uml::Package =
  if aNamedElement.oclIsKindOf(uml::Model)
  then aNamedElement.oclAsType(uml::Model)
  else
  aNamedElement.ancestors(uml::Package)->first()
  endif
/]
[query public OKu_nearestPackage(
  aNamedElement : uml::NamedElement) : uml::Package =
  aNamedElement.ancestors(uml::Package)->first()
/]
[/comment]
[**
Returns the qualified name of the specified element in the form
'package::element', using the nearest containing package name.

@param anElement - A UML named element whose package-qualified
                   name is to be retrieved.
/]
[query public u_packageQualifiedName(
  anElement : uml::NamedElement) : String =
  anElement.u_nearestPackage().name + '::' + anElement.name
/]

[query public u_commentBody(
  anElement : uml::Element) : String =
  if anElement.ownedComment->notEmpty()
  then anElement.ownedComment->first().body
    .replaceAll('\\r\\n', '\\n')
    .replaceAll('[\\p{C}&&[^\\r\\n\\t]]', ' ')
    .replaceAll('[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]', ' ')
    .replaceAll(' ', ' ')
    .trim()
  else
    if 'WARNING_MISSING_DOCUMENTATION'.isPropertyTrue()
    then 'WARNING: element has no documentation!'
    else ''
    endif
  endif
/]

[**
 * Returns the body of the first owned comment of the specified
 * element if it exists, trimmed of leading and trailing spaces,
 * or a warning message if the element has no comment and the
 * 'WARNING_MISSING_DOCUMENTATION' property is set to true,
 * or an empty string otherwise.
 *
 * @param anElement - A UML element whose first comment body
 *                    is to be retrieved.
/]
[comment] [query public OKu_commentBody(
  anElement : uml::Element) : String =
  if anElement.ownedComment->notEmpty()
  then anElement.ownedComment->first().body.trim()
  else
    if 'WARNING_MISSING_DOCUMENTATION'.isPropertyTrue()
    then 'WARNING: ELEMENT HAS NO DOCUMENTATION!'
    else ''
    endif
  endif
/]
[/comment][**
Returns the body of the first owned comment of the specified
element if it exists, trimmed of leading and trailing spaces,
or a warning message otherwise.

@param anElement - A UML element whose first comment body
                   is to be retrieved.
/]
[comment] [query public Xu_commentBody(
  anElement : uml::Element) : String =
  if anElement.ownedComment->notEmpty() then
    anElement.ownedComment->first().body.trim()
  else if 'WARNING_MISSING_DOCUMENTATION'.isPropertyTrue()
    'WARNING: ELEMENT HAS NO DOCUMENTATION!'
  else
    ''
  endif
  endif
/]
[/comment]
[**
Returns the first 100 characters of the first owned comment body
of the specified element, followed by a newline and '...'
if truncated. Returns a warning if there are no owned comments.

@param aNamedElement - A UML element.
/]
[query public u_shortDocumentation(
  anElement : uml::Element) : String =
  let d : String = anElement.u_commentBody() in
  if d = '' then
    'WARNING: element has no documentation'
  else if d.size() > 100 then
    d.substring(1, 100) + '\n...'
  else
    d
  endif
  endif
/]

[**
Returns the definition text extracted from the first owned comment
of the specified named element:
- strips section headings (Definition, Examples, Explanatory notes)
- normalises whitespace
- escapes curly braces as Unicode literals
- truncates to 300 characters if longer
Returns a warning string if there are no owned comments.

@param aNamedElement - A UML named element.
/]
[query public u_onlyDefinition(
  aNamedElement : uml::NamedElement) : String =
  let s : String =
    aNamedElement.u_commentBody()
      .replace('Explanatory notes[\\s\\S\\"=]+', '')
      .replace('Examples[\\s\\S\\"=]+', '')
      .replace('Definition[\\s\\S]+?[\\"=]+\\s+', '')
      .replaceAll('[\\s\\n\\r]+', ' ')
      .replaceAll('\\{', '<U+007B>')
      .replaceAll('\\}', '<U+007D>')
      .trim()
  in
  if s.size() > 300 then
    s.substring(1, 300).trim().concat(' ...')
  else
    s
  endif
/]

[**
Returns the path of the specified element below the model root,
using '/' as the separator between path segments.

@param aNamedElement - A UML named element.
/]
[query public u_path(
  aNamedElement : uml::NamedElement) : String =
  let modelPrefix : String = aNamedElement.u_model().name.concat('::') in
  aNamedElement.qualifiedName
    .replace(modelPrefix, '')
    .replaceAll('::', '/')
/]

[**
Returns a named element that is a direct or indirect child of the
specified named element, matched by name. Returns null if not found.

@param aNamedElement - A UML named element used as search root.
@param aName - The name to search for.
/]
[query public u_namedElementByName(
  aNamedElement : uml::NamedElement,
  aName : String) : uml::NamedElement =
  aNamedElement.eAllContents(uml::NamedElement)
    ->select(n | n.name = aName)
    ->first()
/]

[**
Returns true if the specified named element is a child of the main
package and not contained in any ignored package
listed in the IGNORE_PACKAGE property.

@param aNamedElement - A UML named element.
/]
[query public u_isInAllowedPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  aNamedElement <> null
  and aNamedElement.u_model()
    .u_mainPackage()
    .eAllContents(uml::NamedElement)
    ->includes(aNamedElement)
  and aNamedElement.u_isNotInIgnoredPackage()
/]

[**
Returns true if the specified named element is not contained in
any package listed in the IGNORE_PACKAGE property
(comma-separated list of package names).

@param aNamedElement - A UML named element.
/]
[query public u_isNotInIgnoredPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  'IGNORE_PACKAGE'.getPropertyValue()
    .substituteAll(' ', '')
    .tokenize(',')
    ->collect(p | aNamedElement.u_model().u_namedElementByName(p))
    ->excludes(aNamedElement)
/]

[**
Returns true if the specified named element is a direct or indirect
child of the main package.

@param aNamedElement - A UML named element.
/]
[query public u_isChildOfMainPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  let mainPkg : uml::Package = aNamedElement.u_model().u_mainPackage() in
  mainPkg.eAllContents(uml::NamedElement)->includes(aNamedElement)
/]

[**
 * Returns the output file path for the specified element, target
 * format, and package context, using the model short name as the
 * root segment.
 *
 * The path below the target segment depends on aPackage:
 * - If aPackage is the model itself, the full qualified name of
 *   aNamedElement is used, with '::' replaced by '/'.
 * - Otherwise, the qualified name of aPackage is used as the parent
 *   path and the simple name of aNamedElement is appended as the
 *   final path segment.
 *
 * For the 'doc' target, the model name segment in the computed path
 * is replaced with '_rst'.
 *
 * Examples:
 * - target = 'xsd', aPackage = model
 *   -> 'shortName/xsd/pkg/ClassName'
 * - target = 'doc', aPackage = model
 *   -> 'shortName/doc/_rst/pkg/ClassName'
 * - target = 'xsd', aPackage = nested package
 *   -> 'shortName/xsd/model/pkg/SubPkg/ClassName'
 *
 * Note: The path construction uses the standard AQL string services
 * replaceAll() and replace(). Equality comparison uses '='. [web:712][web:731]
 *
 * @param aNamedElement - A UML named element.
 * @param aTarget - The generation target format identifier
 *                  (e.g. 'xsd', 'doc').
 * @param aPackage - The package that determines whether the element
 *                   path is computed from the element qualified name
 *                   or from the package qualified name plus the
 *                   element simple name.
 * @return The output file path for the named element and target.
 */]
[query public u_filePath(
  aNamedElement : uml::NamedElement,
  aTarget : String,
  aPackage : uml::Package) : String =
  let root : String =
    aNamedElement.u_model().u_modelShortName() + '/' + aTarget + '/'
  in
  let path : String =
    if aPackage = aNamedElement.u_model()
    then aNamedElement.qualifiedName.replaceAll('::', '/')
    else aPackage.qualifiedName.replaceAll('::', '/') + '/' + aNamedElement.name
    endif
  in
  if aTarget = 'doc'
  then root + path.replace(aNamedElement.u_model().name, '_rst')
  else root + path
  endif
/]

[**
Returns the output file path for the specified element and target
format, using the model short name as the root segment.
For the 'doc' target, the model name segment is replaced with '_rst'.
Example: 'xsd' → 'shortName/xsd/pkg/ClassName'
         'doc' → 'shortName/doc/_rst/pkg/ClassName'

@param aNamedElement - A UML named element.
@param aTarget - The generation target format identifier
                 (e.g. 'xsd', 'doc').
/]
[query public u_filePath(
  aNamedElement : uml::NamedElement,
  aTarget : String) : String =
  let root : String = aNamedElement.u_model().u_modelShortName()
    + '/' + aTarget + '/'
  in
  let path : String =
    aNamedElement.qualifiedName.replaceAll('::', '/')
  in
  if aTarget = 'doc' then
    root + path.replace(aNamedElement.u_model().name, '_rst')
  else
    root + path
  endif
/]

[query public u_profileFilePath(
  aNamedElement : uml::NamedElement,
  aTarget : String) : String =
  let root : String = aNamedElement.u_model().u_modelShortName()
    + '/' + aTarget + '/'
  in
  let path : String =
    aNamedElement.qualifiedName.replaceAll('::', '/')
  in
  if aTarget = 'doc' then
    root + path.replace(aNamedElement.u_model().name, '_rst')
  else
    root + path
  endif
/]

[**
 * Returns the nearest DataType named 'PackageInformation' found by
 * walking up the package containment hierarchy from aNamedElement.
 *
 * Starting from the nearest owning package of aNamedElement, the query
 * searches for a DataType named 'PackageInformation' in that package's
 * direct contents. If none is found, it recurses upward through the
 * package hierarchy. The model root is always searched before the
 * recursion terminates — if no match is found at any level, null
 * is returned.
 *
 * Termination is guaranteed because u_nearestPackage() called on a
 * uml::Package returns its owning package (not itself), so the recursion
 * always moves upward and stops when the uml::Model root is reached.
 *
 * @param aNamedElement - The UML named element from which to start the search.
 * @return The nearest PackageInformation DataType, or null if none found.
 * @see u_packageInformation - resolves PackageInformation with
 *      fallback to ModelIdentification for legacy models.
 */]
[query public u_nearestPackageInformation(
  aNamedElement : uml::NamedElement) : uml::DataType =
  let nearestPackage : uml::Package =
    aNamedElement.u_nearestPackage() in
  let packageIdentification : uml::DataType =
    nearestPackage.eContents(uml::DataType)
      ->select(d | d.name = 'PackageInformation')
      ->first() in
  if packageIdentification <> null
  then packageIdentification
  else
    if nearestPackage.oclIsKindOf(uml::Model)
    then null
    else nearestPackage.u_nearestPackageInformation()
    endif
  endif
/]

[**
 * Returns the PackageInformation or ModelIdentification DataType relevant to aNamedElement,
 * supporting both structured models and legacy models.
 *
 * Resolution order:
 * (1) The nearest PackageInformation found by walking up the package
 *     hierarchy from aNamedElement (via u_nearestPackageInformation).
 * (2) If none is found, any ModelIdentification present anywhere in
 *     the model — intended for legacy models that have a single
 *     ModelIdentification not placed at a specific package level.
 * (3) null if no ModelIdentification exists anywhere in the model.
 *
 * @param aNamedElement - The UML named element for which to resolve
 *                        the PackageInformation or ModelIdentification.
 * @return The relevant ModelIdentification DataType, or null if none found.
 */]
[query public u_packageInformation(aNamedElement : uml::NamedElement) : uml::DataType =
  let nearestPackageInformation : uml::DataType =
    aNamedElement.u_nearestPackageInformation() in
  let modelIdentification : uml::DataType =
    aNamedElement.u_model().eAllContents(uml::DataType)
      ->select(d | d.name = 'ModelIdentification')
      ->first() in
  if nearestPackageInformation <> null
  then nearestPackageInformation
  else modelIdentification
  endif
/]

[**
Returns the default value of a named property from the
PackageInformation or ModelIdentification DataType relevant
to aNamedElement, or an empty string if no ModelIdentification,
no matching property, or no default value is found.
Note: An explicit oclAsType(uml::Property) cast is required after
->first() because AQL loses the concrete type when the let binding's
else branch returns null.

@param aNamedElement  - The UML named element for which to resolve
                        the ModelIdentification property.
@param aPropertyName  - The name of the property to retrieve
                        (e.g. 'acronym', 'version', 'author').
@return The default value string, or '' if not found.
/]
[query public u_packageInformationProperty(
  aNamedElement : uml::NamedElement,
  aPropertyName : String) : String =
  let packageInformation : uml::DataType =
    aNamedElement.u_packageInformation()
  in
  let property : uml::Property =
    if packageInformation <> null
    then packageInformation.eContents(uml::Property)
           ->select(p | p.name = aPropertyName)
           ->first()
    else null
    endif
  in
  if property <> null
  then
    let typedProperty : uml::Property =
      property.oclAsType(uml::Property) in
    if typedProperty.default <> null
    then typedProperty.default
    else ''
    endif
  else ''
  endif
/]

[**
 * Returns the model language for aNamedElement. The value is determined
 * in order of priority:
 * (1) MODEL_LANGUAGE config property,
 * (2) 'language' property of the relevant PackageInformation or ModelIdentification DataType,
 * (3) 'en' as fallback.
 *
 * @param aNamedElement - The UML named element for which to resolve
 *                        the model language.
 * @return The language string, or 'en' if not found.
 */]
[query public u_modelLanguage(
  aNamedElement : uml::NamedElement) : String =
  let propertyLanguage : String =
    'MODEL_LANGUAGE'.getPropertyValue()
  in
  let modelLanguage : String =
    aNamedElement.u_packageInformationProperty('language')
  in
  if propertyLanguage <> ''
  then propertyLanguage
  else
    if modelLanguage <> ''
    then modelLanguage
    else 'en'
    endif
  endif
/]

[**
 * Returns the model acronym for aNamedElement. The value is determined
 * in order of priority:
 * (1) MODEL_ACRONYM config property,
 * (2) 'acronym' property of the relevant PackageInformation or ModelIdentification DataType,
 * (3) the model name,
 * (4) 'UNKNOWN_MODEL' as final fallback.
 *
 * @param aNamedElement - The UML named element for which to resolve
 *                        the model acronym.
 * @return The acronym string, or 'UNKNOWN_MODEL' if not found.
 */]
[query public u_modelAcronym(
  aNamedElement : uml::NamedElement) : String =
  let propertyAcronym : String =
    'MODEL_ACRONYM'.getPropertyValue()
  in
  let modelAcronym : String =
    aNamedElement.u_packageInformationProperty('acronym')
  in
  if propertyAcronym <> ''
  then propertyAcronym
  else
    if modelAcronym <> ''
    then modelAcronym
    else
      if aNamedElement.u_model().name <> ''
      then aNamedElement.u_model().name
      else 'UNKNOWN_MODEL'
      endif
    endif
  endif
/]

[**
 * Returns the model major version for aNamedElement. The value is determined
 * in order of priority:
 * (1) MODEL_MAJOR_VERSION config property,
 * (2) 'majorVersion' property of the relevant PackageInformation or ModelIdentification DataType,
 * (3) 'NOT_SET' as fallback.
 *
 * @param aNamedElement - The UML named element for which to resolve
 *                        the model major version.
 * @return The major version as string, or 'NOT_SET' if not found.
 */]
[query public u_modelMajorVersion(
  aNamedElement : uml::NamedElement) : String =
  let propertyMajorVersion : String =
    'MODEL_MAJOR_VERSION'.getPropertyValue()
  in
  let modelMajorVersion : String =
    aNamedElement.u_packageInformationProperty('majorVersion')
  in
  if propertyMajorVersion <> ''
  then propertyMajorVersion
  else
    if modelMajorVersion <> ''
    then modelMajorVersion
    else 'NOT_SET'
    endif
  endif
/]

