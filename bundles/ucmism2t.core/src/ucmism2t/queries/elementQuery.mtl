[query public u_modelShortName(aNamedElement : uml::NamedElement) : String =
  aNamedElement.u_modelAcronym()
    + '_'
    + aNamedElement.u_modelMajorVersion()
    + '-'
    + aNamedElement.u_modelMinorVersion()
/] 
