[comment encoding = UTF-8 /]

[**
Module contains queries with a UML element or named element as receiver.
/]
[module elementQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::modelQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::query::oldModelQuery/]

[**
Returns the root model that owns the specified element,
by navigating up the containment hierarchy to the first
uml::Model ancestor. AQL equivalent of getModel().

@param anElement - A UML element whose owning model is
                   to be retrieved.
/]
[query public u_model(
  anElement : uml::Element) : uml::Model =
  anElement.ancestors(uml::Model)->first()
/]

[**
Returns the direct parent of the specified element in the UML
containment hierarchy. AQL equivalent of eContainer().

@param anElement - A UML element whose direct parent is to be retrieved.
/]
[query public u_parent(
  anElement : uml::Element) : uml::Element =
  anElement.ancestors(uml::Element)->first()
/]

[**
Returns the direct parent of the specified named element in the UML
containment hierarchy. AQL equivalent of eContainer().

@param aNamedElement - A UML named element whose direct parent is to be retrieved.
/]
[query public u_parent(
  aNamedElement : uml::NamedElement) : uml::NamedElement =
  aNamedElement.ancestors(uml::NamedElement)->first()
/]

[**
Returns the nearest package that directly or indirectly owns the
specified element, by navigating up the containment hierarchy to
the first uml::Package ancestor.

@param anElement - A UML element whose nearest containing package
                   is to be retrieved.
/]
[query public u_nearestPackage(
  anElement : uml::Element) : uml::Package =
  anElement.ancestors(uml::Package)->first()
/]

[**
Returns the nearest package that directly or indirectly owns the
specified named element, by navigating up the containment hierarchy to
the first uml::Package ancestor.

@param aNamedElement - A UML named element whose nearest containing package
                   is to be retrieved.
/]
[query public u_nearestPackage(
  aNamedElement : uml::NamedElement) : uml::Package =
  aNamedElement.ancestors(uml::Package)->first()
/]

[**
Returns the qualified name of the specified element in the form
'package::element', using the nearest containing package name.

@param anElement - A UML named element whose package-qualified
                   name is to be retrieved.
/]
[query public u_packageQualifiedName(
  anElement : uml::NamedElement) : String =
  anElement.u_nearestPackage().name + '::' + anElement.name
/]

[**
Returns the body of the first owned comment of the specified
element if it exists, trimmed of leading and trailing spaces,
or a warning message otherwise.

@param anElement - A UML element whose first comment body
                   is to be retrieved.
/]
[query public u_commentBody(
  anElement : uml::Element) : String =
  if anElement.ownedComment->notEmpty() then
    anElement.ownedComment->first().body.trim()
  else
    'WARNING: ELEMENT HAS NO DOCUMENTATION!'
  endif
/]

[**
Returns the first 100 characters of the first owned comment body
of the specified element, followed by a newline and '...'
if truncated. Returns a warning if there are no owned comments.

@param aNamedElement - A UML element.
/]
[query public u_shortDocumentation(
  anElement : uml::Element) : String =
  let d : String = anElement.u_commentBody() in
  if d = '' then
    'WARNING: element has no documentation'
  else if d.size() > 100 then
    d.substring(1, 100) + '\n...'
  else
    d
  endif
  endif
/]

[**
Returns the definition text extracted from the first owned comment
of the specified named element:
- strips section headings (Definition, Examples, Explanatory notes)
- normalises whitespace
- escapes curly braces as Unicode literals
- truncates to 300 characters if longer
Returns a warning string if there are no owned comments.

@param aNamedElement - A UML named element.
/]
[query public u_onlyDefinition(
  aNamedElement : uml::NamedElement) : String =
  let s : String =
    aNamedElement.u_commentBody()
      .replace('Explanatory notes[\\s\\S\\"=]+', '')
      .replace('Examples[\\s\\S\\"=]+', '')
      .replace('Definition[\\s\\S]+?[\\"=]+\\s+', '')
      .replaceAll('[\\s\\n\\r]+', ' ')
      .replaceAll('\\{', '<U+007B>')
      .replaceAll('\\}', '<U+007D>')
      .trim()
  in
  if s.size() > 300 then
    s.substring(1, 300).trim().concat(' ...')
  else
    s
  endif
/]

[**
Returns the path of the specified element below the model root,
using '/' as the separator between path segments.

@param aNamedElement - A UML named element.
/]
[query public u_path(
  aNamedElement : uml::NamedElement) : String =
  let modelPrefix : String = aNamedElement.u_model().name.concat('::') in
  aNamedElement.qualifiedName
    .replace(modelPrefix, '')
    .replaceAll('::', '/')
/]

[**
Returns a named element that is a direct or indirect child of the
specified named element, matched by name. Returns null if not found.

@param aNamedElement - A UML named element used as search root.
@param aName - The name to search for.
/]
[query public u_namedElementByName(
  aNamedElement : uml::NamedElement,
  aName : String) : uml::NamedElement =
  aNamedElement.eAllContents(uml::NamedElement)
    ->select(n | n.name = aName)
    ->first()
/]

[**
Returns true if the specified named element is a child of the main
package and not contained in any ignored package.

@param aNamedElement - A UML named element.
/]
[query public u_isInAllowedPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  aNamedElement <> null
  and aNamedElement.u_model()
    .u_mainPackage()
    .eAllContents(uml::NamedElement)
    ->includes(aNamedElement)
  and aNamedElement.u_isNotInIgnoredPackage()
/]

[**
Returns true if the specified named element is not contained in
any package listed in the IGNORE_PACKAGE property
(comma-separated list of package names).

@param aNamedElement - A UML named element.
/]
[query public u_isNotInIgnoredPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  'IGNORE_PACKAGE'.getPropertyValue()
    .substituteAll(' ', '')
    .tokenize(',')
    ->collect(p | aNamedElement.u_model().u_namedElementByName(p))
    ->excludes(aNamedElement)
/]

[**
Returns true if the specified named element is a direct or indirect
child of the main package.

@param aNamedElement - A UML named element.
/]
[query public u_isChildOfMainPackage(
  aNamedElement : uml::NamedElement) : Boolean =
  let mainPkg : uml::Package = aNamedElement.u_model().u_mainPackage() in
  mainPkg.eAllContents(uml::NamedElement)->includes(aNamedElement)
/]

[**
Returns the output file path for the specified element and target
format, using the model short name as the root segment.
For the 'doc' target, the model name segment is replaced with '_rst'.
Example: 'xsd' → 'shortName/xsd/pkg/ClassName'
         'doc' → 'shortName/doc/_rst/pkg/ClassName'

@param aNamedElement - A UML named element.
@param aTarget - The generation target format identifier
                 (e.g. 'xsd', 'doc').
/]
[query public u_filePath(
  aNamedElement : uml::NamedElement,
  aTarget : String) : String =
  let root : String = aNamedElement.u_model().e_modelShortName()
    + '/' + aTarget + '/'
  in
  let path : String =
    aNamedElement.qualifiedName.replaceAll('::', '/')
  in
  if aTarget = 'doc' then
    root + path.replace(aNamedElement.u_model().name, '_rst')
  else
    root + path
  endif
/]
