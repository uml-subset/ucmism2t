[comment encoding = UTF-8 /]
[**
 * The documentation of the module m2t.
 * Helper Queries Module
 * 
 * This module contains reusable AQL queries that can be imported
 * and used across multiple templates. Queries are pure functions
 * that return computed values without generating text.
 * 
 * Import with:
 *   [import ucmism2t::queries::helpers /]
 */]
[module helpers('http://www.eclipse.org/uml2/5.0.0/UML')]

[** 
 * Query: Get All Classes
 * 
 * Returns all Class elements contained anywhere in the model hierarchy.
 * Uses allOwnedElements() to recursively traverse the model tree.
 * 
 * @param model The root UML Model
 * @return Sequence of all Class elements in the model
/]
[query public getAllClasses(model : Model) : Sequence(Class) = 
    model.allOwnedElements()->filter(Class)
/]

[comment 
  Query: Get All Packages
  
  Returns all Package elements in the model hierarchy.
  
  @param model The root UML Model
  @return Sequence of all Package elements
/]
[query public getAllPackages(model : Model) : Sequence(Package) = 
    model.allOwnedElements()->filter(Package)
/]

[comment 
  Query: Is Entity
  
  Checks if a class has the «Entity» stereotype applied.
  Useful for JPA/ORM code generation.
  
  @param cls The UML Class to check
  @return true if Entity stereotype is applied
/]
[query public isEntity(cls : Class) : Boolean = 
    cls.getAppliedStereotypes()->exists(s | s.name = 'Entity')
/]

[comment 
  Query: Is Service
  
  Checks if a class has the «Service» stereotype applied.
  Useful for service layer code generation.
  
  @param cls The UML Class to check
  @return true if Service stereotype is applied
/]
[query public isService(cls : Class) : Boolean = 
    cls.getAppliedStereotypes()->exists(s | s.name = 'Service')
/]

[comment 
  Query: Get Persistent Classes
  
  Returns all classes that have persistence-related stereotypes.
  Looks for «Entity», «Persistent», or «Table» stereotypes.
  
  @param model The root UML Model
  @return Sequence of persistent Class elements
/]
[query public getPersistentClasses(model : Model) : Sequence(Class) = 
    model.getAllClasses()->select(cls | 
        cls.getAppliedStereotypes()->exists(s | 
            s.name = 'Entity' or s.name = 'Persistent' or s.name = 'Table'
        )
    )
/]

[comment 
  Query: Get Class Attributes Only
  
  Returns only the attributes defined directly in the class,
  excluding inherited attributes and association ends.
  
  @param cls The UML Class
  @return Sequence of owned attributes (non-navigable)
/]
[query public getOwnedAttributes(cls : Class) : Sequence(Property) = 
    cls.ownedAttribute->select(attr | 
        attr.association = null
    )
/]

[comment 
  Query: Get Association Ends
  
  Returns only the properties that represent association ends.
  
  @param cls The UML Class
  @return Sequence of association end properties
/]
[query public getAssociationEnds(cls : Class) : Sequence(Property) = 
    cls.ownedAttribute->select(attr | 
        attr.association <> null
    )
/]

[comment 
  Query: Has Operations
  
  Checks if a class has any operations defined.
  
  @param cls The UML Class to check
  @return true if class has operations
/]
[query public hasOperations(cls : Class) : Boolean = 
    not cls.ownedOperation->isEmpty()
/]

[comment 
  Query: Has Attributes
  
  Checks if a class has any attributes defined.
  
  @param cls The UML Class to check
  @return true if class has attributes
/]
[query public hasAttributes(cls : Class) : Boolean = 
    not cls.ownedAttribute->isEmpty()
/]

[comment 
  Query: Get Root Packages
  
  Returns only top-level packages (those directly under the model).
  
  @param model The root UML Model
  @return Sequence of root-level Package elements
/]
[query public getRootPackages(model : Model) : Sequence(Package) = 
    model.nestedPackage
/]

[comment 
  Query: Count Elements
  
  Counts the total number of elements of a specific type in the model.
  
  @param model The root UML Model
  @return Integer count of all elements
/]
[query public countAllElements(model : Model) : Integer = 
    model.allOwnedElements()->size()
/]
