[comment encoding = UTF-8 /]
[**
Module contains queries which use properties.
/]
[module configurationQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::query::oldModelQuery/]

[**
 * Returns the title of the subset
 * @param anEObject Any type.
*/]
[query public e_subsetTitle(anEObject : ecore::EObject) : String =
	('subset.name'.getPropertyValue() + '.' + 'title').getPropertyValue()
/]

[**
 * Returns a sequence of names of the subset classes
 * @param Any type.
*/]
[query public e_subsetClasses(anEObject : ecore::EObject) : Sequence(String) =
	('subset.name'.getPropertyValue() + '.' + 'class').
		getPropertyValue().
		replaceAll('\\s', '').
		tokenize(',')
/]

[**
 * Returns a sequence of names of the generalized subset classes
 * @param Any type.
*/]
[query public e_subsetGeneralizedClasses(anEObject : ecore::EObject) : Sequence(String) = 
	('subset.name'.getPropertyValue() + '.' + 'generalizedClass')
		.getPropertyValue()
		.replaceAll('\\s', '')
		.tokenize(',')
/]

[**
 * Returns a sequence of names of all subset classes
 * @param anEObject Any type.
*/]
[query public e_subsetAllClasses(anEObject : ecore::EObject) : Sequence(String) =
	anEObject.e_subsetClasses()->union(anEObject.e_subsetGeneralizedClasses())
/]

[**
 * Returns a sequence of names of the subset data types
 * @param anEObject Any type.
*/]
[query public e_subsetDataTypes(anEObject : ecore::EObject) : Sequence(String) =
	('subset.name'.getPropertyValue() + '.' + 'dataType')
		.getPropertyValue()
		.replaceAll('\\s', '')
		.tokenize(',')
/]

[**
 * Returns a sequence of names of the subset enumerations
 * @param anEObject Any type.
*/]
[query public e_subsetEnumerations(anEObject : ecore::EObject) : Sequence(String) =
	('subset.name'.getPropertyValue() + '.' + 'enumeration')
		.getPropertyValue()
		.replaceAll('\\s', '')
		.tokenize(',')
/]

[**
 * Returns a sequence of names of all subset items (classes, data types, enumerations)
 * @param anEObject Any type.
*/]
[query public e_subsetItems(anEObject : ecore::EObject) : Sequence(String) =
	anEObject.e_subsetAllClasses()->union(anEObject.e_subsetDataTypes())->union(anEObject.e_subsetEnumerations())
/]

[**
 * Returns a sequence of names of attributes of a specific class of the subset
 * @param anEObject Any type.
*/]
[query public e_subsetClassAttributes(aClassName : String) : Sequence(String) =
	('subset.name'.getPropertyValue() + '.' + 'class' + '.' + aClassName)
		.getPropertyValue()
		.replaceAll('\\s', '')
		.tokenize(',')
/]

[**
 * Returns a sequence of names of attributes of a specific data type of the subset
 * @param anEObject Any type.
*/]
[query public e_subsetDataTypeAttributes(aDataTypeName : String) : Sequence(String) =
  ('subset.name'.getPropertyValue() + '.' + 'dataType' + '.' + aDataTypeName)
  	.getPropertyValue()
  	.replaceAll('\\s', '')
  	.tokenize(',')
/]

[**
 Returns an ordered set of package qualified name segments that
 contain at least one classifier whose simple name appears in
 u_subsetItems(). Each segment is a '::'-separated token of the
 qualifier prefix of a matching classifier's qualified name.

 @param aModel - A UML model.
/]
[query public u_subsetPackages(
  aModel : uml::Model) : OrderedSet(String) =
  let mainPkg : uml::Package = aModel.e_mainPackage() in
  mainPkg.eAllContents(uml::Classifier)
    ->collect(c | c.qualifiedName)
    ->select(s | aModel.e_subsetItems()->includes(
        s.substring(s.lastIndex('::') + 2)))
    ->collect(s | s.substring(1, s.lastIndex('::') - 1))
    ->collect(s | s.tokenize('::'))
    ->asOrderedSet()
/]