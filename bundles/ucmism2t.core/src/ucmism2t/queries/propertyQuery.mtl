[comment encoding = UTF-8 /]

[**
Module contains queries with a UML property as receiver.
This includes queries for retrieving property metadata
(multiplicity, cardinality), classifying properties as
attributes or association ends, and navigating to the
owning classifier or association.

Note: In UML, association ends are represented as
properties. Queries in this module handle both plain
attributes (association = null) and association ends
(association <> null). The distinction is made explicit
in the query documentation where relevant.

Note: Queries that find properties starting from a class
or data type are in classQuery and dataTypeQuery
respectively, since their receiver is the owning
classifier rather than the property itself.

Related modules:
- classQuery: queries with a UML class as receiver,
  including queries that find attributes and
  association ends of a class
- dataTypeQuery: queries with a UML data type as receiver,
  including queries that find attributes of a data type
- associationQuery: queries with a UML association as
  receiver, since association ends are properties
/]
[module propertyQuery(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::eobjectQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::stringQuery/]

[**
Returns the cardinality of a property in ShEx syntax:
'?' for 0..1, '*' for 0..*, '+' for 1..*, '' for all other cases.

@param aProperty - A UML property whose multiplicity is to be
                   expressed as a ShEx cardinality string.
/]
[query public u_shexCardinality(
  aProperty : uml::Property) : String =
  if aProperty.lower = 0 and aProperty.upper = 1 then
    '?'
  else if aProperty.lower = 0 and aProperty.upper.u_isUnlimited() then
    '*'
  else if aProperty.lower = 1 and aProperty.upper.u_isUnlimited() then
    '+'
  else
    ''
  endif
  endif
  endif
/]

[**
Returns the multiplicity of the specified property as a string
in the format 'lower..upper', e.g. '0..1', '1..*'.

@param aProperty - A UML property whose multiplicity is to be
                   retrieved.
/]
[query public u_docMultiplicity(
  aProperty : uml::Property) : String =
  let upper : String =
    if aProperty.upper.u_isUnlimited() then
      '*'
    else
      aProperty.upper.toString()
    endif
  in
  aProperty.lower.toString() + '..' + upper
/]

[**
Returns true if the specified upper bound integer value is
unlimited (i.e. -1).
Note: unlimited is represented as -1, both in the UML metamodel and at
runtime (regardless of the XMI serialization which can use the asterisk)

@param upper - A UML upper bound integer value.
/]
[query public u_isUnlimited(
  upper : Integer) : Boolean =
  upper = -1
/]

[**
Checks whether an attribute's name embeds an explicit namespace
prefix, e.g. "cdif:displayLabel". This is a UML modeling workaround
for the lack of a native attribute-level namespace concept: rather
than the attribute being locally scoped to its owning class, the
embedded prefix says this is an existing external term to reuse
directly, not a new locally-scoped one.

Note: assumes a single colon. A name with more than one colon is
treated as prefix plus everything after the first colon combined,
which is not separately validated here.

@param aProperty - The attribute to check.
@return True if the attribute's name contains a colon.
/]
[query public u_hasEmbeddedNamespacePrefix(aProperty : uml::Property) : Boolean =
  aProperty.name.contains(':')
/]

[**
Returns the prefix portion of an attribute name with an embedded
namespace prefix (see u_hasEmbeddedNamespacePrefix), e.g. "cdif"
from "cdif:displayLabel". Only meaningful when
u_hasEmbeddedNamespacePrefix is true.

@param aProperty - The attribute whose embedded prefix to extract.
@return The prefix portion, i.e. everything before the first colon.
/]
[query public u_embeddedNamespacePrefix(aProperty : uml::Property) : String =
  aProperty.name.tokenize(':')->at(1)
/]

[**
Returns the local-name portion of an attribute name with an embedded
namespace prefix (see u_hasEmbeddedNamespacePrefix), e.g.
"displayLabel" from "cdif:displayLabel", escaped the same way as any
other local identifier. Only meaningful when
u_hasEmbeddedNamespacePrefix is true.

@param aProperty - The attribute whose local name to extract.
@return The escaped local-name portion, i.e. everything after the
        first colon.
/]
[query public u_embeddedLocalName(aProperty : uml::Property) : String =
  aProperty.name.tokenize(':')->at(2).u_iriEscape()
/]

[**
Resolves the namespace URI for an attribute name's embedded namespace
prefix (see u_hasEmbeddedNamespacePrefix), checking two sources in
order: first the static namespace list (see u_staticNamespaces), then
packages under Universe whose own resolved prefix matches (see
u_packagesWithRdfPrefix). Returns the sentinel NOT_SET if neither
source resolves the prefix.

Callers are responsible for warning if the result is NOT_SET, and
for warning separately if u_packagesWithRdfPrefix finds more than one
matching package, which is a conflict rather than a resolution
failure. Only meaningful when u_hasEmbeddedNamespacePrefix is true.

@param aProperty - The attribute whose embedded prefix to resolve.
@return The resolved namespace URI, or NOT_SET if unresolved.
/]
[query public u_resolvedEmbeddedNamespace(aProperty : uml::Property) : String =
  let prefix : String = aProperty.u_embeddedNamespacePrefix() in
  let staticMatch : Sequence(String) =
    aProperty.u_staticNamespaces()
      ->select(t | t.tokenize('>')->at(1) = prefix)
  in
  if staticMatch->notEmpty()
  then staticMatch->first().tokenize('>')->at(2)
  else
    let packageMatches : Sequence(uml::Package) =
      aProperty.u_model().u_packagesWithRdfPrefix(prefix)
    in
    if packageMatches->notEmpty()
    then packageMatches->first().u_packageOwnRdfNamespace()
    else 'NOT_SET'
    endif
  endif
/]

[**
Checks whether an attribute's type is polymorphic in the sense that
matters for rendering: the type is abstract, meaning any actual value
must be one of its concrete subclasses/sub-data-types rather than an
instance of the declared type itself.

@param aProperty - The attribute to check.
@return True if the attribute's type is a Classifier and is abstract.
/]
[query public u_isPolymorphicAttributeType(aProperty : uml::Property) : Boolean =
  aProperty.type.oclIsKindOf(uml::Classifier)
  and aProperty.type.oclAsType(uml::Classifier).isAbstract
/]

[**
Checks whether an attribute's type is one of the names configured
in the "uml-union-types" property (see u_unionTypeNames) -- a type
with its own dedicated string-or-object union handling in the
target formats (e.g. Identifier), configured explicitly since
nothing in the UML model structurally signals this on its own.

@param aProperty - The attribute to check.
@return True if the attribute's type name is a configured union type.
/]
[query public u_isUnionTypeAttribute(aProperty : uml::Property) : Boolean =
  aProperty.type.oclIsKindOf(uml::Classifier)
  and aProperty.u_unionTypeNames()->includes(aProperty.type.oclAsType(uml::Classifier).name)
/]
