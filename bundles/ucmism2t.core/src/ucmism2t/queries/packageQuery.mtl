[comment encoding = UTF-8 /]

[**
Module contains queries with a UML package as receiver.
/]
[module packageQuery(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::services::PropertiesService /]

[**
Returns the classes directly owned by the specified package,
sorted by name.

@param aPackage - A UML package whose directly owned classes
                  are to be retrieved.
/]
[query public u_childClasses(
  aPackage : uml::Package) : Sequence(uml::Class) =
  aPackage.ownedType->filter(uml::Class)
  ->sortedBy(c | c.name)
/]

[**
Returns the packages directly owned by the specified package,
sorted by name.

@param aPackage - A UML package whose directly owned packages
                  are to be retrieved.
/]
[query public u_childPackages(
  aPackage : uml::Package) : Sequence(uml::Package) =
  aPackage.nestedPackage
  ->sortedBy(p | p.name)
/]

[**
Returns true if the specified package is the main package or a
non-ignored child of the main package.

@param aPackage - A UML package.
/]
[query public u_isAllowedPackage(aPackage : uml::Package) : Boolean =
  let mainPkg : uml::Package = aPackage.u_model().u_mainPackage() in
  aPackage = mainPkg
  or (mainPkg.eAllContents(uml::Package)->includes(aPackage)
      and aPackage.u_isNotIgnoredPackage())
/]

[**
Returns true if the specified package is not listed in the
IGNORE_PACKAGE property (comma-separated list of package names).

@param aPackage - A UML package.
/]
[query public u_isNotIgnoredPackage(aPackage : uml::Package) : Boolean =
  'IGNORE_PACKAGE'.getPropertyValue()
    .substituteAll(' ', '')
    .tokenize(',')
    ->collect(p | aPackage.u_model().u_namedElementByName(p))
    ->excludes(aPackage)
/]

[**
Returns a sequence of data types directly contained in the
specified package.

@param aPackage - A UML package.
/]
[query public u_childrenDataTypes(
  aPackage : uml::Package) : Sequence(uml::DataType) =
  aPackage.eContents(uml::DataType)
/]

[**
Returns a sequence of enumerations directly contained in the
specified package.

@param aPackage - A UML package.
/]
[query public u_childrenEnumerations(
  aPackage : uml::Package) : Sequence(uml::Enumeration) =
  aPackage.eContents(uml::Enumeration)
/]

[**
 * Returns the supplier classes of the child dependencies owned by aPackage.
 *
 * This query is intended for package-to-class dependencies in models
 * where each relevant dependency has exactly one package client and
 * exactly one relevant supplier class.
 *
 * The query first selects those Dependency elements directly contained
 * in aPackage whose package client is aPackage itself. For each such
 * dependency, it then retrieves the first supplier that is a UML Class.
 *
 * The collected classes are converted to an OrderedSet in order to
 * remove duplicates while preserving collection ordering semantics.
 * The resulting set is then sorted alphabetically by class name.
 *
 * A null-safe name guard is used in the sort key so that unnamed
 * classes do not cause an error; they are sorted as if their name
 * were the empty string.
 *
 * Note: The use of ->first() in both the client and supplier lookup
 * is intentional and relies on the model convention that each relevant
 * dependency has exactly one package client and one supplier class.
 *
 * @param aPackage - The UML package whose child dependency supplier
 *                   classes are being collected.
 * @return An ordered set of supplier classes, sorted by name.
 */]
[query public u_childDependencySupplierClasses(
  aPackage : uml::Package) : OrderedSet(uml::Class) =
  aPackage.eContents(uml::Dependency)
    ->select(d1 | d1.client->filter(uml::Package)->first() = aPackage)
    ->collect(d2 | d2.supplier->filter(uml::Class)->first())
    ->asOrderedSet()
    ->sortedBy(c | if c.name <> null then c.name else '' endif)
/]
[**
 * Returns the supplier data types of the child dependencies owned by
 * aPackage, excluding UML PrimitiveTypes and UML Enumerations.
 *
 * This query is intended for package-to-data-type dependencies where
 * each relevant dependency has exactly one package client and one
 * relevant supplier data type.
 *
 * The query first selects those Dependency elements directly contained
 * in aPackage whose package client is aPackage itself. For each such
 * dependency, it then retrieves the first supplier that is a UML DataType
 * but not a UML PrimitiveType and not a UML Enumeration.
 *
 * The collected data types are converted to an OrderedSet in order to
 * remove duplicates while preserving collection ordering semantics.
 * The resulting set is then sorted alphabetically by data type name.
 *
 * A null-safe name guard is used in the sort key so that unnamed data
 * types do not cause an error; they are sorted as if their name were
 * the empty string.
 *
 * Note: The use of ->first() in both the client and supplier lookup
 * is intentional and relies on the model convention that each relevant
 * dependency has exactly one package client and one supplier data type.
 *
 * @param aPackage - The UML package whose child dependency supplier
 *                   data types are being collected.
 * @return An ordered set of supplier data types, sorted by name.
 */]
[query public u_childDependencySupplierDataTypes(
  aPackage : uml::Package) : OrderedSet(uml::DataType) =
  aPackage.eContents(uml::Dependency)
    ->select(d1 | d1.client->filter(uml::Package)->first() = aPackage)
    ->collect(d2 |
      d2.supplier
        ->filter(uml::DataType)
        ->reject(t | t.oclIsKindOf(uml::PrimitiveType) or t.oclIsKindOf(uml::Enumeration))
        ->first())
    ->asOrderedSet()
    ->sortedBy(d | if d.name <> null then d.name else '' endif)
/]
[**
 * Returns the supplier enumerations of the child dependencies owned by aPackage.
 *
 * This query is intended for package-to-enumeration dependencies in models
 * where each relevant dependency has exactly one package client and
 * exactly one relevant supplier enumeration.
 *
 * The query first selects those Dependency elements directly contained
 * in aPackage whose package client is aPackage itself. For each such
 * dependency, it then retrieves the first supplier that is a UML Enumeration.
 *
 * The collected enumerations are converted to an OrderedSet in order to
 * remove duplicates while preserving collection ordering semantics.
 * The resulting set is then sorted alphabetically by enumeration name.
 *
 * A null-safe name guard is used in the sort key so that unnamed
 * enumerations do not cause an error; they are sorted as if their name
 * were the empty string.
 *
 * Note: The use of ->first() in both the client and supplier lookup
 * is intentional and relies on the model convention that each relevant
 * dependency has exactly one package client and one supplier enumeration.
 *
 * @param aPackage - The UML package whose child dependency supplier
 *                   enumerations are being collected.
 * @return An ordered set of supplier enumerations, sorted by name.
 */]
[query public u_childDependencySupplierEnumerations(
  aPackage : uml::Package) : OrderedSet(uml::Enumeration) =
  aPackage.eContents(uml::Dependency)
    ->select(d1 | d1.client->filter(uml::Package)->first() = aPackage)
    ->collect(d2 | d2.supplier->filter(uml::Enumeration)->first())
    ->asOrderedSet()
    ->sortedBy(e | if e.name <> null then e.name else '' endif)
/]

[**
Returns the union of all dependency-defined subset classes across
all active Profile sub-packages in the model. A Profile sub-package
is any package directly owned by the package named 'Profiles', and
is active when the property 'profiles' is true.

For each such sub-package, the classes defined as suppliers of its
child dependency relationships (via u_childDependencySupplierClasses)
are collected and unioned into a single OrderedSet.

This query is the primary entry point for dependency-based subset
filtering in diagram and RST templates. It is used in place of the
property-file-based u_subsetAllClasses when 'profiles' is true.

The receiver is any UML element reachable from the model, used
only to navigate to the model root via u_model().

When 'profiles' is false or the model has no 'Profiles' package,
an empty OrderedSet is returned, and subset filtering will show
nothing (neither 'includeAllItems' nor 'profiles' being true
represents a configuration error per design intent).

@param anElement - Any UML NamedElement in the model; used as
                   receiver to navigate to the model root.
@return           The union of all dependency-defined subset classes
                  across all active Profile sub-packages.
/]
[query public u_profileSubsetClasses(
  anElement : uml::NamedElement) : OrderedSet(uml::Class) =
  if not 'profiles'.isPropertyTrue()
  then OrderedSet{}
  else
    let profilesPackage : uml::Package =
      anElement.u_model().eContents(uml::Package)
        ->select(p | p.name = 'Profiles')
        ->first()
    in
    if profilesPackage = null
    then OrderedSet{}
    else
      profilesPackage.eContents(uml::Package)
        ->collect(subPkg | subPkg.u_childDependencySupplierClasses())
        ->asOrderedSet()
    endif
  endif
/]

[**
Returns the union of all dependency-defined subset data types across
all active Profile sub-packages in the model. A Profile sub-package
is any package directly owned by the package named 'Profiles', and
is active when the property 'profiles' is true.

For each such sub-package, the data types defined as suppliers of
its child dependency relationships (via u_childDependencySupplierDataTypes)
are collected and unioned into a single OrderedSet. UML PrimitiveTypes
and Enumerations are excluded, consistent with the behaviour of
u_childDependencySupplierDataTypes.

This query complements u_profileSubsetClasses for templates that
display data types in subset-filtered contexts (e.g. the inheritance
tree in rst_subClasses, the data type diagram context).

When 'profiles' is false or the model has no 'Profiles' package,
an empty OrderedSet is returned.

@param anElement - Any UML NamedElement in the model; used as
                   receiver to navigate to the model root.
@return           The union of all dependency-defined subset data
                  types across all active Profile sub-packages.
/]
[query public u_profileSubsetDataTypes(
  anElement : uml::NamedElement) : OrderedSet(uml::DataType) =
  if not 'profiles'.isPropertyTrue()
  then OrderedSet{}
  else
    let profilesPackage : uml::Package =
      anElement.u_model().eContents(uml::Package)
        ->select(p | p.name = 'Profiles')
        ->first()
    in
    if profilesPackage = null
    then OrderedSet{}
    else
      profilesPackage.eContents(uml::Package)
        ->collect(subPkg | subPkg.u_childDependencySupplierDataTypes())
        ->asOrderedSet()
    endif
  endif
/]


[**
Returns the sequence of selected attribute names for the given class
within the given profile package, as defined by the @selected-attributes
annotation on the dependency relationship from the profile package to
the class.

The annotation appears in the body of an ownedComment on the dependency
element, on a line of the form:
  @selected-attributes: attr1, attr2, attr3

Multiple annotations may appear in the comment body on separate lines;
only the @selected-attributes line is processed here.

When the annotation is present, only the listed attribute names should
be included in profile-specific documentation and encodings. When the
annotation is absent (the dependency exists but has no such annotation),
an empty sequence is returned — callers must interpret an empty result
as meaning all attributes are included (no restriction).

Attribute names are literal UML property name values as they appear in
the model, including any CURIE prefix (e.g. 'schema:identifier',
'prov:wasDerivedFrom') used by convention for attributes from external
namespaces.

@param aClass          - The UML class whose selected attributes are
                         to be retrieved.
@param aProfilePackage - The profile sub-package that defines the
                         subset.
@return A Sequence of selected attribute name strings, or an empty
        Sequence if no @selected-attributes annotation is present.
/]
[query public u_selectedAttributes(
  aClass : uml::Class,
  aProfilePackage : uml::Package) : Sequence(String) =
  let dep : uml::Dependency =
    aProfilePackage.eContents(uml::Dependency)
      ->select(d |
        d.client->filter(uml::Package)->first() = aProfilePackage
        and d.supplier->includes(aClass))
      ->first()
  in
  if dep = null
  then Sequence{}
  else
    let annotatedComment : uml::Comment =
      dep.ownedComment
        ->select(c | c.body <> null
          and c.body.contains('@selected-attributes'))
        ->first()
    in
    if annotatedComment = null
    then Sequence{}
    else
      let line : String =
        annotatedComment.body
          .tokenize('\n')
          ->select(l | l.contains('@selected-attributes'))
          ->first()
      in
      if line = null or line = ''
      then Sequence{}
      else
        line.substring(line.index(':') + 1)
          .substituteAll(' ', '')
          .tokenize(',')
      endif
    endif
  endif
/]

[**
Returns true if the given attribute should be included in profile
documentation and encodings for the given class in the given profile
package.

An attribute is included when either:
  (a) no @selected-attributes annotation is defined for this class
      in this profile (u_selectedAttributes returns an empty sequence),
      meaning all attributes are implicitly included; or
  (b) a @selected-attributes annotation is present and the attribute
      name appears in the annotated list.

This query centralises the attribute-inclusion test so that the
[if] conditions in processClassDoc remain readable.

@param aProperty       - The UML property (attribute) to test.
@param aClass          - The class owning the attribute.
@param aProfilePackage - The profile sub-package context.
@return true if the attribute should be included in the profile output.
/]
[query public u_isAttributeInProfile(
  aProperty : uml::Property,
  aClass : uml::Class,
  aProfilePackage : uml::Package) : Boolean =
  let selected : Sequence(String) =
    aClass.u_selectedAttributes(aProfilePackage)
  in
  selected->isEmpty()
  or selected->includes(aProperty.name)
/]


[**
Validates the @selected-attributes annotation for the given class
in the given profile package. For each attribute name listed in the
annotation, checks whether a property with that name actually exists
on the class. If not, writes a warning to stdout via
PropertiesService.logWarning with the [PROFILE VALIDATION] prefix.

Always returns true so it can be used as a side-effecting guard in
a [let] or [if] context without affecting control flow.

Intended to be called once per class per profile package during
generation, from a dedicated validation template in packageDocFile.
This keeps the side effect in a controlled, single-call context
rather than inside a query that may be evaluated multiple times.

@param aClass          - The UML class whose selected attributes
                         are to be validated.
@param aProfilePackage - The profile sub-package whose
                         @selected-attributes annotation is checked.
@return Always true; side effect is writing warnings to stdout.
/]
[**
Returns the sequence of attribute names listed in the
@selected-attributes annotation for the given class in the given
profile package that do not match any actual ownedAttribute name
on the class.

An empty sequence means all listed names are valid.
A non-empty sequence contains the unknown names that should be
reported as warnings.

Used by validateProfilePackage to identify annotation errors
before calling logWarning for each unknown name.

@param aClass          - The UML class to validate.
@param aProfilePackage - The profile sub-package context.
@return Sequence of unknown attribute name strings.
/]
[query public u_unknownSelectedAttributes(
  aClass : uml::Class,
  aProfilePackage : uml::Package) : Sequence(String) =
  let selected : Sequence(String) =
    aClass.u_selectedAttributes(aProfilePackage)
  in
  let allNames : Sequence(String) =
    aClass.ownedAttribute.name->asSequence()
  in
  selected->select(attrName | not allNames->includes(attrName))
/]


[**
Returns all profile sub-packages (packages directly owned by the
package named 'Profiles') whose dependency-defined subset includes
the given class.

Used in the universe class documentation to generate back-references
to all profile-specific pages for the class.

@param aClass - The UML class to find profile packages for.
@return OrderedSet of profile sub-packages containing the class,
        sorted by package name.
/]
[query public u_profilePackagesForClass(
  aClass : uml::Class) : OrderedSet(uml::Package) =
  aClass.u_model().eAllContents(uml::Package)
    ->select(p | p.eContainer(uml::Package) <> null
      and p.eContainer(uml::Package).name = 'Profiles'
      and p.u_childDependencySupplierClasses()->includes(aClass))
    ->sortedBy(p | p.name)
    ->asOrderedSet()
/]
