[comment encoding = UTF-8 /]

[**
Module contains queries with a UML model as receiver.
This includes queries for retrieving model metadata
(acronym, title, version, URI, language), navigating
the model structure (main package, all classes, all
data types, all packages), and property file access.

Note: The main package is the top-level package of the
model as specified by the property MAIN_PACKAGE_NAME.
All generation targets operate on the main package
rather than the model root directly.

Note: Model metadata is resolved in order of priority:
(1) property file value, (2) ModelIdentification data
type in the model, (3) built-in fallback value.
This allows property file values to override model
metadata without modifying the model.

Related modules:
- packageQuery: queries with a UML package as receiver,
  since Model is a subtype of Package in UML
- classQuery: queries with a UML class as receiver
- dataTypeQuery: queries with a UML data type as receiver
/]
[module modelQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::configurationQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::query::oldModelQuery/]

[**
 * Returns the main package for generation, determined by the
 * 'MAIN_PACKAGE_NAME' property.
 *
 * Property matching:
 *   The property value is matched against the qualified name of
 *   each package (uml::Package.qualifiedName), which includes
 *   the full path, e.g. 'MyModel::Domain::Core'. A simple
 *   unqualified name such as 'Core' will NOT match. If the
 *   property holds a simple name, use p.name instead.
 *
 * Fallback to model:
 *   The model itself is returned as a uml::Package when:
 *   - 'MAIN_PACKAGE_NAME' is not set (empty string),
 *   - the property equals the model name, or
 *   - no package with the given qualified name is found.
 *   The second condition means that explicitly naming the model
 *   is treated the same as leaving the property unset.
 *
 * Non-determinism:
 *   If multiple packages share the same qualified name across
 *   different subtrees, ->first() returns the first match in
 *   containment order. The model is assumed to contain unique
 *   qualified names, which is the standard UML constraint.
 *
 * Type note:
 *   uml::Model is a specialisation of uml::Package, so returning
 *   aModel as uml::Package requires no cast.
 *
 * @param aModel - The UML model being generated.
/]
[query public u_mainPackage(aModel : uml::Model) : uml::Package =
  let propertyValue : String =
    'MAIN_PACKAGE_NAME'.getPropertyValue()
  in
  let matchedPackages : Sequence(uml::Package) =
    aModel.eAllContents(uml::Package)
      ->select(p | p.qualifiedName = propertyValue)
  in
  if propertyValue = ''
    or propertyValue = aModel.name
    or matchedPackages->isEmpty()
  then
    aModel
  else
    matchedPackages->first()
  endif
/]
[**
Returns an ordered set of all abstraction suplpier classes or data
types contained in the specified model, without duplicates.

@param aModel - A UML model.
/]
[query public u_allAbstractionSuppliers(
  aModel : uml::Model) : OrderedSet(uml::Classifier) =
  aModel.eAllContents(uml::Abstraction).supplier
  ->filter({uml::Class | uml::DataType})
  ->asOrderedSet()
/]

[**
Returns an ordered set of all abstraction client classes or data
types contained in the specified model, without duplicates.

@param aModel - A UML model.
/]
[query public u_allAbstractionClients(
  aModel : uml::Model) : OrderedSet(uml::Classifier) =
  aModel.eAllContents(uml::Abstraction).client
  ->filter({uml::Class | uml::DataType})
  ->asOrderedSet()
/]

[**
Returns a sequence of all classes contained in the specified
model, sorted by name.

@param aModel - A UML model.
/]
[query public u_allClasses(
  aModel : uml::Model) : Sequence(uml::Class) =
  aModel.eAllContents(uml::Class)
  ->sortedBy(c | c.name)
/]

[**
Returns a sequence of all proper data types contained in the
specified model, excluding primitive types and enumerations,
sorted by name.

@param aModel - A UML model.
/]
[query public u_allDataTypes(
  aModel : uml::Model) : Sequence(uml::DataType) =
  aModel.eAllContents(uml::DataType)
  ->reject(dt | dt.oclIsKindOf(uml::Enumeration)
             or dt.oclIsKindOf(uml::PrimitiveType))
  ->sortedBy(dt | dt.name)
/]

[**
Returns a sequence of all enumerations contained in the specified
model, sorted by name.

@param aModel - A UML model.
/]
[query public u_allEnumerations(
  aModel : uml::Model) : Sequence(uml::Enumeration) =
  aModel.eAllContents(uml::Enumeration)
  ->sortedBy(e | e.name)
/]

[**
Returns a sequence of all packages contained in the specified
model, excluding the model itself, sorted by name.

@param aModel - A UML model.
/]
[query public u_allPackages(
  aModel : uml::Model) : Sequence(uml::Package) =
  aModel.eAllContents(uml::Package)
  ->reject(p | p.oclIsKindOf(uml::Model))
  ->sortedBy(p | p.name)
/]

[**
 Returns an ordered set of package qualified name segments that
 contain at least one classifier whose simple name appears in
 u_subsetItems(). Each segment is a '::'-separated token of the
 qualifier prefix of a matching classifier's qualified name.

 @param aModel - A UML model.
/]
[query public u_subsetPackages(
  aModel : uml::Model) : OrderedSet(String) =
  let mainPkg : uml::Package = aModel.u_mainPackage() in
  mainPkg.eAllContents(uml::Classifier)
    ->collect(c | c.qualifiedName)
    ->select(s | aModel.u_subsetItems()->includes(
        s.substring(s.lastIndex('::') + 2)))
    ->collect(s | s.substring(1, s.lastIndex('::') - 1))
    ->collect(s | s.tokenize('::'))
    ->asOrderedSet()
/]

[**
Returns a sequence of packages that directly contain at least one
class, sorted by package name.

@param aModel - A UML model.
/]
[query public u_packagesWithClasses(
  aModel : uml::Model) : Sequence(uml::Package) =
  aModel.eAllContents(uml::Package)
    ->select(p | p.eContents(uml::Class)->notEmpty())
    ->sortedBy(p | p.name)
/]
