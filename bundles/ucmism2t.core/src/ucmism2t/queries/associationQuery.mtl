[comment encoding = UTF-8 /]

[**
Module contains queries with a UML association as receiver.
This includes queries for navigating association ends (owned end,
other end, source class, target class), computing short association
names, and testing whether an association belongs to a diagram
subset.

The association direction convention used throughout this module and
the diagram templates is:
  ownedEnd  = the source (subject) end, owned by the association
  otherEnd  = the target (object) end, owned by the source class

Note: Queries that find associations starting from a class
are in classQuery, since their receiver is a UML class.

Related modules:
- classQuery: queries with a UML class as receiver,
  including queries that find associations of a class
- propertyQuery: queries with a UML property as receiver,
  since association ends are properties in UML
/]
[module associationQuery(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::configurationQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::services::PropertiesService /]

[**
Dead variants kept for reference.
These were earlier exploratory implementations of u_ownedEndClass
and u_otherEndClass. The active versions are below.
/]
[comment]
[query public Xu_ownedEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.memberEnd
    ->reject(p | anAssociation.ownedEnd->includes(p))
    ->first()
    .type.oclAsType(uml::Class)
/]

[query public OKu_ownedEndClass(anAssociation : uml::Association) : uml::Class =
  anAssociation.ownedEnd->first().type.oclAsType(uml::Class)
/]

[query public Xu_otherEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.memberEnd
    ->select(p | anAssociation.ownedEnd->includes(p))
    ->first()
    .type.oclAsType(uml::Class)
/]

[query public OKu_otherEndClass(anAssociation : uml::Association) : uml::Class =
  anAssociation.ownedEnd->first().getOtherEnd().type.oclAsType(uml::Class)
/]

[query public X2u_ownedEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.ownedEnd
    ->first()
    .type.oclAsType(uml::Class)
/]

[query public X2u_otherEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.memberEnd
    ->reject(p | anAssociation.ownedEnd->includes(p))
    ->first()
    .type.oclAsType(uml::Class)
/]
[/comment]

[**
Returns the source (subject) end of a binary directed association.
A binary directed association can be understood as a triple:
  subject -- predicate (association name) --> object
The source end is the subject end — owned by the association
itself (ownedEnd) — as opposed to the target (object) end, which
is owned by the source class via ownedAttribute.
Note: Intended for use with binary directed associations only.
See: u_otherEnd(uml::Association) - Returns the target (object) end.

@param anAssociation - A UML binary directed association whose
                       source (subject) end is to be retrieved.
/]
[query public u_ownedEnd(
  anAssociation : uml::Association) : uml::Property =
  anAssociation.ownedEnd->first()
/]


[**
Returns the target (object) end of a binary directed association.
A binary directed association can be understood as a triple:
  subject -- predicate (association name) --> object
The target end is the object end — owned by the source class via
ownedAttribute (memberEnd minus ownedEnd) — as opposed to the
source (subject) end, which is owned by the association itself.
Note: Intended for use with binary directed associations only.
See: u_ownedEnd(uml::Association) - Returns the source (subject) end.

@param anAssociation - A UML binary directed association whose
                       target (object) end is to be retrieved.
/]
[query public u_otherEnd(
  anAssociation : uml::Association) : uml::Property =
  anAssociation.memberEnd
    ->reject(p | anAssociation.ownedEnd->includes(p))
    ->first()
/]


[**
Returns the source (subject) class of a binary directed association.
A binary directed association can be understood as a triple:
  subject -- predicate (association name) --> object
The source class is the subject — the class from which the
association originates. Delegates to u_ownedEnd() for end
navigation and casts its type to uml::Class.
Note: Intended for use with binary directed associations only.
See: u_otherEndClass(uml::Association) - Returns the target (object) class.

@param anAssociation - A UML binary directed association whose
                       source (subject) class is to be retrieved.
/]
[query public u_ownedEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.u_ownedEnd().type.oclAsType(uml::Class)
/]


[**
Returns the target (object) class of a binary directed association.
A binary directed association can be understood as a triple:
  subject -- predicate (association name) --> object
The target class is the object — the class to which the association
points. Delegates to u_otherEnd() for end navigation and casts
its type to uml::Class.
Note: Intended for use with binary directed associations only.
See: u_ownedEndClass(uml::Association) - Returns the source (subject) class.

@param anAssociation - A UML binary directed association whose
                       target (object) class is to be retrieved.
/]
[query public u_otherEndClass(
  anAssociation : uml::Association) : uml::Class =
  anAssociation.u_otherEnd().type.oclAsType(uml::Class)
/]

[**
Returns true if the given association should be shown in a context
diagram for the given class, according to the current subset
configuration.

An association is included when either of the following holds:
  (a) the property 'includeAllItems' is true, meaning no subset
      filtering is active;
  (b) the property 'profiles' is true, and both the source and
      target class of the association are members of the
      dependency-defined profile subset (checked by object
      identity via u_profileSubsetClasses).

When 'profiles' is true, the subset is determined by the union
of all dependency-defined supplier classes across all Profile
sub-packages (packages directly owned by the 'Profiles' package),
as returned by u_profileSubsetClasses. This replaces the earlier
property-file-based u_subsetAllClasses mechanism; the two
mechanisms are mutually exclusive.

The check tests both ends regardless of direction: the focal class
aClass is always assumed to be in the subset (it is the subject of
the diagram), so the condition tests whether the *other* end class
is also in the subset.

Note: Both u_ownedEndClass() and u_otherEndClass() assume both
association ends are typed by uml::Class. Associations targeting
DataTypes are excluded upstream by u_associations().

This query centralises the subset-filter condition used in:
  - pu_classDiagram (focal class associations)
  - pu_superClass (inherited superclass associations)

@param anAssociation - A UML binary directed association to test.
@param aClass        - The focal class for which the diagram is
                       being generated; assumed to be in the subset.
/]
[query public u_isAssociationInSubset(
  anAssociation : uml::Association,
  aClass : uml::Class) : Boolean =
  'includeAllItems'.isPropertyTrue()
  or (
    'profiles'.isPropertyTrue()
    and aClass.u_profileSubsetClasses()
          ->includes(anAssociation.u_ownedEndClass())
    and aClass.u_profileSubsetClasses()
          ->includes(anAssociation.u_otherEndClass())
  )
/]

[**
Dead variant of u_shortAssociationName kept for reference.
The active version is below.
/]
[comment]
[query public OKu_shortAssociationName(
  anAssociation : uml::Association) : String =
  if anAssociation.name.contains('_') then
    let nameAfterFirst : String =
      anAssociation.name.substring(anAssociation.name.index('_') + 1)
    in
    nameAfterFirst.substring(1, nameAfterFirst.index('_') - 1)
  else
    anAssociation.name
  endif
/]
[/comment]

[**
Returns the predicate (middle segment) of the association name,
which follows the subject-predicate-object naming convention:
  <subject>_<predicate>_<object>
Returns a warning string if the name does not conform:
- 'WARNING: no association name!' if the name is empty.
- the full name if no underscore is present, as the model
  may use simple association names without the convention.
- 'WARNING: association name has only one underscore!' if only
  one underscore is present, making the predicate ambiguous.

@param anAssociation - A binary directed UML association whose
                       name follows the subject_predicate_object
                       convention, or a simple name.
/]
[query public u_shortAssociationName(
  anAssociation : uml::Association) : String =
  let n : String = anAssociation.name in
  if n = ''
  then 'WARNING: no association name!'
  else
    if n.contains('_')
    then
      let nameAfterFirst : String =
        n.substring(n.index('_') + 1)
      in
      if nameAfterFirst.contains('_')
      then nameAfterFirst.substring(1, nameAfterFirst.index('_') - 1)
      else 'WARNING: association name has only one underscore!' + n
      endif
    else n
    endif
  endif
/]
