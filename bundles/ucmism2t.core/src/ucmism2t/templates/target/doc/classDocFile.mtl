[**
 * The documentation of the module aClassFile.
 */]
[module classDocFile(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::classifierQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::configurationQuery/]
[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::propertyQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::doc::associationDoc/]
[import ucmism2t::templates::target::doc::puDiagram/]
[import ucmism2t::templates::target::doc::puUtilityDoc/]
[import ucmism2t::templates::target::doc::rstUtilityDoc/]
[import ucmism2t::templates::target::jsonld::commonJsonld/]
[import ucmism2t::templates::target::jsonld::classJsonld/]
[import ucmism2t::templates::target::jsonschema::classJsch/]
[import ucmism2t::templates::target::onto::classOnto/]
[import ucmism2t::templates::target::shacl::classShacl/]
[import ucmism2t::templates::target::shex::classShex/]
[import ucmism2t::templates::target::xsd::classXsd/]

[comment][import ucmism2t::templates::target::doc::attributeDoc /][/comment]
[**
Processes a class and writes all output files for it.

When aProfilePackage is null (universe context):
  - Uses u_filePath for file paths
  - Emits the canonical RST anchor .. _<qualifiedName>:
  - No attribute filtering (all attributes included)
  - Association table shows all associations
  - Diagram uses pu_classDiagram(null)

When aProfilePackage is not null (profile context):
  - Uses u_profileFilePath for file paths
  - Emits the profile-specific anchor
      .. _<profileName>-<qualifiedName>:
  - Adds a "See also" reference to the universe file
  - Attributes filtered by u_isAttributeInProfile
  - Superclasses in attribute/association tables filtered
    to those in the profile subset
  - Association table shows only associations where both
    ends are in the profile subset
  - Diagram uses pu_classDiagram(aProfilePackage)

@param aClass          - The UML class to process.
@param folderType      - 'universe' to emit the canonical anchor,
                         any other value to suppress it.
@param aProfilePackage - The profile sub-package context, or null
                         for universe generation.
/]
[template public processClassDoc(aClass : uml::Class, folderType : String, aProfilePackage : uml::Package)]
  [comment] subset condition [/comment]
  [if ('includeAllItems'.isPropertyTrue() or (aProfilePackage <> null and aProfilePackage.u_childDependencySupplierClasses()->includes(aClass)) or (aProfilePackage = null and aClass.u_subsetAllClasses()->includes(aClass.name)))]
    [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.rst'), overwrite, 'UTF-8')]
      [aClass.rst_generationMessageDoc()/]
      [if (folderType = 'universe' and aProfilePackage = null)]
        .. _[aClass.qualifiedName/]:
      [elseif (aProfilePackage <> null)]
        .. _[aProfilePackage.name/]-[aClass.qualifiedName/]:
      [/if]
      
      [aClass.rst_className().rst_header('*')/]
      
      .. index:: [aClass.name/]
      
      [if (aClass.u_isChildOfMainPackage())]
        Fully qualified [aClass.eClass().name.toLower()/] name of the UML model [aClass.u_model().u_modelAcronym()/] [aClass.u_model().u_modelMajorVersion()/].[aClass.u_model().u_modelMinorVersion()/]: **[aClass.qualifiedName/]**
      [else]
        Fully qualified [aClass.eClass().name.toLower()/] name: **[aClass.qualifiedName/]**
      [/if]
      [if (aClass.isAbstract)]   | Class is abstract.[/if]
      [if (aProfilePackage <> null)]
      
        Profile: **[aProfilePackage.name/]** | See also: :ref:`[aClass.qualifiedName/]` (full universe documentation)
      [/if]
      
      [aClass.u_commentBody().replaceAll('(=\\s)', '$1\r').rst_addClassReferencesToDocumentation(aClass, aClass.u_model().u_allClasses())/]
      [if (aProfilePackage = null)]
      [let profilePackages : OrderedSet(uml::Package) = aClass.u_profilePackagesForClass()]
        [if (profilePackages->notEmpty())]
      
          Used in profiles
          ================
      
      [for (profilePkg : uml::Package | profilePackages)]
        * :ref:`[profilePkg.name/]-[aClass.qualifiedName/]` ([profilePkg.name/])
      [/for]
        [/if]
      [/let]
      [/if]
      
      [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.pu'), overwrite, 'UTF-8')]
        [aClass.pu_classDiagram(aProfilePackage)/]
      [/file]
      Diagram
      =======
      
      .. dropdown:: Diagram
         :class-container: diagram-dropdown
         :open:
      
         .. On the basis of the pu file, a svg file is generated which is used by an html object tag.
         .. The combination of the object tag with panzoom is not successful.
         .. Either the pan/zoom is possible and the svg links are not active or
         ..   the links are active but not pan/zoom.
         ..   See also FAQ no 2: https://github.com/timmywil/panzoom/blob/main/README.md#faq   
         .. .. uml:: [aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/].pu
      
         .. raw:: html
      
            [aClass.diagramModalPreCode()/]
      
         .. uml:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].pu
      
      
         .. raw:: html
      
            [aClass.diagramModalPostCode()/]
      
      [if (aClass.u_allSuperClasses()->notEmpty() or aClass.u_subClassesOrSubDataTypes()->notEmpty())]
        [aClass.rst_classOrDataTypeInheritance()/]
      [/if]
      
      [let visibleAttrs : OrderedSet(uml::Property) =
        aClass.u_attributes()
          ->select(p | aProfilePackage = null or p.u_isAttributeInProfile(aClass, aProfilePackage) )]
      [let visibleInheritedAttrs : Sequence(uml::Property) = aClass.u_allSuperClasses()->asSequence()->select(sc | aProfilePackage = null or aProfilePackage.u_childDependencySupplierClasses()->includes(sc.oclAsType(uml::Class)))->collect(sc | sc.oclAsType(uml::Class).u_attributes()->select(p | aProfilePackage = null or p.u_isAttributeInProfile(aClass, aProfilePackage)))->asSequence()]
      [if (visibleAttrs->notEmpty() or visibleInheritedAttrs->notEmpty())]
        Attributes
        ==========
        
        .. dropdown:: Attributes
           :class-container: attributes-dropdown
            
           ..
            for Bootstrap, see: https://getbootstrap.com/docs/5.3/content/tables/#responsive-tables
              div wrapper    .. container:: table-responsive
              table classes  :class: table table-striped
            for DataTables
              main-table class for own CSS
                      :class: main-table
              identifier    :name: attributes-responsive (#attributes-responsive table.main-table) 
        
           .. container::
              :name: attributes-responsive
        
              .. list-table:: Attributes
                 :widths: 10 10 60 10 10 10
                 :header-rows: 1
                 :class: table table-striped table-hover main-table
        
                 * - Name
                   - Inherited from
                   - Description
                   - Data Type
                   - Multiplicity
                   - Default value
                 [for (p1 : uml::Property | aClass.u_attributes()->select(p | aProfilePackage = null or p.u_isAttributeInProfile(aClass, aProfilePackage)))]
                   [p1.rst_processAttributeInTable(aClass)/][/for]
                 [for (c2 : uml::Classifier | aClass.u_allSuperClasses()->select(sc | aProfilePackage = null or aProfilePackage.u_childDependencySupplierClasses()->includes(sc.oclAsType(uml::Class))))]
                   [for (p2 : uml::Property | c2.u_attributes()->select(p | aProfilePackage = null or p.u_isAttributeInProfile(aClass, aProfilePackage)))]
                     [p2.rst_processAttributeInTable(aClass)/][/for][/for]
      [/if]
      [/let]
      [/let]

      [if (aClass.u_allSuperClasses()->union(OrderedSet{aClass})->collect(c | c.u_associations())->size() > 0)]
        Associations
        ============
        
        .. dropdown:: Associations
           :class-container: associations-dropdown
            
           .. container::
              :name: associations-responsive
        
              .. list-table:: Associations
                 :widths: 5 10 30 5 10 10 5 5 15
                 :header-rows: 1
                 :class: table table-striped table-hover main-table
               
                 * - Direction
                   - Association
                   - Description
                   - Multiplicity of [aClass.name/]
                   - Package of Other Class
                   - Other Class
                   - Multiplicity of other class
                   - Aggregation Kind
                   - Inherited from
        [for (c2 : uml::Class | aClass.u_allSuperClasses()->select(sc | aProfilePackage = null or aProfilePackage.u_childDependencySupplierClasses()->includes(sc))->union(OrderedSet{aClass}))]
          [for (anAssociation : uml::Association | c2.u_associations()
              ->select(a | a.ownedEnd->notEmpty()
                and (aProfilePackage = null
                  or (aProfilePackage.u_childDependencySupplierClasses()->includes(a.u_ownedEndClass())
                      and aProfilePackage.u_childDependencySupplierClasses()->includes(a.u_otherEndClass())))))]
            [let source : uml::Property = anAssociation.ownedEnd->first()]
              [let target : uml::Property = anAssociation.ownedEnd->first().getOtherEnd()]
                [if (c2 <> target.type.oclAsType(uml::Class))]
                           * - from
                [else]
                           * - to
                [/if]
                           - [anAssociation.name.replaceAll('_', ' ')/]
                           - 
                            [anAssociation.u_commentBody().replaceAll('=', '')/]
                [if (c2 <> target.type.oclAsType(uml::Class))]
                             - [source.u_docMultiplicity()/]
                             - [if (aClass.package <> target.type.package)]:ref:`[target.type.package.qualifiedName/]`[else]\- *own package* \-[/if]
                             - [if (aProfilePackage <> null)]:ref:`[aProfilePackage.name/]-[target.type.qualifiedName/]`[else]:ref:`[target.type.qualifiedName/]`[/if]
                             - [target.u_docMultiplicity()/]
                             - [target.aggregation.toString()/]
                [else]
                             - [target.u_docMultiplicity()/]
                             - [if (aClass.package <> source.type.package)]:ref:`[source.type.package.qualifiedName/]`[else]\- *own package* \-[/if]
                             - [if (aProfilePackage <> null)]:ref:`[aProfilePackage.name/]-[source.type.qualifiedName/]`[else]:ref:`[source.type.qualifiedName/]`[/if]
                             - [source.u_docMultiplicity()/]
                             - [source.aggregation.toString()/]
                [/if]
                           - [if (c2 = aClass)]*own class*[else][c2.rst_simpleQualifiedClassNameReference()/][/if]
              [/let]
            [/let]
          [/for]
        [/for]
      [/if]
      
      [if (aClass.u_isChildOfMainPackage())]
        Encodings
        =========
        
        .. dropdown:: Syntax representations / encodings
           :class-container: encodings-dropdown
            
           All syntax representations except the Canonical XMI are provided as reference points
           for specific implementations, or for use as defaults if sufficient in the form presented.
            
           .. tab-set::
            
              .. tab-item:: Canonical XMI
                 :class-content: encoding
            
                 .. The path of the encoding URIs is adjusted by the Javascript function changeUrl in custom.js.
        
                 Fragment for the class **[aClass.name/]** (`entire model as XMI </encoding/xmi/['MODEL_FILE_NAME'.getPropertyValue().replace('_eclipse', '')/]>`_)
            
                 .. literalinclude:: [aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/].xmi
                    :lines: 2-
                    :language: xml
                    :linenos:
                    :emphasize-lines: 4
        
        [if ('xsd'.isPropertyTrue())]
                .. tab-item:: XML Schema
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('_xsd.txt'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classXsd()/][else][aClass.classProfileXsd(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]entire XML Schema </encoding/xml-schema/[aClass.u_universePathSegment()/][aClass.u_model().u_modelAcronym().toLower()/].xsd>[else]profile XML Schema </encoding/xml-schema/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].xsd>[/if]`_)
              
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if]_xsd.txt 
                      :language: xml
                      :linenos:
                      :emphasize-lines: 1
                      :dedent: 0
        [/if]
        
        [if ('jsonschema'.isPropertyTrue())]
                .. tab-item:: JSON Schema
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.schema.json'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classJsch()/][else][aClass.classProfileJsch(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]entire JSON Schema </encoding/json-schema/[aClass.u_universePathSegment()/][aClass.u_model().u_modelAcronym().toLower()/].schema.json>[else]profile JSON Schema </encoding/json-schema/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].schema.json>[/if]`_)
          
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].schema.json 
                      :language: json
                      :linenos:
                      :emphasize-lines: 1
        [/if]
        
        [if ('onto'.isPropertyTrue())]
                .. tab-item:: Ontology (Turtle)
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.onto.ttl'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classOnto()/][else][aClass.classProfileOnto(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]main ontology </encoding/ontology/[aClass.u_model().u_modelAcronym()/].onto.ttl>[else]profile ontology </encoding/ontology/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].onto.ttl>[/if]`_)
              
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].onto.ttl 
                      :language: turtle
                      :linenos:
                      :emphasize-lines: 3
        [/if]
        
        [if ('jsonld'.isPropertyTrue())]
                .. tab-item:: JSON-LD
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.jsonld'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classJsonldModular()/][else][aClass.classJsonldModularProfile(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]entire JSON-LD </encoding/json-ld/[aClass.u_universePathSegment()/][aClass.u_model().u_modelAcronym().toLower()/].jsonld>[else]profile JSON-LD </encoding/json-ld/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].jsonld>[/if]`_)
              
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].jsonld 
                      :language: JSON-LD
                      :linenos:
                      :emphasize-lines: 2
        [/if]
        
        [if ('shacl'.isPropertyTrue())]
                .. tab-item:: SHACL
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.shacl.ttl'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classShacl()/][else][aClass.classProfileShacl(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]entire SHACL - Shapes Constraint Language </encoding/shacl/[aClass.u_universePathSegment()/][aClass.u_model().u_modelAcronym().toLower()/].shacl.ttl>[else]profile SHACL - Shapes Constraint Language </encoding/shacl/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].shacl.ttl>[/if]`_)
          
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].shacl.ttl 
                      :language: turtle
                      :linenos:
                      :emphasize-lines: 4
        [/if]
        
        [if ('shex'.isPropertyTrue())]
                .. tab-item:: ShEx
                   :class-content: encoding
          [file ((if aProfilePackage = null then aClass.u_filePath('doc') else aClass.u_profileFilePath('doc', aProfilePackage) endif).concat('.shexc'), overwrite, 'UTF-8')]
            [if (aProfilePackage = null)][aClass.classShex()/][else][aClass.classProfileShex(aProfilePackage)/][/if]
          [/file]
          
                   Fragment for the class **[aClass.name/]** (`[if (aProfilePackage = null)]entire ShEx - Shape Expressions </encoding/shex/[aClass.u_universePathSegment()/][aClass.u_model().u_modelAcronym().toLower()/].shexc>[else]profile ShEx - Shape Expressions </encoding/shex/['profiles_package'.getRequiredPropertyValue()/]/[aProfilePackage.name/]/[aProfilePackage.name/].shexc>[/if]`_)
          
                   .. literalinclude:: [if (aProfilePackage = null)][aClass.qualifiedName.replace(aClass.u_model().name, '').replaceAll('::', '/')/][else][aClass.name/][/if].shexc 
                      :language: shexc
                      :linenos:
                      :emphasize-lines: 3
        [/if]
      [/if]
    [/file]
  [/if][comment] subset condition [/comment]
[/template]

[template public subClasses(aClass : uml::Class, indent : String)]
  [for (c : uml::Class | aClass.u_subClasses())]
    [if (c.isAbstract)].. cssclass:: abstract[else].. cssclass:: regular[/if]
    
       | [indent/]ᐊ── [c.rst_simpleQualifiedClassNameReference()/]
    
    [if (c.u_subClasses()->notEmpty())][c.subClasses(indent.concat('|_| '))/][/if]
  [/for]
[/template]
