    .. _allEnumerationsList:
    
    ['All Enumerations'.rst_header('=')/]
    
    [if (aModel.u_allEnumerations()->size()>0)]
      .. container:: table-responsive
      
         .. list-table::
            :header-rows: 1
            :class: table table-striped table-hover main-table
            :name: datatable-enumerations-list
      
            * - Name
              - Package Name
              - Uses in Classes
              - Uses in Datatypes
      [for (anEnumeration : uml::Enumeration | aModel.u_allEnumerations())]
              * - [anEnumeration.rst_classifierNameReference()/]
                - :ref:`[anEnumeration.package.qualifiedName/]`
                - [anEnumeration.u_dataTypeUseProperties()->select(temp3 | temp3.owner.oclIsTypeOf(uml::Class))->size()/]
                - [anEnumeration.u_dataTypeUseProperties()->select(temp4 | temp4.owner.oclIsKindOf(uml::DataType))->size()/]
      [/for]
    [/if]
  [/file]
[/template]

