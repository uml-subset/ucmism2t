[**
 * The documentation of the template allClassesList.
 * @param aClass
*/]
[template public allClassesList(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/AllClassesList.rst'), overwrite, 'UTF-8')]
    [aModel.rst_generationMessageDoc()/]
    
    .. _allClassesList:
    
    ['All Classes'.rst_header('=')/]
    
    .. container:: table-responsive
    
       .. list-table::
          :header-rows: 1
          :class: table table-striped table-hover main-table
          :name: datatable-classes-list
    
          * - Class
            - Package
            - Super Classes
            - Is Abstract
            - Has Subclasses
            - Direct Subclasses
            - All Subclasses
            - Own Associations
            - Inherited Associations
            - Own Attributes
            - Inherited Attributes
    [for (aClass : uml::Class | aModel.u_allClasses())]
            * - [aClass.rst_classNameReference()/]
              - :ref:`[aClass.package.qualifiedName/]`
              - [aClass.u_allSuperClasses()->size()/]
              - [if (aClass.isAbstract)]yes[else]no[/if]
              - [if (aClass.u_subClasses()->notEmpty())]yes[else]no[/if]
              - [aClass.u_subClasses()->size()/]
              - [aClass.u_allSubClasses()->size()/] 
              - [aClass.u_associations()->size()/]
              - [aClass.u_inheritedAssociations()->size()/]
              - [aClass.u_attributes()->size()/]
              - [aClass.u_inheritedClassAttributes()->size()/]
    [/for]
  [/file]
[/template]

[template public allDataTypesList(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/AllDataTypesList.rst'), overwrite, 'UTF-8')]
    [aModel.rst_generationMessageDoc()/]
    
    .. _allDataTypesList:
    
    ['All Structured Data Types'.rst_header('=')/]
    
    .. container:: table-responsive
    
       .. list-table::
          :header-rows: 1
          :class: table table-striped table-hover main-table
          :name: datatable-datatypes-list
    
          * - Name
            - Package Name
            - Type
            - All Super-Datatypes
            - Is Abstract
            - All Sub-Datatypes
            - Uses in Classes
            - Uses in Datatypes
            - Own Attributes
            - Inherited Attributes
    [for (aDataType : uml::DataType | aModel.u_allDataTypes()->select(d2 | not d2.name.endsWith('PackageInformation')))]
            * - [aDataType.rst_classifierNameReference()/]
              - :ref:`[aDataType.package.qualifiedName/]`
              - [aDataType.eClass().name/]
              - [aDataType.u_allSuperDataTypes()->size()/]
              - [if (aDataType.isAbstract)]yes[else]no[/if]
              - [aDataType.u_allSubDataTypes()->size()/] 
              - [aDataType.u_dataTypeUseProperties()->select(temp1 | temp1.owner.oclIsTypeOf(uml::Class))->size()/]
              - [aDataType.u_dataTypeUseProperties()->select(temp2 | temp2.owner.oclIsKindOf(uml::DataType))->size()/]
              - [aDataType.u_attributes()->size()/]
              - [aDataType.u_inheritedDataTypeAttributes()->size()/]
    [/for]
  [/file]
[/template]

[template public allEnumerationsList(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/AllEnumerationsList.rst'), overwrite, 'UTF-8')]
