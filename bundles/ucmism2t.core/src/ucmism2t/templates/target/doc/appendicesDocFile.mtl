[**
 * The documentation of the template allClassesList.
 * @param aClass
*/]
[template public classesByProfiles(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/ClassesByProfilesTable.rst'), overwrite, 'UTF-8')]
    [aModel.rst_generationMessageDoc()/]
    
    .. classesByProfilesTable:
    
    ['Classes by Profiles Table'.rst_header('=')/]

    [let up : uml::Package = aModel.u_profilesPackage()]
    [let profilePackages : Sequence(uml::Package) =
      Sequence{up}->select(p1 | p1 <> null)
        ->collect(p1 | p1.eContents(uml::Package))
        ->select(p2 | p2 <> null)
        ->asSequence()->sortedBy(p2 | p2.name)]
      
      .. container:: table-responsive
      
         .. list-table::
            :header-rows: 1
            :class: table table-striped table-hover main-table
            :name: datatable-classes-by-profiles
      
            * - Package
              - Class
              [for (aPackage : uml::Package | profilePackages)]
                - [aPackage.name/]
              [/for]
      [let uni : uml::Package = aModel.u_universePackage()]
      [for (aClass : uml::Class |
        Sequence{uni}->select(p3 | p3 <> null)
          ->collect(p3 | p3.eAllContents(uml::Class))
          ->select(c0 | c0 <> null)
          ->asSequence()->sortedBy(c2 | c2.name)->sortedBy(c1 | c1.package.name))]
              * - [aClass.package.name/]
                - [aClass.name/]
                [for (aPackage : uml::Package | profilePackages)]
                  - [if (aClass.u_isInProfile(aPackage))]✔[/if]
                [/for]
      [/for]
      [/let]
    [/let]
    [/let]
  [/file]
[/template]
