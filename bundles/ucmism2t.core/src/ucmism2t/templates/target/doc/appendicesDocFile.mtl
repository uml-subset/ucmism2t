[template public allPackagesList(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/AllPackagesList.rst'), overwrite, 'UTF-8')]
    [aModel.rst_generationMessageDoc()/]
    
    .. _allPackagesList:
    
    ['All Packages'.rst_header('=')/]
    
    .. container:: table-responsive
    
       .. list-table::
          :header-rows: 1
          :class: table table-striped table-hover main-table
          :name: datatable-packages-list
    
          * - Package
            - Parent Package
            - N of Classes
            - N of Data Types
            - N of Enumerations
    [for (aPackage : uml::Package | aModel.u_allPackages())]
            * - :ref:`[aPackage.qualifiedName/]`
              - :ref:`[aPackage.nestingPackage.getQualifiedName().replace(aModel.name.concat('::'), '')/]<[aPackage.nestingPackage.qualifiedName/]>`
              - [aPackage.eAllContents(uml::Class)->size()/]
              - [aPackage.eAllContents(uml::DataType)->select(temp5 | not temp5.oclIsKindOf(uml::Enumeration))->size()/]
              - [aPackage.eAllContents(uml::Enumeration)->size()/]
    [/for]
  [/file]
[/template]

[comment rom for_CDI_v1.0/]
[template public allAssociationsList(aModel : uml::Model)]
  [file (aModel.u_filePath('doc').concat('/Appendices/ModelItemLists/AllAssociationsList.rst'), overwrite, 'UTF-8')]
    [aModel.rst_generationMessageDoc()/]
    
    .. _allAssociationsList:
    
    ['All Associations'.rst_header('=')/]
    
    .. container:: table-responsive
    
       .. list-table::
          :header-rows: 1
          :class: table table-striped table-hover main-table
          :name: datatable-associations-list
    
          * - Coupling (package)
            - Package 1
            - Class 1
            - Navigable 1
            - Aggregation Kind 1
            - Multiplicity 1
            - Association Name
            - Multiplicity 2
            - Aggregation Kind 2
            - Navigable 2
            - Class 2
            - Package 2
    [for (anAssociation : uml::Association | aModel.eAllContents(uml::Association)
      ->select(a | a.ownedEnd->notEmpty()))]
            * - [if (anAssociation.ownedEnd->first().getOtherEnd().type.package.name = anAssociation.ownedEnd->first().type.package.name)]no[else]yes[/if]
              - :ref:`[anAssociation.ownedEnd->first().type.package.qualifiedName/]`
              - :ref:`[anAssociation.ownedEnd->first().type.qualifiedName/]`
              - [if (anAssociation.ownedEnd->first().isNavigable())]yes[/if]
              - [anAssociation.ownedEnd->first().aggregation/]
              - [anAssociation.ownedEnd->first().u_docMultiplicity()/]
              - [if (anAssociation.u_commentBody().size() > 0)]:abbr:`[anAssociation.u_shortAssociationName()/]([anAssociation.u_commentBody()/])`[else][anAssociation.u_shortAssociationName()/][/if]
[comment]               - [if (anAssociation.ownedComment->asSequence()->collect(temp7 | temp7.body)->toString().trim().size() > 0)]:abbr:`[anAssociation.u_shortAssociationName()/]([anAssociation.ownedComment->asSequence()->collect(temp6 | temp6.body)->toString().trim()/])`[else][anAssociation.u_shortAssociationName()/][/if][/comment]
              - [anAssociation.ownedEnd->first().getOtherEnd().u_docMultiplicity()/]
              - [anAssociation.ownedEnd->first().getOtherEnd().aggregation/]
              - [if (anAssociation.ownedEnd->first().getOtherEnd().isNavigable())]yes[/if]
              - :ref:`[anAssociation.ownedEnd->first().getOtherEnd().type.qualifiedName/]`
              - [anAssociation.ownedEnd->first().getOtherEnd().type.package.name/]
    [/for]
  [/file]
[/template]

