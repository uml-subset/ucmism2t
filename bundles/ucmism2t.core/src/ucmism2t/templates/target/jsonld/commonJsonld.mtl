[module commonJsonld(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::classifierQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[**
*/]
[template public generationMessageJsonld(anOclAny : ecore::EObject) post(self.trim())]
  This code was generated by the Eclipse Acceleo project UCMIS M2T.[/template]

[**
 * Generates context entries for the attributes of the classifier (class or dataType)
*/]
[template public genAttributes(aClassifier : uml::Classifier, modular : Boolean)]
  [for (anAttribute : uml::Property | aClassifier.u_attributes())]
    "[anAttribute.name/]": {
      "@id": "[anAttribute.iri()/]",
    [if (anAttribute.type.oclIsTypeOf(uml::Enumeration))]
        "@type": "@vocab",
        "@context": {
        [for (aLiteral : uml::EnumerationLiteral | anAttribute.type.oclAsType(uml::Enumeration).ownedLiteral) separator(',\n  ')]
            "[aLiteral.name/]": "[aLiteral.iri()/]"[/for]
        }
    [elseif (anAttribute.type.isComplex())]
        "@type": "@id"[if (modular)],[/if]
      [if (modular)]
          "@context": "[anAttribute.type.name/].jsonld"
      [/if]
    [else]
        "@type": "[anAttribute.type.iri()/]"
    [/if]
    },
  [/for]
[/template]