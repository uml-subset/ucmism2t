[template public generationMessageJsonld(anOclAny : ecore::EObject) post(self.trim())]
  This code was generated by the Eclipse Acceleo project UCMIS M2T.[/template]

[**
 * Generates context entries for the attributes of the classifier (class or dataType)
*/]
[template public genAttributes(aClassifier : uml::Classifier, modular : Boolean)]
  [for (anAttribute : uml::Property | aClassifier.u_attributes())]
  [if (anAttribute.u_isUnionTypeAttribute())]
    "[anAttribute.name/]": "[anAttribute.iri()/]",
  [else]
    "[anAttribute.name/]": {
      "@id": "[anAttribute.iri()/]",
    [if (anAttribute.type.oclIsTypeOf(uml::Enumeration))]
        "@type": "@vocab",
        "@context": {
        [for (aLiteral : uml::EnumerationLiteral | anAttribute.type.oclAsType(uml::Enumeration).ownedLiteral) separator(',\n  ')]
            "[aLiteral.name/]": "[aLiteral.iri()/]"[/for]
        }
    [elseif (anAttribute.u_isLangStringMapped())]
        "@container": "@language"
    [elseif (anAttribute.type.isComplex())]
        "@type": "@id"[if (modular)],[/if]
      [if (modular)]
          "@context": "[anAttribute.type.name/].jsonld"
      [/if]
    [else]
        "@type": "[anAttribute.type.iri()/]"
    [/if]
    },
  [/if]
  [/for]
[/template]

[**
Generates context entries for the attributes of a classifier in
profile context. Only attributes passing u_isAttributeInProfile
for the given class and profile package are included.

@param aClassifier     - The classifier whose attributes are rendered.
@param modular         - True for modular (standalone) context output.
@param aClass          - The class used for attribute profile filtering.
@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public genAttributesProfile(
  aClassifier : uml::Classifier,
  modular : Boolean,
  aClass : uml::Class,
  aProfilePackage : uml::Package)]
  [for (anAttribute : uml::Property | aClassifier.u_attributes()
      ->select(a | a.u_isAttributeInProfile(aClass, aProfilePackage)))]
  [if (anAttribute.u_isUnionTypeAttribute())]
    "[anAttribute.name/]": "[anAttribute.iri()/]",
  [else]
    "[anAttribute.name/]": {
      "@id": "[anAttribute.iri()/]",
    [if (anAttribute.type.oclIsTypeOf(uml::Enumeration))]
        "@type": "@vocab",
        "@context": {
        [for (aLiteral : uml::EnumerationLiteral | anAttribute.type.oclAsType(uml::Enumeration).ownedLiteral) separator(',\n  ')]
            "[aLiteral.name/]": "[aLiteral.iri()/]"[/for]
        }
    [elseif (anAttribute.u_isLangStringMapped())]
        "@container": "@language"
    [elseif (anAttribute.type.isComplex())]
        "@type": "@id"[if (modular)],[/if]
      [if (modular)]
          "@context": "[anAttribute.type.name/].jsonld"
      [/if]
    [else]
        "@type": "[anAttribute.type.iri()/]"
    [/if]
    },
  [/if]
  [/for]
[/template]
