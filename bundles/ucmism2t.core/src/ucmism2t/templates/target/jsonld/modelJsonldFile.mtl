[comment encoding = UTF-8 /]
[**

/]
[module modelJsonldFile(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::jsonld::classJsonld/]
[import ucmism2t::templates::target::jsonld::commonJsonld/]
[import ucmism2t::templates::target::jsonld::dataTypeJsonld/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[**
 * This generator creates a root context which depends on one additional context for each class and datatype
 * As this creates a lot of contexts, this does not scale very well when the contexts are loaded from the Web.
 * An external script can be used to *inline* most of the class- and datatype-contexts in the root context,
 * (this proved much more flexible than trying to generate the inline context directly).

For the same reason noted above, this also generates one file for
the entire universe, deliberately not split per sub-package. A
sub-package boundary (e.g. Schema, SKOS, DCAT) rarely matches what a
real consumer wants: each is just the CDIF-relevant subset of an
external vocabulary, and cross-sub-package references are the norm
in this model, not the exception, so splitting would turn most
references into cross-file ones -- reintroducing the same scaling
problem the per-type contexts above already ran into, at a coarser
grain.

Applications should use the profile-scoped files instead, which
already provide the combined, consumption-ready view a real
integration needs. This whole-universe file exists primarily as a
completeness/reference artifact, not as something on any
application's critical path, so its size is a lesser concern than
it would be for the profile files.
*/]
[template public generateJsonld(aModel : uml::Model)]
  [file (aModel.u_modelShortName() + '/encoding/json-ld/' + aModel.u_universePathSegment() + aModel.u_modelAcronym().toLower() + '.jsonld', overwrite, 'UTF-8')]
    [let classes : Sequence(uml::Class) =
            aModel.eAllContents(uml::Class)
            ->select(aClass | aClass.u_isInAllowedPackage()),
         datatypes : Sequence(uml::DataType) =
            aModel.eAllContents(uml::DataType)
            ->select(d | d.isComplex() and d.u_isInAllowedPackage() and d.isNotInMappedItems() and d.name <> 'PackageInformation')
      ]
      {
        "@context": {
          [if (aModel.u_modelRdfPrefix() <> 'NOT_SET' and aModel.u_modelRdfNamespace() <> 'NOT_SET')]"[aModel.u_modelRdfPrefix()/]": "[aModel.u_modelRdfNamespace()/]",
          [/if]"xsd": "http://www.w3.org/2001/XMLSchema#",
          "[aModel.name/]": "@included",
          [for (aClass : uml::Class | classes) separator(',\n    ')]
            "[aClass.name/]": {
              "@id": "[aClass.iri()/]",
              "@context": ['['/]
                [aClass.classJsonldSelfContained()/][aClass.classJsonldFile()/]
              ]
            }[/for]
          [if (datatypes->size()>0)],[/if]
          [for (aDataType : uml::DataType | datatypes) separator(',\n    ')]
            "[aDataType.name/]": {
              "@id": "[aDataType.iri()/]",
              "@context": ['['/]
                [aDataType.dataTypeJsonldSelfContained()/][aDataType.dataTypeJsonldFile()/]
              ]
            }[/for]
        },
        "generatedBy": "[aModel.generationMessageJsonld()/]",
        "basedOn": "based on the UML model [aModel.qualifiedName/]"
      }
    [/let]
  [/file]
[/template]

[**
Generates the whole-model JSON-LD context file for a profile
sub-package. Only classes and data types in the profile subset
are included. Written to:
  <shortName>/encoding/json-ld/<profiles_package>/<profileName>/<acronym>.jsonld

@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public profileGenerateJsonld(aProfilePackage : uml::Package)]
  [let aModel : uml::Model = aProfilePackage.u_model()]
    [let subsetClasses : OrderedSet(uml::Class) =
        aProfilePackage.u_childDependencySupplierClasses()]
    [let subsetDataTypes : OrderedSet(uml::DataType) =
        aProfilePackage.u_childDependencySupplierDataTypes()]
      [file (aModel.u_modelShortName() + '/encoding/json-ld/' + 'profiles_package'.getRequiredPropertyValue() + '/' + aProfilePackage.name + '/' + aProfilePackage.name + '.jsonld', overwrite, 'UTF-8')]
        {
          "@context": {
            [if (aProfilePackage.u_modelRdfPrefix() <> 'NOT_SET' and aProfilePackage.u_modelRdfNamespace() <> 'NOT_SET')]"[aProfilePackage.u_modelRdfPrefix()/]": "[aProfilePackage.u_modelRdfNamespace()/]",
            [/if]"xsd": "http://www.w3.org/2001/XMLSchema#",
            "[aModel.name/]": "@included",
            [for (aClass : uml::Class | subsetClasses->sortedBy(c | c.name)) separator(',
    ')]
              "[aClass.name/]": {
                "@id": "[aClass.iri()/]",
                "@context": ['['/]
                  [aClass.classJsonldSelfContainedProfile(aProfilePackage)/]
                ]
              }[/for]
            [if (subsetDataTypes->select(d | d.isComplex() and d.isNotInMappedItems())->size() > 0)],[/if]
            [for (aDataType : uml::DataType | subsetDataTypes->select(d | d.isComplex() and d.isNotInMappedItems() and d.name <> 'PackageInformation')->sortedBy(d | d.name)) separator(',
    ')]
              "[aDataType.name/]": {
                "@id": "[aDataType.iri()/]",
                "@context": ['['/]
                  [aDataType.dataTypeJsonldSelfContained()/]
                ]
              }[/for]
          },
          "generatedBy": "[aModel.generationMessageJsonld()/]",
          "basedOn": "based on UML model [aModel.qualifiedName/] profile [aProfilePackage.name/]"
        }
      [/file]
    [/let]
    [/let]
  [/let]
[/template]
