[comment encoding = UTF-8 /]
[**
Module contains templates for JSON Schema.
/]
[module dataTypeJsch(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::jsonschema::commonJsch/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[**
*/]
[template public dataTypeJsch(aDataType : uml::DataType) post(self.trim())]
  "dt-[aDataType.name/]": {
    "description": "['RDF_NAMESPACE'.getPropertyValue()/][aDataType.name/]",
    "type": ['['/]"object"],
    "properties": {
      [aDataType.genAttributes()/]
      "@type": {
        "const": "[aDataType.name/]"
      }
    },
    "required": ['['/][aDataType.requiredAttributes()/]"@type"],
    "additionalProperties": false
  },[/template]