[comment encoding = UTF-8 /]
[**
Module contains templates for JSON Schema.
/]
[module commonJsch(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::classifierQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::queries::propertyQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[template public arrayClassSchemas(aModel : uml::Model)]
  [for (aClass : uml::Class | aModel.u_mainPackage().eAllContents(uml::Class)->sortedBy(c | c.name))]
    {
      "if": { "properties": { "@type": { "const": "[aClass.name/]" } } },
      "then": { "$ref": "#/defs/cls-[aClass.name/]" },
      "else": false
    },
  [/for]
[/template]

[**
 * List-items of the names of the required attributes returned as string
*/]
[query public requiredAttributes(aClassifier : uml::Classifier) : String =
  aClassifier.u_attributes()->select(p1 | p1.lower > 0)
    ->collect(p2 | '"' + p2.name + '",')
    ->toString()
/]

[template public genAttributes(aClassifier : uml::Classifier) post(self.trim())]
  [for (anAttribute : uml::Property | aClassifier.u_attributes())]
    "[anAttribute.name/]": {
      "$comment": "cardinality [anAttribute.lowerBound()/]..[anAttribute.upperBound()/] – from [aClassifier.iri()/]",
    [if (anAttribute.upperBound() = 1)]
        [anAttribute.ref()/]
    [else]
        "if": { "type": "array" },
        "then": { "items": { [anAttribute.ref()/] } },
        "else": { [anAttribute.ref()/] }
    [/if]
    },
  [/for]
[/template]

[**
Renders the $ref key-value pair for a single concrete classifier,
using the same enum/complex/other distinction as ref(). Used to build
one entry of an anyOf array for a polymorphic attribute (see
u_isPolymorphicAttributeType) -- kept as a separate template rather
than folded into ref() itself, so ref()'s existing three branches
stay completely unchanged for every non-polymorphic attribute.

@param aClassifier - A single concrete realization to render.
/]
[template protected refForClassifier(aClassifier : uml::Classifier) post(self.trim())]
  [if (aClassifier.oclIsTypeOf(uml::Enumeration))]
    "$ref": "#/defs/enum-[aClassifier.name/]"
  [elseif (aClassifier.isComplex())]
    "$ref": "#/defs/dt-[aClassifier.name/]"
  [else]
    "$ref": "#/defs/[aClassifier.iri()/]"
  [/if]
[/template]

[template protected ref(anAttribute : uml::Property) post(self.trim())]
  [if (anAttribute.type.oclIsTypeOf(uml::Enumeration))]
    "$ref": "#/defs/enum-[anAttribute.type.name/]"
  [elseif (anAttribute.u_isPolymorphicAttributeType())]
    "anyOf": ['['/][anAttribute.type.oclAsType(uml::Classifier).u_concreteRealizations()->collect(c | '{ ' + c.refForClassifier() + ' }')->sep(', ')/] ]
  [elseif (anAttribute.type.isComplex())]
    "$ref": "#/defs/dt-[anAttribute.type.name/]"
  [else]
    "$ref": "#/defs/[anAttribute.type.iri()/]"
  [/if]
[/template]

[**
Generates JSON Schema properties entries for attributes of a class
in profile context. Only attributes passing u_isAttributeInProfile
are included.

@param aClassifier     - The classifier whose attributes are rendered.
@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public genAttributesProfile(
  aClassifier : uml::Classifier,
  aProfilePackage : uml::Package) post(self.trim())]
  [for (anAttribute : uml::Property | aClassifier.u_attributes()
      ->select(a | a.u_isAttributeInProfile(
          aClassifier.oclAsType(uml::Class), aProfilePackage)))]
    "[anAttribute.name/]": {
      "$comment": "cardinality [anAttribute.lowerBound()/]..[anAttribute.upperBound()/] – from [aClassifier.iri()/]",
    [if (anAttribute.upperBound() = 1)]
        [anAttribute.ref()/]
    [else]
        "if": { "type": "array" },
        "then": { "items": { [anAttribute.ref()/] } },
        "else": { [anAttribute.ref()/] }
    [/if]
    },
  [/for]
[/template]

[**
Generates the anyOf dispatch entries for all profile subset classes,
used in the root-object schema to dispatch on @type.

@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public arrayClassSchemasProfile(aProfilePackage : uml::Package)]
  [for (aClass : uml::Class | aProfilePackage.u_childDependencySupplierClasses()
      ->sortedBy(c | c.name))]
    {
      "if": { "properties": { "@type": { "const": "[aClass.name/]" } } },
      "then": { "$ref": "#/defs/cls-[aClass.name/]" },
      "else": false
    },
  [/for]
[/template]
