[comment encoding = UTF-8 /]
[**
All templates in the *Jsch.mtl modules generate JSON Schema.
/]
[module modelJschFile(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::jsonschema::classJsch/]
[import ucmism2t::templates::target::jsonschema::commonJsch/]
[import ucmism2t::templates::target::jsonschema::dataTypeJsch/]
[import ucmism2t::templates::target::jsonschema::enumerationJsch/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[**
 * This generator creates a JSON-Schema file corresponding to the JSON-LD file.
 * @param aModel a model
*/]
[template public generateJsonSchema(aModel : uml::Model)]
  [file (aModel.u_modelShortName() + '/encoding/json-schema/' + aModel.u_universePathSegment() + aModel.u_modelAcronym().toLower() + '.schema.json', overwrite, 'UTF-8')]
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "[aModel.name/]",
      "description": "This code was generated by the Eclipse Acceleo module UCMIS M2T.",
      "version": "[aModel.jschVersion()/]",
    
      "if": { "type": "object" },
      "then": { "anyOf": ['['/]
        { "$ref": "#/defs/root-object" },
        { "$ref": "#/defs/root-graph" }
      [']'/]},
      "else": { "$ref": "#/defs/root-array" },
    
      "defs": {
        "root-object": {
          "type": "object",
          "required": ['['/]"@type"],
          "anyOf": ['['/]
            [aModel.arrayClassSchemas()/]
            false
          ]
        },
        "root-array": {
          "type": "array",
          "items": { "$ref": "#/defs/root-object" }
        },
        "root-graph": {
          "type": "object",
          "required": ['['/]"[aModel.name/]"],
          "properties": {
            "[aModel.name/]": { "$ref": "#/defs/root-array" }
          }
        },
    [for (aClass : uml::Class | aModel.u_mainPackage().eAllContents(uml::Class)->sortedBy(temp1 | temp1.name))]
          [aClass.classJsch()/]
    [/for]
    [for (anEnumeration : uml::Enumeration | aModel.u_mainPackage().eAllContents(uml::Enumeration)->sortedBy(temp2 | temp2.name))]
          [anEnumeration.enumerationJsch()/]
    [/for]
    [for (aDataType : uml::DataType | aModel.eAllContents(uml::DataType)->select(aDataType | aDataType.isComplex() and aDataType.u_isInAllowedPackage() and aDataType.isNotInMappedItems() and aDataType.name <> 'PackageInformation'))]
          [aDataType.dataTypeJsch()/]
    [/for]
        "xsd:string": {
          "type": "string"
        },
        "xsd:boolean": {
          "type": "boolean"
        },
        "xsd:integer": {
          "type": "integer"
        },
        "xsd:double": {
          "type": "number"
        },
        "xsd:nonNegativeInteger": {
          "type": "integer",
          "minumum": 0
        },
        "xsd:anyURI": {
          "type": "string",
          "format": "uri-reference"
        },
        "xsd:date": {
          "type": "string",
          "format": "date"
        },
        "xsd:language": {
          "type": "string",
          "pattern": "^a-zA-Z]+(-['['/]a-zA-Z]+)*$"
        },
        "rdf:langString": {
          "type": "object",
          "properties": {
            "@value": { "type": "string" },
            "@type": { "type": "string", "format": "iri-reference" }
           },
           "required": ['['/]"@value", "@type"]
        },
        "owl:sameAs": {
          "anyOf": ['['/]
            {
              "type": "string",
              "format": "iri-reference"
            },
            {
              "type": "object"
            }
          ]
        },
        "at-context": {
          "anyOf": ['['/]
            {
              "type": "string",
              "format": "iri-reference"
            },
            {
              "type": "array",
              "items": {
                "anyOf": ['['/]
                  {
                    "type": "string",
                    "format": "iri-reference"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  [/file]
[/template]

[template public jschVersion(aModel : uml::Model) post(self.trim())]
  [aModel.u_modelMajorVersion() + '.' + aModel.u_modelMinorVersion()/]
[/template]

[**
Generates the whole-model JSON Schema file for a profile sub-package.
Only classes, enumerations and data types in the profile subset are
included. Written to:
  <shortName>/encoding/json-schema/<profiles_package>/<profileName>/<acronym>.schema.json

@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public profileGenerateJsonSchema(aProfilePackage : uml::Package)]
  [let aModel : uml::Model = aProfilePackage.u_model()]
    [let subsetClasses : OrderedSet(uml::Class) =
        aProfilePackage.u_childDependencySupplierClasses()]
    [let subsetDataTypes : OrderedSet(uml::DataType) =
        aProfilePackage.u_childDependencySupplierDataTypes()]
      [file (aModel.u_modelShortName() + '/encoding/json-schema/' + 'profiles_package'.getRequiredPropertyValue() + '/' + aProfilePackage.name + '/' + aProfilePackage.name + '.schema.json', overwrite, 'UTF-8')]
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "[aModel.name/] - [aProfilePackage.name/]",
          "description": "This code was generated by the Eclipse Acceleo module UCMIS M2T.",
          "version": "[aModel.jschVersion()/]",
        
          "if": { "type": "object" },
          "then": { "anyOf": ['['/]
            { "$ref": "#/defs/root-object" },
            { "$ref": "#/defs/root-graph" }
          ]},
          "else": { "$ref": "#/defs/root-array" },
        
          "defs": {
            "root-object": {
              "type": "object",
              "required": ['['/]"@type"],
              "anyOf": ['['/]
                [aProfilePackage.arrayClassSchemasProfile()/]
                false
              ]
            },
            "root-array": {
              "type": "array",
              "items": { "$ref": "#/defs/root-object" }
            },
            "root-graph": {
              "type": "object",
              "required": ['['/]"[aModel.name/]"],
              "properties": {
                "[aModel.name/]": { "$ref": "#/defs/root-array" }
              }
            },
        [for (aClass : uml::Class | subsetClasses->sortedBy(c | c.name))]
              [aClass.classProfileJsch(aProfilePackage)/]
        [/for]
        [for (anEnumeration : uml::Enumeration | subsetDataTypes
            ->select(d | d.oclIsTypeOf(uml::Enumeration))
            ->collect(d | d.oclAsType(uml::Enumeration))
            ->sortedBy(e | e.name))]
              [anEnumeration.enumerationJsch()/]
        [/for]
        [for (aDataType : uml::DataType | subsetDataTypes
            ->select(d | d.isComplex() and d.isNotInMappedItems()
              and d.name <> 'PackageInformation')
            ->sortedBy(d | d.name))]
              [aDataType.dataTypeJsch()/]
        [/for]
            "xsd:string": { "type": "string" },
            "xsd:boolean": { "type": "boolean" },
            "xsd:integer": { "type": "integer" },
            "xsd:double": { "type": "number" },
            "xsd:nonNegativeInteger": { "type": "integer", "minumum": 0 },
            "xsd:anyURI": { "type": "string", "format": "uri-reference" },
            "xsd:date": { "type": "string", "format": "date" },
            "xsd:language": { "type": "string", "pattern": "^a-zA-Z]+(-['['/]a-zA-Z]+)*$" },
            "rdf:langString": {
              "type": "object",
              "properties": {
                "@value": { "type": "string" },
                "@type": { "type": "string", "format": "iri-reference" }
              },
              "required": ['['/]"@value", "@type"]
            },
            "owl:sameAs": {
              "anyOf": ['['/]
                { "type": "string", "format": "iri-reference" },
                { "type": "object" }
              ]
            },
            "at-context": {
              "anyOf": ['['/]
                { "type": "string", "format": "iri-reference" },
                {
                  "type": "array",
                  "items": {
                    "anyOf": ['['/]
                      { "type": "string", "format": "iri-reference" },
                      { "type": "object" }
                    ]
                  }
                }
              ]
            }
          }
        }
      [/file]
    [/let]
    [/let]
  [/let]
[/template]
