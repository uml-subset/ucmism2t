[comment encoding = UTF-8 /]
[**
Module contains templates for JSON Schema.
/]
[module enumerationJsch(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::jsonschema::commonJsch/]

[**
 * Generates XML Schema code for an enumeration.
 * @param anEnumeration
*/]
[template public enumerationJsch(anEnumeration : uml::Enumeration) post(self.trim())]
  "enum-[anEnumeration.name/]": {
    "description": "['RDF_NS'.getPropertyValue()/][anEnumeration.name/]",
    "enum": ['['/]
  [for (aLiteral : uml::EnumerationLiteral | anEnumeration.oclAsType(uml::Enumeration).ownedLiteral) separator(',')]
        "[aLiteral.name/]"
  [/for]
    ]
  },[/template]