[comment encoding = UTF-8 /]
[**

/]
[module processModelOnto(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::eobjectQuery/]
[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::onto::classOnto/]
[import ucmism2t::templates::target::onto::dataTypeOnto/]
[import ucmism2t::templates::target::onto::enumerationOnto/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[template public packageOntoFile(aPackage : uml::Package)]
  [let isModelRoot : Boolean = aPackage.eContainer(uml::Package) = null]
    [let dynamicNamespaces : Sequence(String) = aPackage.u_referencedNamespaces()]
      [let staticNamespaces : Sequence(String) = aPackage.u_staticNamespaces()]
        [file (aPackage.u_model().u_modelShortName() + '/encoding/ontology/' + (if isModelRoot then '' else if 'profiles'.isPropertyTrue() then 'universe_package'.getRequiredPropertyValue() + '/' else '' endif endif) + aPackage.name + '.onto.ttl', overwrite, 'UTF-8')]
          # PLEASE DO NOT EDIT THIS CODE!
          # This code was generated by the Eclipse Acceleo module UCMIS M2T.
          # Target language is 'Ontology Turtle' ('onto.ttl') generated on the basis of the model '[aPackage.u_model().name/]'.
          
          # Ontology for [aPackage.name/]
          # based on the UML package [aPackage.qualifiedName/]
          [aPackage.validateNamespaceConflicts(dynamicNamespaces, staticNamespaces)/]
          [aPackage.validateResolvedNamespaces(aPackage.u_elementsWithUnresolvedNamespace())/]
          [aPackage.ttl_prefixesDynamic(aPackage.u_combinedNamespaces(dynamicNamespaces, staticNamespaces))/]
          
          <[aPackage.name/].onto.ttl> a owl:Ontology;
            rdfs:label "[aPackage.name/]";
            [aPackage.rdfs_comment()/]
          [for (subPackage : uml::Package | aPackage.u_childPackages()
            ->select(p1 | p1.u_isAllowedPackage())
            ->select(p2 | 'IGNORE_PACKAGE'.getPropertyValue().substituteAll(' ', '').tokenize(',')->excludes(s | s=aPackage.name))
            ->select(p3 | not ('profiles'.isPropertyTrue() and (p3.name = 'profiles_package'.getRequiredPropertyValue() or p3.eContainer(uml::Package).name = 'profiles_package'.getRequiredPropertyValue())))
            )]
              owl:imports <[if (isModelRoot)]['universe_package'.getRequiredPropertyValue()/]/[/if][subPackage.name/].onto.ttl>;[subPackage.packageOntoFile()/]
          [/for]
          .
          
          [for (aClass : uml::Class | aPackage.u_childClasses())]
            [aClass.classOnto()/]
          [/for]
          
          [for (aDataType : uml::DataType | aPackage.u_childrenDataTypes()
            ->select(aDataType | aDataType.isComplex() and aDataType.isNotInMappedItems() and aDataType.name <> 'PackageInformation'))]
            [aDataType.dataTypeOnto()/]
          [/for]
          
          [for (anEnumeration : uml::Enumeration | aPackage.u_childrenEnumerations())]
            [anEnumeration.enumerationOnto()/]
          [/for]
        [/file]
      [/let]
    [/let]
  [/let]
[/template]

[**
Generates the whole-model OWL/Turtle ontology file for a profile
sub-package. Only classes, data types and enumerations in the
profile subset are included. Written to:
  <shortName>/encoding/ontology/<profiles_package>/<profileName>/<profileName>.onto.ttl

@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public profileOntoFile(aProfilePackage : uml::Package)]
  [let aModel : uml::Model = aProfilePackage.u_model()]
    [let subsetClasses : OrderedSet(uml::Class) =
        aProfilePackage.u_childDependencySupplierClasses()]
      [let subsetDataTypes : OrderedSet(uml::DataType) =
          aProfilePackage.u_childDependencySupplierDataTypes()]
        [let dynamicNamespaces : Sequence(String) = aProfilePackage.u_referencedNamespacesForProfile()]
          [let staticNamespaces : Sequence(String) = aProfilePackage.u_staticNamespaces()]
            [file (aModel.u_modelShortName() + '/encoding/ontology/' + 'profiles_package'.getRequiredPropertyValue() + '/' + aProfilePackage.name + '/' + aProfilePackage.name + '.onto.ttl', overwrite, 'UTF-8')]
              # PLEASE DO NOT EDIT THIS CODE!
              # This code was generated by the Eclipse Acceleo module UCMIS M2T.
              # Target language is 'Ontology Turtle' ('onto.ttl').
              
              # Ontology for profile [aProfilePackage.name/]
              [aProfilePackage.validateNamespaceConflicts(dynamicNamespaces, staticNamespaces)/]
              [aProfilePackage.validateResolvedNamespaces(aProfilePackage.u_elementsWithUnresolvedNamespaceForProfile())/]
              [aProfilePackage.ttl_prefixesDynamic(aProfilePackage.u_combinedNamespaces(dynamicNamespaces, staticNamespaces))/]
              
              <[aProfilePackage.name/].onto.ttl> a owl:Ontology;
                rdfs:label "[aProfilePackage.name/]";
              .
              
              [for (aClass : uml::Class | subsetClasses->sortedBy(c | c.name))]
                [aClass.classProfileOnto(aProfilePackage)/]
              [/for]
              
              [for (aDataType : uml::DataType | subsetDataTypes->sortedBy(d | d.name)
                  ->select(d | d.isComplex() and d.isNotInMappedItems() and d.name <> 'PackageInformation'))]
                [aDataType.dataTypeOnto()/]
              [/for]
            [/file]
          [/let]
        [/let]
      [/let]
    [/let]
  [/let]
[/template]
