[comment encoding = UTF-8 /]
[**

/]
[module associationOnto(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[comment encoding = UTF-8 /]
[template public associationOnto(anAssociation : uml::Association, aClass : uml::Class)]
  [anAssociation.iri()/]
    a rdf:Property, owl:ObjectProperty, ucmis:Association;
    # ASSOCIATION
    rdfs:label "[anAssociation.shortName()/]";
    skos:altLabel "[anAssociation.name/]";
    [anAssociation.rdfs_comment()/]
    rdfs:domain [aClass.iri()/];
    rdfs:range [anAssociation.u_otherEndClass().iri()/];
  .
[/template]