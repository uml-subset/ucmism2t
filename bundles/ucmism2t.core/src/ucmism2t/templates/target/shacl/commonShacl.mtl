[comment encoding = UTF-8 /]
[**

/]
[module commonShacl(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::classifierQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::propertyQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[template public subClassesShapes(aClass : uml::Class)]
  [let scs : OrderedSet(uml::Class) = aClass.u_subClasses()]
    [if (scs->isEmpty())]
      [aClass.fragment()/]
    [else]
      ['['/] sh:or ( [aClass.fragment()/]
          [scs->asSequence()->collect(sc | sc.fragment())->sep(' ')/]
      )]
    [/if]
  [/let]
[/template]

[template public allSubClasses(aClass : uml::Class) post(self.removeLineSeparators().replaceAll('  ', ' '))]
  [aClass.iri() + ' '/]
  [for (sc : uml::Class | aClass.u_subClasses())]
    [sc.allSubClasses() + ' '/]
  [/for]
[/template]

[template public subDatatypesShapes(aDataType : uml::Type)]
  [let sds : OrderedSet(uml::DataType) = aDataType.eInverse(uml::DataType)->sortedBy(temp1 | temp1.name)]
    [if (sds->isEmpty())]
      [aDataType.fragment()/]
    [else]
      ['['/] sh:or ( [aDataType.fragment()/]
          [sds->asSequence()->collect(sd | sd.fragment())->sep(' ')/]
      )]
    [/if]
  [/let]
[/template]

[template public allSubDataTypes(aDataType : uml::Type)]
    [aDataType.iri()/]
  [for (sc : uml::DataType | aDataType.eInverse(uml::DataType)->sortedBy(temp2 | temp2.name))][sc.allSubDataTypes()/][/for][/template]

[**
Renders the sh:or union shape for an attribute whose type is
configured in "uml-union-types" (see u_isUnionTypeAttribute). Each
configured type name gets its own branch, mirroring
unionTypeShape's dispatch-by-name approach for JSON Schema.

Validates only at the same depth the existing complex-type branch
already uses for other types -- an rdf:type check, not a full
property-by-property validation -- for consistency with how this
codebase already treats complex datatypes in SHACL.

@param anAttribute - The union-typed attribute to render.
/]
[template public unionTypeShacl(anAttribute : uml::Property)]
  [if (anAttribute.type.name = 'Identifier')]
    sh:or ( ['['/] sh:datatype xsd:string ] ['['/] sh:property ['['/] sh:path rdf:type; sh:minCount 1; sh:in ( schema:PropertyValue ) ] ] ) ;
  [elseif (anAttribute.type.name = 'ObjectReference')]
    sh:or ( ['['/] sh:nodeKind sh:IRI ] ['['/] sh:datatype xsd:string ] ['['/] sh:property ['['/] sh:path rdf:type; sh:minCount 1; sh:in ( schema:PropertyValue ) ] ] ) ;
  [/if]
[/template]

[template public attributeShape(anAttribute : uml::Property)]
  [anAttribute.fragment()/] a sh:PropertyShape ;
      sh:path [anAttribute.iri()/];
  [if (anAttribute.type.oclIsTypeOf(uml::PrimitiveType))]
        sh:datatype [anAttribute.type.iri()/];
  [elseif (anAttribute.type.oclIsTypeOf(uml::Enumeration))]
        sh:node [anAttribute.type.subDatatypesShapes()/];
  [elseif (anAttribute.u_isUnionTypeAttribute())]
        [anAttribute.unionTypeShacl()/]
  [else]
        sh:node ['['/] sh:property ['['/] sh:path rdf:type; sh:minCount 1; sh:in (
          [if (anAttribute.u_isPolymorphicAttributeType())][anAttribute.type.oclAsType(uml::Classifier).allSubDataTypesConcrete()/][else][anAttribute.type.allSubDataTypes()/][/if]
        ) ]];
  [/if]
  [if (anAttribute.lower > 0)]
        sh:minCount [anAttribute.lower/];
  [/if]
  [if (not anAttribute.upper.u_isUnlimited())]
        sh:maxCount [anAttribute.upper/];
  [/if]
  .[/template]
[**
Same purpose as allSubDataTypes, but for a classifier whose type is
abstract: lists only concrete realizations (see u_concreteRealizations),
never the abstract type itself, since no real instance can ever have
the abstract type as its rdf:type. Kept separate from allSubDataTypes
rather than folded into it, so that non-abstract types are completely
unaffected -- both output ordering and content stay identical to
before for every case that was already working.

@param aClassifier - The class or data type whose concrete
                      realizations to list.
/]
[template public allSubDataTypesConcrete(aClassifier : uml::Classifier)]
  [for (c : uml::Classifier | aClassifier.u_concreteRealizations())][c.iri()/] [/for][/template]
