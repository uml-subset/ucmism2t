[comment encoding = UTF-8 /]
[**

/]
[module modelShaclFile(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::configurationQuery/]
[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::eobjectQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::shacl::classShacl/]
[import ucmism2t::templates::target::shacl::dataTypeShacl/]
[import ucmism2t::templates::target::rdf::commonRdf/]
[import ucmism2t::templates::target::shacl::commonShacl/]

[comment encoding = UTF-8 /]
[**
 * Processes an UML class model according to the the rules described in the
 * document "UML Class Interoperable Subset".
 * See {@https://bitbucket.org/ddi-alliance/ucmis/}.
 * Creates a file for the model.
 * @param aModel a model

This generates one file for the entire universe, deliberately not
split per sub-package. Two prior decisions inform this:

Modular, per-type JSON-LD files were tried first and abandoned as
impractical to work with in real applications -- splitting further,
by sub-package, would reintroduce the same problem at a coarser
grain.

A sub-package boundary (e.g. Schema, SKOS, DCAT) rarely matches what
a real consumer wants: each is just the CDIF-relevant subset of an
external vocabulary, and cross-sub-package references are the norm
in this model, not the exception, so splitting would turn most
references into cross-file ones with no established linking
mechanism for SHACL/ShEx to match JSON-LD's own @context chaining.

Applications should use the profile-scoped files instead, which
already provide the combined, consumption-ready view a real
integration needs. This whole-universe file exists primarily as a
completeness/reference artifact, not as something on any
application's critical path, so its size is a lesser concern than
it would be for the profile files.
*/]
[template public packageShaclFile(aModel : uml::Model)]
  [let mainPackage : uml::Package = aModel.u_mainPackage()]
  [let dynamicNamespaces : Sequence(String) = mainPackage.u_referencedNamespaces()]
  [let staticNamespaces : Sequence(String) = aModel.u_staticNamespaces()]
  [file (aModel.u_modelShortName() + '/encoding/shacl/' + aModel.u_universePathSegment() + aModel.u_modelAcronym().toLower() + '.shacl.ttl', overwrite, 'UTF-8')]
    [aModel.validateNamespaceConflicts(dynamicNamespaces, staticNamespaces)/]
    [aModel.validateResolvedNamespaces(mainPackage.u_elementsWithUnresolvedNamespace())/]
    [aModel.validateEmbeddedNamespacePrefixes(mainPackage.u_attributesWithEmbeddedPrefix())/]
    [aModel.ttl_prefixesDynamic(aModel.u_combinedNamespaces(dynamicNamespaces, staticNamespaces))/]
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    
    [for (aClass : uml::Class | mainPackage.eAllContents(uml::Class)->sortedBy(temp1 | temp1.name))]
      [aClass.classShacl()/]
    [/for]
    [for (aDataType : uml::DataType | mainPackage.eAllContents(uml::DataType)->sortedBy(temp2 | temp2.name)->select(temp3 | not temp3.qualifiedName.contains('XMLSchemaDataTypes'))->select(temp5 | temp5.isNotInMappedItems()))]
      [aDataType.dataTypeShacl()/]
    [/for]
  [/file]
  [/let]
  [/let]
  [/let]
[/template]

[**
Generates the whole-model SHACL file for a profile sub-package.
Only classes and data types in the profile subset are included.
Written to:
  <shortName>/encoding/shacl/<profiles_package>/<profileName>/<acronym>.shacl.ttl

Called from packageDocFile.mtl in the profile branch, once per
profile sub-package after all class fragments have been generated.

@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public profileShaclFile(aProfilePackage : uml::Package)]
  [let aModel : uml::Model = aProfilePackage.u_model()]
    [let subsetClasses : OrderedSet(uml::Class) =
        aProfilePackage.u_childDependencySupplierClasses()]
    [let subsetDataTypes : OrderedSet(uml::DataType) =
        aProfilePackage.u_childDependencySupplierDataTypes()]
    [let dynamicNamespaces : Sequence(String) = aProfilePackage.u_referencedNamespacesForProfile()]
    [let staticNamespaces : Sequence(String) = aProfilePackage.u_staticNamespaces()]
      [file (aModel.u_modelShortName() + '/encoding/shacl/' + 'profiles_package'.getRequiredPropertyValue() + '/' + aProfilePackage.name + '/' + aProfilePackage.name + '.shacl.ttl', overwrite, 'UTF-8')]
        [aProfilePackage.validateNamespaceConflicts(dynamicNamespaces, staticNamespaces)/]
        [aProfilePackage.validateResolvedNamespaces(aProfilePackage.u_elementsWithUnresolvedNamespaceForProfile())/]
        [aProfilePackage.validateEmbeddedNamespacePrefixes(aProfilePackage.u_attributesWithEmbeddedPrefixForProfile())/]
        [aProfilePackage.ttl_prefixesDynamic(aProfilePackage.u_combinedNamespaces(dynamicNamespaces, staticNamespaces))/]
        PREFIX sh: <http://www.w3.org/ns/shacl#>
        
        [for (aClass : uml::Class | subsetClasses->sortedBy(c | c.name))]
          [aClass.classProfileShacl(aProfilePackage)/]
        [/for]
        [for (aDataType : uml::DataType | subsetDataTypes->sortedBy(d | d.name)->select(d | not d.qualifiedName.contains('XMLSchemaDataTypes'))->select(d2 | d2.isNotInMappedItems()))]
          [aDataType.dataTypeShacl()/]
        [/for]
      [/file]
    [/let]
    [/let]
    [/let]
    [/let]
  [/let]
[/template]
