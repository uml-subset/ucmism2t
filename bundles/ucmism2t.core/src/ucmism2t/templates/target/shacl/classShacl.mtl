[comment encoding = UTF-8 /]
[**

/]
[module classShacl(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::propertyQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::rdf::commonRdf/]
[import ucmism2t::templates::target::shacl::commonShacl/]
[import ucmism2t::queries::configurationQuery/]

[template public classShacl(aClass : uml::Class)]
  # class [aClass.name/]
  # based on the UML class [aClass.qualifiedName/]
  [aClass.fragment()/] a sh:NodeShape;
      sh:targetClass [aClass.iri()/];
  	sh:message "See ['RDF_NS'.getPropertyValue()/][aClass.name/]";
  	sh:closed true;
  	sh:ignoredProperties ( owl:sameAs );
      sh:property ['['/]
  			sh:path rdf:type;
  			sh:in ( [aClass.allSubClasses()/] ) ;
      ];
  [aClass.classPropertiesShacl()/]
  .
  
  [for (anAttribute : uml::Property | aClass.u_attributes())]
    [anAttribute.attributeShape()/]
  [/for]
  
  [for (anAssociation : uml::Association | aClass.u_associations()->select(anAssociation | anAssociation.u_ownedEndClass() = aClass))]
    [let sourceEnd : uml::Property = anAssociation.ownedEnd->first()]
      [let targetEnd : uml::Property = sourceEnd.getOtherEnd()]
        [anAssociation.fragment()/] a sh:PropertyShape ;
            sh:path [anAssociation.iri()/];
        	sh:node ['['/] sh:property ['['/] sh:path rdf:type; sh:minCount 1; sh:in (
              [anAssociation.u_otherEndClass().allSubClasses()/]
            ) ]];
        [if (targetEnd.lower > 0)]
              sh:minCount [targetEnd.lower/];
        [/if]
        [if (not targetEnd.upper.u_isUnlimited())]
              sh:maxCount [targetEnd.upper/];
        [/if]
        .
        [anAssociation.fragmentRev()/] a sh:PropertyShape ;
            sh:path ['['/] sh:inversePath [anAssociation.iri()/] ];
        [if (sourceEnd.lowerBound() > 0)]
              sh:minCount [sourceEnd.lower/];
        [/if]
        [if (not sourceEnd.upper.u_isUnlimited())]
              sh:maxCount [sourceEnd.upper/];
        [/if]
        .
      [/let]
    [/let]
  [/for]
[/template]

[template public classPropertiesShacl(aClass : uml::Class)]
      # attributes
  [for (anAttribute : uml::Property | aClass.u_attributes())]
        sh:property [anAttribute.fragment()/];
  [/for]
      # associations from [aClass.name/]
  [for (anAssociation : uml::Association | aClass.u_associations()->select(anAssociation | anAssociation.u_ownedEndClass() = aClass))]
        sh:property [anAssociation.fragment()/];
  [/for]
      # associations to [aClass.name/]
  [for (anAssociation : uml::Association | aClass.u_associations()->select(anAssociation | anAssociation.u_otherEndClass() = aClass))]
        sh:property [anAssociation.fragmentRev()/];
  [/for]
  
  [for (sc : uml::Class | aClass.superClass)]
        # ---- superclass: [sc.name/]
    [sc.classPropertiesShacl()/]
  [/for]
  
[/template]