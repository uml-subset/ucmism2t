[comment encoding = UTF-8 /]
[**

/]
[module classShex(
  'http://www.eclipse.org/uml2/5.0.0/UML',
  'http://www.eclipse.org/uml2/5.0.0/Types',
  'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]
[import ucmism2t::templates::target::shex::associationShex/]
[import ucmism2t::templates::target::shex::commonShex/]

[template public classShex(aClass : uml::Class)]
  # class [aClass.name/]
  # based on the UML class [aClass.qualifiedName/]
  [aClass.iri()/]Shape CLOSED {
    a ['['/][aClass.iri()/]];
  [if (aClass.u_isSuperClass())]
      $[aClass.iri()/]Properties (
  [/if]
  [for (anAttribute : uml::Property | aClass.u_attributes())]
      [anAttribute.attributeShex()/]
  [/for]
  [for (anAssociation : uml::Association | aClass.u_associations())]
      [anAssociation.associationShex(aClass)/]
  [/for]
    [aClass.superClasses()/][if (aClass.u_isSuperClass())]
                              );
                           [/if]
  }
[/template]

[**
Generates a ShEx shape for a class in the context of a profile
sub-package. Only attributes in the profile (via u_isAttributeInProfile)
and associations where both ends are in the profile subset are included.
Superclass references are limited to those in the profile subset.

@param aClass          - The UML class to generate ShEx for.
@param aProfilePackage - The profile sub-package defining the subset.
/]
[template public classProfileShex(aClass : uml::Class, aProfilePackage : uml::Package)]
  [let subsetClasses : OrderedSet(uml::Class) =
      aProfilePackage.u_childDependencySupplierClasses()]
    # class [aClass.name/]
    # based on the UML class [aClass.qualifiedName/]
    [aClass.iri()/]Shape CLOSED {
      a ['['/][aClass.iri()/]];
    [if (aClass.u_isSuperClass())]
        $[aClass.iri()/]Properties (
    [/if]
    [for (anAttribute : uml::Property | aClass.u_attributes()
        ->select(a | a.u_isAttributeInProfile(aClass, aProfilePackage)))]
        [anAttribute.attributeShex()/]
    [/for]
    [for (anAssociation : uml::Association | aClass.u_associations()
        ->select(a | subsetClasses->includes(a.u_ownedEndClass())
          and subsetClasses->includes(a.u_otherEndClass())))]
        [anAssociation.associationShex(aClass)/]
    [/for]
      [aClass.superClassesProfile(subsetClasses)/][if (aClass.u_isSuperClass())]
                                                    );
                           [/if]
    }
  [/let]
[/template]
