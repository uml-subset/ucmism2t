[comment encoding = UTF-8 /]
[**

/]
[module modelShexFile(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::target::shex::classShex/]
[import ucmism2t::templates::target::shex::dataTypeShex/]
[import ucmism2t::templates::target::rdf::commonRdf/]
[import ucmism2t::templates::target::shex::commonShex/]

[**
 * Processes an UML class model according to the the rules described in the
 * document "UML Class Interoperable Subset".
 * See {@https://bitbucket.org/ddi-alliance/ucmis/}.
 * Creates a file for the model.
 * @param aModel a model
*/]
[template public processModelShex(aModel : uml::Model)]
  [file (aModel.u_modelShortName() + '/encoding/shex/' + aModel.u_modelAcronym().toLower() + '.shexc', overwrite, 'UTF-8')]
    [aModel.u_model().ttl_prefixes()/]
    
    start = @['RDF_NS'.getPropertyValue()/]:WideDataSetShape
    
    [for (aClass : uml::Class | aModel.u_mainPackage().eAllContents(uml::Class)->sortedBy(temp1 | temp1.name))]
      [aClass.classShex()/]
    [/for]
    [for (aDataType : uml::DataType | aModel.u_mainPackage().eAllContents(uml::DataType)->sortedBy(temp2 | temp2.name)->select(temp3 | not temp3.oclIsTypeOf(uml::Enumeration))->select(temp4 | not temp4.qualifiedName.contains('XMLSchemaDataTypes')))]
      [aDataType.dataTypeShex()/]
    [/for]
  [/file]
[/template]