[**

/]
[module associationShex(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::propertyQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]
[import ucmism2t::templates::target::shex::commonShex/]

[template public associationShex(anAssociation : uml::Association, aClass : uml::Class)]
  [if (anAssociation.u_ownedEndClass() = aClass)]
    [anAssociation.iri()/]	@[anAssociation.u_otherEndClass().iri()/]Shape [anAssociation.u_otherEndClass().subClasses()/][anAssociation.u_otherEnd().u_shexCardinality()/];
  [else]^[anAssociation.iri()/] @[anAssociation.u_ownedEndClass().iri()/]Shape [anAssociation.u_ownedEndClass().subClasses()/][anAssociation.u_ownedEnd().u_shexCardinality()/];[/if][/template]