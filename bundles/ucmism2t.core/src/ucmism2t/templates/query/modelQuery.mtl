[comment encoding = UTF-8 /]
[**
Module contains all model queries.
Queries with prefix "e_" are migrated from Acceleo 3.7.
Queries with prefix "u_" are written for Acceleo 4.
/]
[module modelQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::services::PropertiesService /]

[**
Returns the package identified by the main package name.
The main package name is specified by the property MAIN_PACKAGE_NAME.
Returns the model object if MAIN_PACKAGE_NAME is not found
or not specified.
Note: A package is a generalization of the model in the UML metamodel.

@param aModel A UML model
/]
[query public e_mainPackage(aModel : uml::Model) : uml::Package =
	let propertyValue : String =
		'MAIN_PACKAGE_NAME'.getPropertyValue()
	in
	let matchedPackages : Sequence(uml::Package) =
		aModel.eAllContents(uml::Package)
			->select(aPackage | aPackage.qualifiedName = propertyValue)
	in
	if propertyValue = ''
		or propertyValue = aModel.name
		or matchedPackages->size() = 0
	then aModel
	else matchedPackages->first()
	endif
/]

[**
Returns true if the specified named element is a
direct or indirect child of the main package.

@param aNamedElement A UML named element
/]
[query public e_isChildOfMainPackage(
		aNamedElement : uml::NamedElement) : Boolean =
	aNamedElement.getModel()
		.e_mainPackage()
		.eAllContents(uml::NamedElement)
		->includes(aNamedElement)
/]

[**
Returns an ordered set of strings for the comma-separated values
of a property key, sorted by value.

@param propertyKey A property key string
/]
[query public e_propertyValues(
		propertyKey : String) : OrderedSet(String) =
	let propertyValue : String = propertyKey.getPropertyValue()
	in
	if propertyValue = ''
	then OrderedSet{}
	else
		propertyValue
			.replaceAll('\\s', '')
			.tokenize(',')
			->sortedBy(value | value)
			->asOrderedSet()
	endif
/]

[**
Returns an ordered set of package objects, sorted by package name,
for the specified ordered set of package names.

@param aPackage A UML package used as search root
@param packagesAsString An ordered set of package name strings
/]
[query public e_packageObjects(
		aPackage : uml::Package,
		packagesAsString : OrderedSet(String)) : OrderedSet(uml::Package) =
	packagesAsString
		->asSequence()
		->collect(aName | aPackage.e_packageObject(aName))
		->excluding(aPackage = null)
		->asOrderedSet()
/]

[**
Returns a package object of the specified name that is a
direct or indirect child of the specified package.
Returns undefined if the name is not found.
Note: Works only for unique package names in the model.

@param aPackage A UML package used as search root
@param aName The package name to search for
/]
[query public e_packageObject(
		aPackage : uml::Package,
		aName : String) : uml::Package =
	let matchedPackages : Sequence(uml::Package) =
		aPackage.eAllContents(uml::Package)
			->select(p | p.name = aName)
	in
	if matchedPackages->size() = 0
	then null
	else matchedPackages->first()
	endif
/]

[**
Returns a named element object of the specified name that is a
direct or indirect child of the specified named element.

@param aNamedElement A UML named element used as search root
@param aString The name to search for
/]
[query public e_namedElementObject(
		aNamedElement : uml::NamedElement,
		aString : String) : uml::NamedElement =
	aNamedElement.eAllContents(uml::NamedElement)
		->select(n | n.name = aString)
		->first()
/]

[**
Returns true if the specified named element is a child
of the main package and not in any ignored package.

@param aNamedElement A UML named element
/]
[query public e_isInAllowedPackage(
		aNamedElement : uml::NamedElement) : Boolean =
	if aNamedElement = aNamedElement = null
	then false
	else
		if aNamedElement.getModel()
				.e_mainPackage()
				.eAllContents(uml::NamedElement)
				->includes(aNamedElement)
			and aNamedElement.e_isNotInIgnoredPackage()
		then true
		else false
		endif
	endif
/]

[**
Returns true if the specified package is the main package or
a child of the main package and not an ignored package.

@param aPackage A UML package
/]
[query public e_isAllowedPackage(aPackage : uml::Package) : Boolean =
	if aPackage = aPackage.getModel().e_mainPackage()
	then true
	else
		if aPackage.getModel()
				.e_mainPackage()
				.eAllContents(uml::Package)
				->includes(aPackage)
			and aPackage.e_isNotIgnoredPackage()
		then true
		else false
		endif
	endif
/]

[**
Returns true if the specified package is not an ignored package.
Ignored packages are specified by the property IGNORE_PACKAGE.

@param aPackage A UML package
/]
[query public e_isNotIgnoredPackage(aPackage : uml::Package) : Boolean =
	'IGNORE_PACKAGE'.getPropertyValue()
		.substituteAll(' ', '')
		.tokenize(',')
		->collect(p | aPackage.getModel().e_namedElementObject(p))
		->excludes(aPackage)
/]

[**
Returns true if the specified named element is not contained
in any ignored package.
Ignored packages are specified by the property IGNORE_PACKAGE.

@param aNamedElement A UML named element
/]
[query public e_isNotInIgnoredPackage(
		aNamedElement : uml::NamedElement) : Boolean =
	OrderedSet{
		'IGNORE_PACKAGE'.getPropertyValue()
			.substituteAll(' ', '')
			.tokenize(',')
			->collect(nas |
				aNamedElement.getModel().e_namedElementObject(nas))
			->includes(aNamedElement)
	}->excludes(true)
/]

[**
Returns a sequence of all classes in the model, sorted by class name.

@param aModel A UML model
/]
[query public e_allClasses(aModel : uml::Model) : Sequence(uml::Class) =
	aModel.eAllContents(uml::Class)->sortedBy(c | c.name)
/]

[**
Returns a sequence of all data types in the model,
sorted by data type name.

@param aModel A UML model
/]
[query public e_allDataTypes(
		aModel : uml::Model) : Sequence(uml::DataType) =
	aModel.eAllContents(uml::DataType)->sortedBy(d | d.name)
/]

