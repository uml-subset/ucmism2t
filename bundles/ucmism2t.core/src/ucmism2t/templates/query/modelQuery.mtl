[**
Returns a sequence of packages directly contained in a package.

@param aPackage A UML package
/]
[query public e_childrenPackages(
		aPackage : uml::Package) : Sequence(uml::Package) =
	aPackage.eContents(uml::Package)
/]

[**
Returns a sequence of packages that directly contain at least one class,
sorted by package name.

@param aModel A UML model
/]
[query public e_packagesWithClasses(
		aModel : uml::Model) : Sequence(uml::Package) =
	aModel.eAllContents(uml::Package)
		->select(p | p.eContents(uml::Class)->notEmpty())
		->sortedBy(p | p.name)
/]

[**
Returns the path of the specified element below the model root,
using "/" as the separator between path segments.

@param aNamedElement A UML named element
/]
[query public e_path(aNamedElement : uml::NamedElement) : String =
	aNamedElement.qualifiedName
		.replace(aNamedElement.getModel().name.concat('::'), '')
		.replaceAll('::', '/')
/]

[**
Returns a shortened relative path of the specified element,
using the first character of each intermediate segment.
Note: Under test.

@param aNamedElement A UML named element
/]
[query public e_relativePath(
		aNamedElement : uml::NamedElement) : String =
	aNamedElement.qualifiedName
		.replace(aNamedElement.getModel().name.concat('::'), '')
		.replaceAll('::', '/')
		.replaceAll('(\\w)\\w+\\/', '\\1')
		.replace(aNamedElement.name, '')
/]

[**
Returns the output file path for the specified element and target format.
For the "doc" target the model name is replaced with "_rst".

@param aNamedElement A UML named element
@param target The generation target format identifier (e.g. "xsd", "doc")
/]
[query public e_filePath(
		aNamedElement : uml::NamedElement,
		target : String) : String =
	if target = 'doc'
	then
		aNamedElement.getModel().e_modelShortName()
			.concat('/')
			.concat(target)
			.concat('/')
			.concat(
				aNamedElement.qualifiedName
					.replaceAll('::', '/')
					.replace(aNamedElement.getModel().name, '_rst'))
	else
		aNamedElement.getModel().e_modelShortName()
			.concat('/')
			.concat(target)
			.concat('/')
			.concat(aNamedElement.qualifiedName.replaceAll('::', '/'))
	endif
/]

[**
Returns a sequence of classes that have no superclass (or only
DDI-CDI base classes as superclass) and have at least one subclass.
These are the top-level classes in the inheritance hierarchy.
Note: TODO: Remove hardcoded Identifiable and AnnotatedIdentifiable.

@param aPackage A UML package
/]
[query public e_topSuperClasses(
		aPackage : uml::Package) : Sequence(uml::Class) =
	aPackage.eAllContents(uml::Class)
		->select(temp20 |
			temp20.superClass->isEmpty()
			or temp20.superClass->asSequence()
				->collect(temp18 | temp18.name)
				->toString() = 'Identifiable'
			or temp20.superClass->asSequence()
				->collect(temp19 | temp19.name)
				->toString() = 'AnnotatedIdentifiable')
		->select(temp21 | temp21.eInverse(uml::Class)->notEmpty())
		->sortedBy(temp22 | temp22.name)
/]

[**
Returns a sequence of inherited attributes of a classifier,
sorted by attribute name. Excludes association-end properties.
Note: Intended for use with classes and data types.

@param aClassifier A UML classifier
/]
[query public u_inheritedAttributes(
		aClassifier : uml::Classifier) : Sequence(uml::Property) =
	aClassifier.inheritedMember
		->collect(p | p.oclAsType(uml::Property))
		->select(p2 | p2.association = null)
		->sortedBy(p3 | p3.name)
/]

[**
Returns a sequence of inherited associations of a class.
Note: TODO: probably not complete, both directions?, non-inherited assoc?

@param aClass A UML class
/]
[query public e_inheritedAssociations(
		aClass : uml::Class) : Sequence(uml::Association) =
	aClass.inheritedMember
		->collect(p | p.oclAsType(uml::Property))
		->select(p2 | p2.association <> null)
		->collect(p3 | p3.association)
/]

[**
Returns a string with the multiplicity of a property
in the format "lower..upper", with -1 replaced by "*".

@param aProperty A UML property
/]
[query public e_multiplicity(aProperty : uml::Property) : String =
	aProperty.lower.toString()
		.concat('..')
		.concat(aProperty.upper.toString())
		.replaceAll('-1', '*')
/]

[comment]
[query public A3e_allSuperclasses(
		aClass : uml::Class) : Sequence(uml::Class) =
	if aClass.superClass->notEmpty()
	then
		aClass.superClass->asSequence()
			->union(aClass.superClass->asSequence()
				->first().u_allSuperClasses())
	else Sequence{}
	endif
/]
[/comment]

[**
