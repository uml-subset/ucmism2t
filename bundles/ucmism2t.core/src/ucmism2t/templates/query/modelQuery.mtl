[**
Returns an ordered set of direct subclasses or sub data types
of a classifier, sorted by classifier name.
Note: Intended for use with classes and data types.
Not tested with other classifier types.

@param aClassifier A UML classifier
/]
[query public e_subClassesOrSubDataTypes(
		aClassifier : uml::Classifier) : OrderedSet(uml::Classifier) =
	if aClassifier.oclIsTypeOf(uml::Class)
	then
		aClassifier.eInverse(uml::Class)
			->asOrderedSet()
			->sortedBy(temp32 | temp32.name)
	else
		if aClassifier.oclIsKindOf(uml::DataType)
		then
			aClassifier.eInverse(uml::DataType)
				->asOrderedSet()
				->sortedBy(temp33 | temp33.name)
		else OrderedSet{}
		endif
	endif
/]

[**
Returns a sequence of direct sub classifiers of a classifier
via the generalization relationship, sorted by classifier name.

@param aClassifier A UML classifier
/]
[query public e_subClassesOrSubDataTypes2(
		aClassifier : uml::Classifier) : Sequence(uml::Classifier) =
	aClassifier.eInverse(uml::Generalization)
		->select(temp34 | temp34.specific <> aClassifier)
		->asSequence()
		->collect(temp35 | temp35.specific.oclAsType(uml::Classifier))
		->sortedBy(temp36 | temp36.name)
/]

[**
Returns the simple type name of a UML type.
This is a workaround for UML primitive type names, which are not
directly accessible as a name property on the type object.

@param aType A UML type
/]
[query public e_typeName(aType : uml::Type) : String =
	if OrderedSet{aType.name}->size() > 0
	then aType.name
	else
		aType.toString()
			.substring(aType.toString().index('#') + 1)
			.substitute(')', '')
	endif
/]

[**
Returns the qualified type name of a UML type.
This is a workaround for UML primitive type names.

@param aType A UML type
/]
[query public e_typeQualifiedName(aType : uml::Type) : String =
	if OrderedSet{aType.name}->size() > 0
	then aType.qualifiedName
	else
		aType.toString()
			.substring(aType.toString().index('#') + 1)
			.substitute(')', '')
	endif
/]

[comment]
Could be a query since queries get cached.
[/comment]
