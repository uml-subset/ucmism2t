[**
Returns the definition text extracted from the first owned comment
of a named element. Strips section headings (Definition, Examples,
Explanatory notes), normalises whitespace, and escapes curly braces.
Truncates to 300 characters if longer.

@param aNamedElement A UML named element
/]
[template public e_onlyDefinition(
		aNamedElement : uml::NamedElement) post(self.trim())]
  [if (aNamedElement.ownedComment->size() > 0)]
    [let s : String =
        aNamedElement.ownedComment
          ->asSequence()->first().body
          .trim()
          .replace('Explanatory notes[\\s\\S\\"=]+', '')
          .replace('Examples[\\s\\S\\"=]+', '')
          .replace('Definition[\\s\\S]+?[\\"=]+\\s+', '')
          .replaceAll('[\\s\\n\\r]+', ' ')
          .replaceAll('\\{', '<U+007B>')
          .replaceAll('\\}', '<U+007D>')]
      [if (s.size() > 300)]
        [s.first(300).trim()/] ...
      [else]
        [s.trim()/]
      [/if]
    [/let]
  [/if]
[/template]

[**
Returns the body text of all owned comments of a named element,
concatenated. Returns an empty string if there are no comments.

@param aNamedElement A UML named element
/]
[template public e_fixClassDocumentation(
		aNamedElement : uml::NamedElement) post(self.trim())]
  [aNamedElement.ownedComment
    ->asSequence()
    ->collect(temp75 | temp75.body)
    ->collect(temp76 | temp76.toString())/]
[/template]

