[**
Returns a string consisting of n repetitions of char.

@param char The character or string to repeat
@param n The number of repetitions
/]
[query public u_repeatChar(char : String, n : Integer) : String =
	if n <= 0
	then ''
	else char + char.u_repeatChar(n - 1)
	endif
/]

[**
Returns the cardinality of a property in ShEx syntax:
"?" for 0..1, "*" for 0..*, "+" for 1..*, "" for all other cases.
Note: upperBound() returns '*' for unlimited multiplicity as per
canonical XMI serialization used by Eclipse UML2.
---
AQL operations used:
  aProperty.lowerBound()   - Java method on uml::Property: returns the
                             lower bound of the multiplicity as Integer.
                             Not an EStructuralFeature; called with
                             explicit parentheses in AQL.
  aProperty.upperBound()   - Java method on uml::Property: returns the
                             upper bound of the multiplicity. Returns '*'
                             for unlimited multiplicity as per canonical
                             XMI. Not an EStructuralFeature; called with
                             explicit parentheses in AQL.

@param aProperty - A UML property whose multiplicity is to be
                   expressed as a ShEx cardinality string.
/]
[query public u_shexCardinality(aProperty : uml::Property) : String =
  if aProperty.lowerBound() = 0 and aProperty.upperBound() = 1 then
    '?'
  else if aProperty.lowerBound() = 0 and aProperty.upperBound() = '*' then
    '*'
  else if aProperty.lowerBound() = 1 and aProperty.upperBound() = '*' then
    '+'
  else
    ''
  endif
  endif
  endif
/]

[**
Returns the cardinality of a property in ShEx syntax:
"?" for 0..1, "*" for 0..*, "+" for 1..*, "" for all other cases.

@param aProperty A UML property
/]
[query public OKu_shexCardinality(
		aProperty : uml::Property) : String =
	if (aProperty.lowerBound() == 0
			and aProperty.upperBound() == 1) then '?'
	else if (aProperty.lowerBound() == 0
			and aProperty.upperBound() == '*') then '*'
	else if (aProperty.lowerBound() == 1
			and aProperty.upperBound() == '*') then '+'
	else ''
	endif
	endif
	endif
/]

[**
Returns an ordered set of direct subclasses of a class,
sorted by class name.
---
AQL operations used:
  eInverse(uml::Generalization)    - Finds all Generalization elements that
                                     cross-reference aClass; requires all
                                     resources to be loaded in the same
                                     resource set. Returns both generalizations
                                     where aClass is the general end AND where
                                     aClass is the specific end — hence the
                                     guard below is mandatory.
  ->select(g1 | g1.general=aClass) - Retains only Generalization elements where
                                     aClass is the general (parent) end,
	                                   excluding generalizations where aClass is
	                                   the specific (child) end. Without this
	                                   guard, aClass itself leaks into the result
	                                   via .specific on its own superclass
	                                   relationships.
  ->collect(g2 | g3.specific)      - Retrieves the specific (child) classifier
                                     of each qualifying Generalization element.
  ->filter(uml::Class)             - Retains only uml::Class instances,
                                   	 excluding non-Class specializations and
                                     dropping null values safely.
  ->sortedBy(c | c.name)           - Sorts result alphabetically by class name.

@param aClass - A UML class whose direct subclasses
                are to be retrieved.
/]
[query public u_subClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.eInverse(uml::Generalization)
    ->select(g1 | g1.general = aClass)
    ->collect(g2 | g2.specific)
    ->filter(uml::Class)
    ->sortedBy(c | c.name)
/]
[**
Returns an ordered set of direct subclasses of a class,
sorted by class name.

@param aClass A UML class
/]
[query public OKasses(
		aClass : uml::Class) : OrderedSet(uml::Class) =
	aClass
		.eInverse(uml::Generalization)
		.specific
		->select(cl | cl.oclIsTypeOf(uml::Class))
		->select(c | c <> aClass)
		->sortedBy(c | c.name)
/]

[**
Returns an ordered set of all subclasses of a class,
traversing the full specialization hierarchy down to the leaves.
Supports both single and multiple inheritance. Cycle-safe.
---
AQL operations used:
  ->closure(c1 | expr)     - Applied to aClass itself as seed; the lambda
                             c1.u_subClasses() is evaluated starting from
                             aClass, so direct subclasses are included from
                             the first step. Traverses transitively until no
                             new elements are found. Cycle-safe: each element
                             is visited at most once.
  ->sortedBy(c2 | c2.name) - Sorts the full result alphabetically by class
                             name.

@param aClass - A UML class whose full subclass hierarchy
                is to be retrieved.
/]
[query public u_allSubClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass->closure(c1 | c1.u_subClasses())
    ->sortedBy(c2 | c2.name)
/]

[**
Returns an ordered set of all subclasses of a class,
recursively, sorted by class name.

@param aClass A UML class
/]
[query public OKu_allSubClasses(
		aClass : uml::Class) : OrderedSet(uml::Class) =
	let directSubClasses : OrderedSet(uml::Class) =
		aClass.u_subClasses()
	in
	if (directSubClasses->isEmpty()) then
		OrderedSet{}
	else
		directSubClasses
			->union(
				directSubClasses->collect(c | c.OKu_allSubClasses())
			)
			->sortedBy(c | c.name)
	endif
/]

[**
Returns an ordered set of direct sub datatypes of a datatype,
sorted by datatype name.
---
AQL operations used:
  eInverse(uml::Generalization) - Finds all Generalization elements that
                                  cross-reference aDataType; requires all
																	resources to be loaded in the same
																	resource set. Returns both generalizations
																	where aDataType is the general end AND
																	where aDataType is the specific end —
																	hence the guard below is mandatory.
  ->select(g1 | g1.general      - Retains only Generalization elements where
              = aDataType)        aDataType is the general (parent) end,
                                  excluding generalizations where aDataType
                                  is the specific (child) end. Without this
                                  guard, aDataType itself leaks into the
                                  result via .specific on its own supertype
                                  relationships.
  ->collect(g2 | g2.specific)   - Retrieves the specific (child) classifier
                                  of each qualifying Generalization element.
  ->filter(uml::DataType)       - Retains only uml::DataType instances,
                                  excluding non-DataType specializations and
                                  dropping null values safely.
  ->sortedBy(c | c.name)        - Sorts result alphabetically by datatype
                                  name.

@param aDataType - A UML datatype whose direct sub datatypes
                   are to be retrieved.
/]
[query public u_subDataTypes(aDataType : uml::DataType) : OrderedSet(uml::DataType) =
  aDataType.eInverse(uml::Generalization)
	  ->select(g1 | g1.general = aDataType)
	  ->collect(g2 | g2.specific)
	  ->filter(uml::DataType)
	  ->sortedBy(c | c.name)
/]

[**
Returns an ordered set of direct sub data types of a data type,
sorted by data type name.

@param aDataType A UML data type
/]
[query public OKu_subDataTypes(
	aDataType : uml::DataType) : OrderedSet(uml::DataType) =
		aDataType
			.eInverse(uml::Generalization)
			.specific
			->select(cl | cl.oclIsKindOf(uml::DataType))
			->select(d | d <> aDataType)
			->sortedBy(d2 | d2.name)
/]

[**
Returns an ordered set of all sub datatypes of a datatype,
traversing the full specialization hierarchy down to the leaves.
Supports both single and multiple inheritance. Cycle-safe.
---
AQL operations used:
  ->closure(c | expr)    - Applied to aDataType itself as seed; the lambda
                           c.u_subDataTypes() is evaluated starting from
                           aDataType, so direct sub datatypes are included
                           from the first step. Traverses transitively until
                           no new elements are found. Cycle-safe: each element
                           is visited at most once. Returns
                           OrderedSet(uml::DataType) — no cast required.
  ->sortedBy(c | c.name) - Sorts the full result alphabetically by datatype
                           name.

@param aDataType - A UML datatype whose full sub datatype hierarchy
                   is to be retrieved.
/]
[query public u_allSubDataTypes(aDataType : uml::DataType) : OrderedSet(uml::DataType) =
  aDataType->closure(c | c.u_subDataTypes())
  	->sortedBy(c | c.name)
/]

[**
Returns an ordered set of all sub data types of a data type,
recursively, sorted by data type name.

@param aDataType A UML data type
/]
[query public OKu_allSubDataTypes(
	aDataType : uml::DataType) : OrderedSet(uml::DataType) =
		let directSubDataTypes : OrderedSet(uml::DataType) =
			aDataType.u_subDataTypes()
		in
		if (directSubDataTypes->isEmpty()) then
			OrderedSet{}
		else
			directSubDataTypes
				->union(
					directSubDataTypes->collect(d | d.OKu_allSubDataTypes())
				)
				->sortedBy(d2 | d2.name)
		endif
/]

[**
Returns an ordered set of all superclasses of a class,
traversing the full generalization hierarchy up to the root.
Supports both single and multiple inheritance. Cycle-safe.
---
AQL operations used:
  ->closure(c | expr)    - Applied to aClass itself as seed; the lambda
                           c.general->filter(uml::Class) is evaluated
                           starting from aClass, so the direct parent is
                           included from the first step. Traverses
                           transitively until no new elements are found.
                           Cycle-safe: each element is visited at most once.

@param aClass - A UML class whose full superclass hierarchy
                is to be retrieved.
/]
[query public u_allSuperClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass->closure(c | c.general->filter(uml::Class))
/]

[**
Returns an ordered set of all super datatypes of a datatype,
traversing the full generalization hierarchy up to the root.
Supports both single and multiple inheritance. Cycle-safe.
---
AQL operations used:
  ->closure(c | expr)    - Applied to aDataType itself as seed; the lambda
                           c.general->filter(uml::DataType) is evaluated
                           starting from aDataType, so the direct parent is
                           included from the first step. Traverses
                           transitively until no new elements are found.
                           Cycle-safe: each element is visited at most once.

@param aDataType - A UML datatype whose full supertype hierarchy
                   is to be retrieved.
/]
[query public u_allSuperDataTypes(aDataType : uml::DataType) : OrderedSet(uml::DataType) =
  aDataType->closure(c | c.general->filter(uml::DataType))
/]

[**
Returns an ordered set of all super classifiers of a classifier,
traversing the full generalization hierarchy up to the root.
Supports both single and multiple inheritance. Cycle-safe.
Covers all classifier subtypes including uml::Class, uml::DataType,
uml::Interface, uml::Signal, uml::Component, etc.
---
AQL operations used:
  ->closure(c | expr)    - Applied to aClassifier itself as seed; the lambda
                           c.general is evaluated starting from aClassifier,
                           so the direct parent is included from the first
                           step. Traverses transitively until no new elements
                           are found. Cycle-safe: each element is visited at
                           most once.

@param aClassifier - A UML classifier whose full generalization
                     hierarchy is to be retrieved.
/]
[query public u_allSuperClassifiers(aClassifier : uml::Classifier) : OrderedSet(uml::Classifier) =
  aClassifier->closure(c | c.general)
/]

[**
Returns an ordered set of all superclasses of a class,
starting at the direct parent up to the root.
Note: Works only for single inheritance.

@param aClass - A UML class whose superclass hierarchy
                is to be retrieved.
/]
[query public OKu_allSuperClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  let superTypes : OrderedSet(uml::Class) =
  	aClass.general->filter(uml::Class)->asOrderedSet()
  	in
    if superTypes->notEmpty() then
      let superType : uml::Class = superTypes->first()
      in
      superType->asOrderedSet()
        ->union(superType.OKu_allSuperClasses())
    else
      OrderedSet{}
    endif
/]

[**
Returns an ordered set of all super datatypes of a datatype,
starting at the direct parent up to the root.
Note: Works only for single inheritance.

@param aDataType - A UML datatype whose supertype hierarchy
                   is to be retrieved.
/]
[query public OKu_allSuperDataTypes(aDataType : uml::DataType) : OrderedSet(uml::DataType) =
  let superTypes : OrderedSet(uml::DataType) =
  	aDataType.general->filter(uml::DataType)->asOrderedSet()
  	in
    if superTypes->notEmpty() then
      let superType : uml::DataType = superTypes->first()
      in
      superType->asOrderedSet()
        ->union(superType.OKu_allSuperDataTypes())
    else
      OrderedSet{}
    endif
/]

[**
Returns a sequence of all super classifiers of a classifier,
starting at the direct parent.
Note: Works only with classes and data types.

@param aClassifier A UML classifier
/]
[query public OKu_allSuperClassifiers(
		aClassifier : uml::Classifier) : Sequence(uml::Classifier) =
	let superClassifier : uml::Classifier =
		aClassifier.general->first()
	in
	if (superClassifier = null
			or not (superClassifier.oclIsTypeOf(uml::Class)
				or superClassifier.oclIsKindOf(uml::DataType)))
	then
		Sequence{}
	else
		superClassifier
			->asSequence()
			->union(superClassifier.OKu_allSuperClassifiers())
	endif
/]

[**
Returns all classes that are sources of incoming binary directed
associations pointing to the specified class. Alphabetically sorted,
deduplicated set of classes that have an outgoing association
pointing to this class. Uses eInverse() to
find all uml::Property elements whose type reference points to aClass,
then resolves the source class via getOtherEnd().type on the
association end that is owned by the source class (ownedAttribute).
Self-associations are excluded from the result.
---
AQL operations used:
  eInverse(uml::Property)    - Finds all Property instances whose type
                               EReference cross-references aClass; requires
                               all resources to be loaded in the same
                               resource set.
  ->select(p1 | cond)        - Keeps only association ends owned by a
                               class (not by the association itself).
  p1.association             - EReference: the owning Association element;
                               null if not an association end.
  eContainingFeature()       - Returns the EReference via which p is
                               contained; .name = 'ownedAttribute' confirms
                               the property is source-class-owned, not
                               owned by the Association (ownedEnd).
  ->collect(p2 | expr)       - Transforms each qualifying property.
  p2.getOtherEnd()           - Java method on uml::Property: returns the
                               opposite end of a binary association.
                               Not an EStructuralFeature; must be called
                               with explicit parentheses in AQL.
  .type                      - EReference: the classifier typing the other
                               end (i.e., the source class); typed as
                               uml::Type, narrowed by filter below.
  ->filter(uml::Class)       - Retains only uml::Class instances;
                               also drops null values safely.
  ->reject(c1 | c1 = aClass) - Excludes self-associations.
  ->asOrderedSet()           - Deduplicates the result collection.
  ->sortedBy(c2 | c2.name)   - Sorts alphabetically by class name.

@param aClass - The target class whose incoming association sources are to be retrieved.
/]
[query public OKu_incomingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.eInverse(uml::Property)
    ->select(p1 | p1.association <> null
           and p1.eContainingFeature().name = 'ownedAttribute')
    ->collect(p2 | p2.getOtherEnd().type)
    ->filter(uml::Class)
    ->reject(c1 | c1 = aClass)
    ->asOrderedSet()
    ->sortedBy(c2 | c2.name)
/]

[**
Returns an ordered set of all classes that are sources of incoming
binary directed associations pointing to the specified class. Uses
eInverse() to find all uml::Property elements whose type cross-
references aClass, then resolves the source class via getOtherEnd().
Only source-class-owned ends (ownedAttribute) are considered.
Self-associations are excluded.
---
AQL operations used:
  eInverse(uml::Property)        - Finds all Property instances whose type
                                   EReference cross-references aClass; requires
                                   all resources to be loaded in the same
                                   resource set.
  ->select(p1 | cond)            - Keeps only source-class-owned association
                                   ends pointing to aClass, excluding those
                                   owned by aClass (self-associations).
  p1.association                 - EReference: the owning Association element;
                                   null if not an association end.
  eContainingFeature().name      - Returns the name of the EReference via
                                   which p is contained; 'ownedAttribute'
                                   confirms the property is source-class-owned,
                                   not owned by the Association itself (ownedEnd).
  p1.eContainer() <> aClass      - Excludes self-associations: a self-association
                                   is exactly the case where the source-owned end
                                   is contained by aClass itself.
  ->collect(p2 | expr)           - Transforms each qualifying property.
  p2.getOtherEnd()               - Java method on uml::Property: returns the
                                   opposite end of a binary association.
                                   Not an EStructuralFeature; must be called
                                   with explicit parentheses in AQL.
  .type                          - EReference: the classifier typing the other
                                   end (uml::Type); narrowed by filter below.
  ->filter(uml::Class)           - Retains only uml::Class instances;
                                   also drops null values safely.
  ->asOrderedSet()               - Deduplicates the result collection.
  ->sortedBy(p3 | p3.name)       - Sorts result alphabetically by class name.

@param aClass - The target class whose incoming association source
                classes are to be retrieved.
/]
[query public u_incomingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
    aClass.eInverse(uml::Property)
        ->select(p1 | p1.association <> null
               and p1.eContainingFeature().name = 'ownedAttribute'
               and p1.eContainer() <> aClass)
        ->collect(p2 | p2.getOtherEnd().type)
        ->filter(uml::Class)
        ->asOrderedSet()
        ->sortedBy(p3 | p3.name)
/]

[**
Returns all classes that are targets of outgoing binary directed
associations from the specified class. Alphabetically sorted, deduplicated
set of classes reachable via outgoing associations. Navigates via ownedAttribute
ends that belong to a uml::Association, collecting their target types.
Self-associations (where the class is associated with itself) are
excluded from the result.
---
AQL operations used:
  ownedAttribute             - EReference: properties structurally owned
                               by this class (uml::Property).
  ->select(p | cond)         - Keeps only elements satisfying the condition.
  p.association              - EReference: the Association this property
                               is a member end of; null if plain attribute.
  ->collect(p | expr)        - Transforms each element to the given expression.
  p.type                     - EReference: the classifier typing this property
                               (uml::Type); narrowed to uml::Class by filter.
  ->filter(uml::Class)       - Retains only instances of uml::Class;
                               also drops null values safely.
  ->reject(c1 | c1 = aClass) - Excludes self-associations.
  ->asOrderedSet()           - Deduplicates the result collection.
  ->sortedBy(c2 | c2.name)   - Sorts alphabetically by class name.

@param aClass - The source class whose outgoing association targets are to be retrieved.
/]
[query public u_outgoingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.ownedAttribute
    ->select(p1 | p1.association <> null)
    ->collect(p2 | p2.type)
    ->filter(uml::Class)
    ->reject(c1 | c1 = aClass)
    ->asOrderedSet()
    ->sortedBy(c2 | c2.name)
/]

[**
Returns all classes associated with the specified class, combining
both outgoing and incoming binary directed associations. Delegates
to u_incomingAssociatedClasses() and u_outgoingAssociatedClasses(),
merges the results, deduplicates, and sorts alphabetically by name.
Self-associations are excluded.

@param self - The class for which all associated classes (both
              source and target ends of binary directed associations)
              are to be retrieved.
/]
[query public u_associatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.u_incomingAssociatedClasses()
  	->union(aClass.u_outgoingAssociatedClasses())
    ->asOrderedSet()
    ->sortedBy(c | c.name)
/]

[**
Returns an ordered set of all classes that reference the specified
class as a target via incoming binary directed associations, including
associations inherited from its superclass hierarchy. Combines the
class itself with all its superclasses, then collects incoming
association sources across the full hierarchy, deduplicating the
result.
---
AQL operations used:
  u_allSuperClasses()            - Query: returns the ordered superclass
                                   hierarchy of aClass.
  ->including(aClass)            - Adds aClass itself to the collection
                                   so its own associations are included.
  ->collect(c1 | expr)           - Collects incoming associated classes
                                   for each class in the hierarchy.
  u_incomingAssociatedClasses()  - Query: returns direct incoming
                                   association sources of a single class.
  ->asOrderedSet()               - Deduplicates; a class may be reachable
                                   via associations at multiple levels.
  ->sortedBy(c2 | c2.name)       - Sorts result alphabetically by name.

@param aClass - A UML class whose full effective incoming association
                sources (own and inherited) are to be retrieved.
/]
[query public u_allEffectiveIncomingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.u_allSuperClasses()
    ->including(aClass)
    ->collect(c1 | c1.u_incomingAssociatedClasses())
    ->asOrderedSet()
    ->sortedBy(c2 | c2.name)
/]

[**
Returns an ordered set of all classes reachable via outgoing binary
directed associations from the specified class, including associations
inherited from its superclass hierarchy. Combines the class itself
with all its superclasses, then collects outgoing association targets
across the full hierarchy, deduplicating the result.
---
AQL operations used:
  u_allSuperClasses()            - Query: returns the ordered superclass
                                   hierarchy of aClass.
  ->including(aClass)            - Adds aClass itself to the collection
                                   so its own associations are included.
  ->collect(c1 | expr)           - Collects outgoing associated classes
                                   for each class in the hierarchy.
  getOutgoingAssociatedClasses() - Query: returns direct outgoing
                                   association targets of a single class.
  ->asOrderedSet()               - Deduplicates; a class may be reachable
                                   via associations at multiple levels.
  ->sortedBy(c2 | c2.name)       - Sorts result alphabetically by name.

@param aClass - A UML class whose full effective outgoing association
                targets (own and inherited) are to be retrieved.
/]
[query public u_allEffectiveOutgoingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.u_allSuperClasses()
    ->including(aClass)
    ->collect(c1 | c1.u_outgoingAssociatedClasses())
    ->asOrderedSet()
    ->sortedBy(c2 | c2.name)
/]

[**
Returns an ordered set of all classes reachable via any binary directed
association from or to the specified class, including associations
inherited from its superclass hierarchy. Combines the results of
u_allEffectiveOutgoingAssociatedClasses() and
u_allEffectiveIncomingAssociatedClasses(), deduplicating the result.
---
AQL operations used:
  u_allEffectiveOutgoingAssociatedClasses() - Query: returns all classes
                                              reachable via outgoing
                                              associations across the
                                              full superclass hierarchy.
  u_allEffectiveIncomingAssociatedClasses() - Query: returns all classes
                                              referencing aClass via
                                              incoming associations
                                              across the full superclass
                                              hierarchy.
  ->union(col)                              - Merges both collections,
                                              deduplicating the result
                                              as an OrderedSet.
  ->sortedBy(c | c.name)                    - Sorts result alphabetically
                                              by name.

@param aClass - A UML class whose full effective associated classes
                (both incoming and outgoing, own and inherited) are
                to be retrieved.
/]
[query public u_allEffectiveAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.u_allEffectiveOutgoingAssociatedClasses()
    ->union(aClass.u_allEffectiveIncomingAssociatedClasses())
    ->sortedBy(c | c.name)
/]

[**
Returns an ordered set of all indirect superclasses of a class,
i.e. the full superclass hierarchy excluding the direct parent.
Delegates to u_allSuperClasses() and removes the direct parent.
Note: Works only for single inheritance.

@param aClass - A UML class whose indirect superclass hierarchy
                (excluding direct parent) is to be retrieved.
/]
[query public u_allIndirectSuperClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
    let superTypes : OrderedSet(uml::Class) =
        aClass.u_allSuperClasses()
    in
    if superTypes->notEmpty() then
        superTypes->excluding(aClass.superClass->first())
    else
        OrderedSet{}
    endif
/]

[**
Returns an ordered set of all incoming binary directed associations
of the specified class, i.e. associations where another class owns
the source end via ownedAttribute and this class is the target type.
The Association elements themselves are returned, not the source classes.
Self-associations are excluded.
---
AQL operations used:
  eInverse(uml::Property)        - Finds all Property instances whose type
                                   EReference cross-references aClass;
                                   requires all resources to be loaded in
                                   the same resource set.
  ->select(p1 | cond)            - Keeps only source-class-owned association
                                   ends pointing to aClass, excluding those
                                   owned by aClass itself (self-associations).
  p1.association                 - EReference: the owning Association element;
                                   null if not an association end.
  eContainingFeature().name      - Returns the name of the EReference via
                                   which p is contained; 'ownedAttribute'
                                   confirms the property is source-class-owned,
                                   not owned by the Association itself (ownedEnd).
  p1.eContainer() <> aClass      - Excludes self-associations: a self-association
                                   is exactly the case where the source-owned end
                                   is contained by aClass itself.
  ->collect(p2 | expr)           - Extracts the Association element from each
                                   qualifying property.
  ->filter(uml::Association)     - Retains only Association instances; also
                                   drops any null values safely.
  ->asOrderedSet()               - Deduplicates the result collection.
  ->sortedBy(a | a.name)         - Sorts result alphabetically by association
                                   name.

@param aClass - The target class whose incoming associations
                are to be retrieved.
/]
[query public u_incomingAssociations(aClass : uml::Class) : OrderedSet(uml::Association) =
    aClass.eInverse(uml::Property)
        ->select(p1 | p1.association <> null
               and p1.eContainingFeature().name = 'ownedAttribute'
               and p1.eContainer() <> aClass)
        ->collect(p2 | p2.association)
        ->filter(uml::Association)
        ->asOrderedSet()
        ->sortedBy(a | a.name)
/]

[**
Returns an ordered set of all outgoing binary directed associations
of the specified class, i.e. associations where this class owns the
source end via ownedAttribute. The Association elements themselves
are returned, not the target classes.
---
AQL operations used:
  ownedAttribute             - EReference: properties structurally owned
                               by this class (uml::Property).
  ->select(p1 | cond)        - Keeps only properties that are source ends
                               of an association.
  p1.association             - EReference: the Association this property
                               is a member end of; null if plain attribute.
  ->collect(p2 | expr)       - Extracts the Association element from each
                               qualifying property.
  ->filter(uml::Association) - Retains only Association instances; also
                               drops any null values safely.
  ->asOrderedSet()           - Deduplicates the result collection.
  ->sortedBy(a | a.name)     - Sorts result alphabetically by association
                               name.

@param aClass - The source class whose outgoing associations
                are to be retrieved.
/]
[query public u_outgoingAssociations(aClass : uml::Class) : OrderedSet(uml::Association) =
    aClass.ownedAttribute
        ->select(p1 | p1.association <> null)
        ->collect(p2 | p2.association)
        ->filter(uml::Association)
        ->asOrderedSet()
        ->sortedBy(a | a.name)
/]

[**
Returns an ordered set of all associations of the specified class,
combining both outgoing and incoming binary directed associations.
Delegates to getOutgoingAssociations() and getIncomingAssociations(),
merges the results, deduplicates, and sorts alphabetically by name.
Self-associations are excluded.
---
AQL operations used:
  getOutgoingAssociations()  - Query: returns associations where aClass
                               owns the source end via ownedAttribute.
  getIncomingAssociations()  - Query: returns associations where aClass
                               is the target type of the source end.
  ->union(col)               - Merges both collections into one;
                               returns OrderedSet matching return type.
  ->asOrderedSet()           - Deduplicates; an association could
                               theoretically appear in both directions
                               in a non-strict model.
  ->sortedBy(a | a.name)     - Sorts final result alphabetically by
                               association name.

@param aClass - The class whose outgoing and incoming associations
                are to be retrieved.
/]
[query public u_associations(aClass : uml::Class) : OrderedSet(uml::Association) =
    aClass.u_outgoingAssociations()
        ->union(aClass.u_incomingAssociations())
        ->asOrderedSet()
        ->sortedBy(a | a.name)
/]

[**
Returns an ordered set of all classes that are abstraction clients of
the specified class. Navigates the model's cross-references to find
all uml::Abstraction relationships that list aClass as a supplier,
then returns their client elements filtered to uml::Class instances.
---
AQL operations used:
  aClass.eInverse(uml::Abstraction) - Navigates cross-references to
                                      return all uml::Abstraction
                                      instances that reference aClass
                                      (i.e. where aClass appears as a
                                      supplier). eInverse() is an AQL
                                      operation on EObject that returns
                                      all objects holding a reference
                                      to the receiver, optionally
                                      filtered by type.
  ->collect(a | a.client)           - For each Abstraction, collects
                                      its client NamedElements (the
                                      depending side of the
                                      relationship).
  ->filter(uml::Class)              - Retains only uml::Class instances,
                                      excluding other NamedElement
                                      subtypes (e.g. Interfaces).
  ->asOrderedSet()                  - Deduplicates; a class may appear
                                      as client in multiple
                                      Abstraction relationships.
  ->sortedBy(c | c.name)            - Sorts result alphabetically by
                                      name.

@param aClass - A UML class whose abstraction clients are to be
                retrieved.
/]
[query public u_abstractionClients(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.eInverse(uml::Abstraction)
    ->collect(a | a.client)
    ->filter(uml::Class)
    ->asOrderedSet()
    ->sortedBy(c | c.name)
/]

[**
Returns an ordered set of all classes that are abstraction suppliers
of the specified class. Navigates the model's cross-references to find
all uml::Abstraction relationships that list aClass as a client, then
returns their supplier elements filtered to uml::Class instances.
---
AQL operations used:
  aClass.eInverse(uml::Abstraction) - Navigates cross-references to
                                      return all uml::Abstraction
                                      instances that reference aClass
                                      (i.e. where aClass appears as a
                                      client). eInverse() is an AQL
                                      operation on EObject that returns
                                      all objects holding a reference
                                      to the receiver, optionally
                                      filtered by type.
  ->collect(a | a.supplier)         - For each Abstraction, collects
                                      its supplier NamedElements (the
                                      depended-upon side of the
                                      relationship).
  ->filter(uml::Class)              - Retains only uml::Class instances,
                                      excluding other NamedElement
                                      subtypes (e.g. Interfaces).
  ->asOrderedSet()                  - Deduplicates; a class may appear
                                      as supplier in multiple
                                      Abstraction relationships.
  ->sortedBy(c | c.name)            - Sorts result alphabetically by
                                      name.

@param aClass - A UML class whose abstraction suppliers are to be
                retrieved.
/]
[query public u_abstractionSuppliers(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.eInverse(uml::Abstraction)
    ->collect(a | a.supplier)
    ->filter(uml::Class)
    ->asOrderedSet()
    ->sortedBy(c | c.name)
/]

[**
Returns the type of the first owned end of a binary directed
association, cast to uml::Class. Intended for associations where
exactly one end is owned by the association (i.e. the non-navigable
end in a directed binary association). The caller must ensure the
owned end's type is a uml::Class; otherwise oclAsType() will fail
at runtime.
---
AQL operations used:
  anAssociation.ownedEnd        - EStructuralFeature on
                                  uml::Association: the ordered set
                                  of association ends owned by the
                                  association itself (as opposed to
                                  ends owned by the participant
                                  classifiers).
  ->first()                     - Returns the first element of the
                                  ordered set as a single object.
  .type                         - EStructuralFeature on
                                  uml::TypedElement: the classifier
                                  typing this association end.
  .oclAsType(uml::Class)        - Casts the type to uml::Class.
                                  Throws a runtime error if the type
                                  is not a uml::Class instance.

@param anAssociation - A UML association whose first owned end type
                       is to be returned as a uml::Class.
/]
[query public u_ownedEndClass(anAssociation : uml::Association) : uml::Class =
  anAssociation.ownedEnd->first().type.oclAsType(uml::Class)
/]

[**
Returns the type of the non-owned end of a binary directed
association, cast to uml::Class. Navigates from the first owned end
to its opposite end via getOtherEnd(), then returns that end's type.
Intended for binary associations only; behaviour is undefined for
n-ary associations. The caller must ensure the other end's type is a
uml::Class; otherwise oclAsType() will fail at runtime.
---
AQL operations used:
  anAssociation.ownedEnd        - EStructuralFeature on
                                  uml::Association: the ordered set
                                  of association ends owned by the
                                  association itself.
  ->first()                     - Returns the first element of the
                                  ordered set as a single object
                                  (a uml::Property).
  .getOtherEnd()                - Java method on uml::Property:
                                  returns the opposite end of a
                                  binary association. Not an
                                  EStructuralFeature; called with
                                  explicit parentheses in AQL.
  .type                         - EStructuralFeature on
                                  uml::TypedElement: the classifier
                                  typing this association end.
  .oclAsType(uml::Class)        - Casts the type to uml::Class.
                                  Throws a runtime error if the type
                                  is not a uml::Class instance.

@param anAssociation - A UML association whose non-owned end type
                       is to be returned as a uml::Class.
/]
[query public u_otherEndClass(anAssociation : uml::Association) : uml::Class =
  anAssociation.ownedEnd->first().getOtherEnd().type.oclAsType(uml::Class)
/]

[**
Returns an ordered set of all classes forming the diagram context of
the specified class. Combines classes reachable via direct
associations, the full superclass hierarchy and their limited
associations, the full subclass hierarchy, and abstraction
relationships. Used for diagram context scoping, e.g. to determine
which classes to include in a focused class diagram around aClass.

The result excludes aClass itself and is sorted alphabetically.
The union terms contribute the following:
  1. u_associatedClasses()       - Classes directly associated with
                                   aClass via incoming or outgoing
                                   binary associations.
  2. u_allSuperClasses()         - All ancestors of aClass in the
                                   superclass hierarchy.
  3. u_limitedAssociations()     - For each superclass, at most 3
     -> u_ownedEndClass()          filtered associations; collect
                                   their owned end types.
  4. u_limitedAssociations()     - Same filtered associations;
     -> u_otherEndClass()          collect their other end types.
  5. u_allSubClasses()           - All descendants of aClass in the
                                   subclass hierarchy.
  6. u_abstractionClients()      - Classes that depend on aClass via
                                   a uml::Abstraction relationship.
  7. u_abstractionSuppliers()    - Classes that aClass depends on via
                                   a uml::Abstraction relationship.
---
AQL operations used:
  u_associatedClasses()          - Query: returns classes directly
                                   associated with aClass via incoming
                                   or outgoing binary associations.
  u_allSuperClasses()            - Query: returns the ordered
                                   superclass hierarchy of aClass.
  ->collect(sc | expr)           - Collects results across all
                                   superclasses.
  u_limitedAssociations(aClass)  - Query: returns at most 3 filtered
                                   associations of a superclass,
                                   excluding those directly or
                                   indirectly connecting to aClass's
                                   hierarchy.
  u_ownedEndClass()              - Query: returns the type of the
                                   first owned end of an association
                                   as uml::Class.
  u_otherEndClass()              - Query: returns the type of the
                                   non-owned end of an association
                                   as uml::Class.
  u_allSubClasses()              - Query: returns all descendants of
                                   aClass in the subclass hierarchy.
  u_abstractionClients()         - Query: returns classes that list
                                   aClass as an abstraction supplier.
  u_abstractionSuppliers()       - Query: returns classes that aClass
                                   lists as an abstraction supplier.
  ->union(col)                   - Merges collections, deduplicating
                                   the combined result.
  ->asOrderedSet()               - Ensures the final merged result is
                                   a deduplicated OrderedSet.
  ->excluding(aClass)            - Removes aClass itself from the
                                   result.
  ->sortedBy(c | c.name)         - Sorts result alphabetically by
                                   name.

@param aClass - A UML class whose diagram context classes are to be
                retrieved.
/]
[query public u_contextClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.u_associatedClasses()
  ->union( aClass.u_allSuperClasses() )
  ->union(
    aClass.u_allSuperClasses()
      ->collect( sc1 | sc1.u_limitedAssociations(aClass) )
      ->collect( a1 | a1.u_ownedEndClass() )
  )
  ->union(
    aClass.u_allSuperClasses()
      ->collect( sc2 | sc2.u_limitedAssociations(aClass) )
      ->collect( a2 | a2.u_otherEndClass() )
  )
  ->union( aClass.u_allSubClasses() )
  ->union( aClass.u_abstractionClients() )
  ->union( aClass.u_abstractionSuppliers() )
  ->asOrderedSet()
  ->excluding(aClass)
  ->sortedBy(c | c.name)
/]

[**
Returns an ordered set of at most 3 associations involving aSuperClass
that are not directly connected to aClass and not connected to any of
aClass's superclasses on both ends simultaneously. This reduces
redundant Graphviz constraints parallel to the inheritance path.

The two filtering steps work as follows:
  1. Exclude associations where either end directly connects to aClass.
  2. Exclude associations where both ends are in aClass's superclass
     hierarchy (i.e. retain only those where at least one end is
     outside that hierarchy).

Associations are sorted by name before capping to ensure a
deterministic result independent of traversal order.
If more than 3 associations pass both filters, only the first 3 are
returned.
---
AQL operations used:
  aSuperClass.getAssociations()          - Java method on uml::Class:
                                           returns all associations in
                                           which aSuperClass participates
                                           as a member end. Not an
                                           EStructuralFeature; called
                                           with explicit parentheses
                                           in AQL.
  ->asOrderedSet()                       - Casts the result of
                                           getAssociations() to
                                           OrderedSet, required since
                                           getAssociations() does not
                                           return an OrderedSet in AQL.
  ->select(a | expr)                     - Filters the collection to
                                           elements satisfying the
                                           predicate.
  u_ownedEndClass()                      - Query: returns the type of
                                           the first owned end of the
                                           association as uml::Class.
  u_otherEndClass()                      - Query: returns the type of
                                           the non-owned end of the
                                           association as uml::Class.
  u_allSuperClasses()                    - Query: returns the ordered
                                           superclass hierarchy of
                                           aClass.
  ->excludes(obj)                        - Returns true if the
                                           collection does not contain
                                           obj.
  ->sortedBy(a | a.name)                 - Sorts associations
                                           alphabetically by name to
                                           ensure deterministic
                                           ordering before capping.
  ->size()                               - Returns the number of
                                           elements in the collection.
  ->subOrderedSet(1, 3)                  - Returns the first 3 elements
                                           of the ordered set.

@param aSuperClass - A UML class that is a superclass of aClass, whose
                     associations are to be filtered.
@param aClass      - A UML class that is a subclass of aSuperClass,
                     used as the exclusion reference.
/]

[query public u_limitedAssociations(
  aSuperClass : uml::Class,
  aClass      : uml::Class) : OrderedSet(uml::Association) =
  let associations : OrderedSet(uml::Association) =
    aSuperClass.getAssociations()->asOrderedSet()
      ->select(a |
        a.u_ownedEndClass() <> aClass
        and a.u_otherEndClass() <> aClass)
      ->select(a |
        aClass.u_allSuperClasses()->excludes(a.u_ownedEndClass())
        or aClass.u_allSuperClasses()->excludes(a.u_otherEndClass()))
      ->sortedBy(a | a.name)
  in
    if associations->size() > 3 then
      associations->subOrderedSet(1, 3)
    else
      associations
    endif
/]
