[**
Returns a string consisting of n repetitions of char.

@param char The character or string to repeat
@param n The number of repetitions
/]
[query public u_repeatChar(char : String, n : Integer) : String =
	if n <= 0
	then ''
	else char + char.u_repeatChar(n - 1)
	endif
/]


[**
Returns the cardinality of a property in ShEx syntax:
"?" for 0..1, "*" for 0..*, "+" for 1..*, "" for all other cases.

@param aProperty A UML property
/]
[query public OKu_shexCardinality(
		aProperty : uml::Property) : String =
	if (aProperty.lowerBound() == 0
			and aProperty.upperBound() == 1) then '?'
	else if (aProperty.lowerBound() == 0
			and aProperty.upperBound() == '*') then '*'
	else if (aProperty.lowerBound() == 1
			and aProperty.upperBound() == '*') then '+'
	else ''
	endif
	endif
	endif
/]

