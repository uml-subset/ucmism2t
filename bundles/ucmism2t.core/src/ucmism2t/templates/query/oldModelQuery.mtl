[**
Returns an ordered set of classes related to the specified class
via associations, inheritance, and abstraction relationships.
Used for diagram context scoping.

@param aClass A UML class
/]
[comment] [query public FROMA3e_contextClasses(
		aClass : uml::Class) : OrderedSet(uml::Class) =
	aClass.eInverse(uml::Association)
		->asSequence()
		->collect(temp37 |
			temp37.ownedEnd->first().type.oclAsType(uml::Class))
	->union(
		aClass.eInverse(uml::Association)
			->asSequence()
			->collect(temp38 |
				temp38.ownedEnd->first()
					.getOtherEnd().type.oclAsType(uml::Class)))
	->union(aClass.u_superClasses())
	->union(
		aClass.u_superClasses()
			->collect(sc | sc.e_limitedAssociations3(aClass))
			->collect(temp39 |
				temp39.ownedEnd->first().type.oclAsType(uml::Class)))
	->union(
		aClass.u_superClasses()
			->collect(sc | sc.e_limitedAssociations3(aClass))
			->collect(temp40 |
				temp40.ownedEnd->first()
					.getOtherEnd().type.oclAsType(uml::Class)))
	->union(aClass.u_allSubClasses()->asSequence())
	->union(
		aClass.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp41 | temp41.client))
	->union(
		aClass.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp42 | temp42.supplier))
	->excluding(aClass)
	->asOrderedSet()
	->sortedBy(temp43 | temp43.name)
/]
[/comment]
[comment]
[query public e_contextClasses(aClass : Class) : OrderedSet(Class) =
	aClass.eInverse(Association)
		->collect(ownedEnd->first().type.oclAsType(Class))
	->union(aClass.eInverse(Association)
		->collect(ownedEnd->first().getOtherEnd().type.oclAsType(Class)))
	->union(u_superClasses(aClass))
	->union(u_superClasses(aClass)
		->collect(e_limitedAssociations())
		->collect(ownedEnd->first().type.oclAsType(Class)))
	->union(u_superClasses(aClass)
		->collect(e_limitedAssociations())
		->collect(ownedEnd->first().getOtherEnd().type.oclAsType(Class)))
	->union(u_allSubClasses(aClass)->asSequence())
	->union(aClass.eInverse(Abstraction).client)
	->union(aClass.eInverse(Abstraction).supplier)
	->excluding(aClass)
	->asOrderedSet()
	->sortedBy(name)
/]
[/comment]

[**
Returns an ordered set of classifiers related to the specified
data type via usage, inheritance, and abstraction relationships.
Used for diagram context scoping.

@param aDataType A UML data type
/]
[query public e_contextClassesOrDataTypes(
		aDataType : uml::DataType) : OrderedSet(uml::Classifier) =
	aDataType.e_dataTypeUseProperties()
		->asSequence()
		->collect(temp44 | temp44.owner.oclAsType(uml::Classifier))
	->union(aDataType.u_superDataTypes())
	->union(
		aDataType.u_superDataTypes()
			->collect(temp45 | temp45.e_limitedDataTypeUseProperties())
			->collect(temp46 |
				temp46.owner.oclAsType(uml::Classifier)))
	->union(aDataType.u_allSubDataTypes()->asSequence())
	->union(
		aDataType.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp47 | temp47.client))
	->union(
		aDataType.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp48 | temp48.supplier))
	->excluding(aDataType)
	->asOrderedSet()
	->sortedBy(temp49 | temp49.name)
/]

[**
Returns an ordered set of associations of a superclass that are
not between the superclass and any of the subclass's ancestors.
Used to reduce diagram clutter by excluding associations that are
already represented through the inheritance path.

@param aSuperClass A UML class that is a superclass of aClass
@param aClass A UML class
/]
[query public e_limitedAssociations2(
		aSuperClass : uml::Class,
		aClass : uml::Class) : OrderedSet(uml::Association) =
	aSuperClass.u_associations()
		->select(a |
			a.e_ownedEndClass() <> aClass
			and a.e_otherEndClass() <> aClass)
		->select(a |
			aClass.u_superClasses()->excludes(a.e_ownedEndClass())
			or aClass.u_superClasses()
				->excludes(a.e_otherEndClass()))
/]

[**
Returns at most 3 associations from e_limitedAssociations2
to keep diagrams manageable.

@param aSuperClass A UML class that is a superclass of aClass
@param aClass A UML class
/]
[query public e_limitedAssociations3(
		aSuperClass : uml::Class,
		aClass : uml::Class) : OrderedSet(uml::Association) =
	if aSuperClass.e_limitedAssociations2(aClass)->size() > 3
	then
		aSuperClass.e_limitedAssociations2(aClass)
			->subOrderedSet(1, 3)
	else aSuperClass.e_limitedAssociations2(aClass)
	endif
/]

[comment]
[query public e_limitedAssociations2(
		aSuperClass : Class,
		aClass : Class) : OrderedSet(Association) =
	let la : OrderedSet(Association) =
		aSuperClass.eInverse(Association)
			->select(a : Association |
				a.e_ownedEndClass() <> aClass
				and a.e_otherEndClass() <> aClass)
			->select(a : Association |
				aClass.u_superClasses()->excludes(a.e_ownedEndClass())
				or aClass.u_superClasses()
					->excludes(a.e_otherEndClass()))
	in
	if la->size() > 3
	then la->subOrderedSet(1, 3)
	else la
	endif
/]
[/comment]

