[comment encoding = UTF-8 /]
[**
Module contains all model queries.
Queries with prefix "e_" are migrated from Acceleo 3.7.
Queries with prefix "u_" are written for Acceleo 4.
/]
[module oldModelQuery(
	'http://www.eclipse.org/uml2/5.0.0/UML',
	'http://www.eclipse.org/uml2/5.0.0/Types',
	'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard'
)/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::dataTypeQuery/]
[import ucmism2t::queries::elementQuery/]
[import ucmism2t::services::PropertiesService /]

[**
Returns the ModelIdentification data type from a model.
This data type contains model metadata such as acronym, version,
and title as owned properties with default values.

@param aModel A UML model
/]
[query public e_modelIdentication(
		aModel : uml::Model) : uml::DataType =
	aModel.eAllContents(uml::DataType)
		->select(temp62 | temp62.name = 'ModelIdentification')
		->first()
/]

[**
Returns the short model name including version,
derived from the model acronym, major version, and minor version.
Format: ACRONYM_MAJOR-MINOR.

@param aModel A UML model
/]
[query public e_modelShortName(aModel : uml::Model) : String =
	aModel.e_modelAcronym()
		+ '_'
		+ aModel.e_modelMajorVersion()
		+ '-'
		+ aModel.e_modelMinorVersion()
/]

[**
Returns the model acronym. The value is determined in order of
priority: (1) MODEL_ACRONYM property, (2) ModelIdentification
data type in the model, (3) model name as fallback.

@param aModel A UML model
/]
[query public e_modelAcronym(aModel : uml::Model) : String =
	let fromProperties : String =
		'MODEL_ACRONYM'.getPropertyValue()
	in
	let fromModel : String =
		aModel.eAllContents(uml::DataType)
			->select(temp63 | temp63.name = 'ModelIdentification')
			->first()
			.eContents(uml::Property)
			->select(temp64 | temp64.name = 'acronym')
			->first().default
	in
	if fromProperties.size() > 0
	then fromProperties
	else
		if not (fromModel = null)
		then fromModel
		else aModel.name
		endif
	endif
/]

