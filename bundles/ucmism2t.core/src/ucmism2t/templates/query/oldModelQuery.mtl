[**
Returns an ordered set of all superclasses of a class,
starting at the direct parent up to the root.
Note: Works only for single inheritance.

@param aClass - A UML class whose superclass hierarchy
                is to be retrieved.
/]
[comment] [query public OKu_allSuperClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  let superTypes : OrderedSet(uml::Class) =
  	aClass.general->filter(uml::Class)->asOrderedSet()
  	in
    if superTypes->notEmpty() then
      let superType : uml::Class = superTypes->first()
      in
      superType->asOrderedSet()
        ->union(superType.OKu_allSuperClasses())
    else
      OrderedSet{}
    endif
/]
[/comment]
[**
Returns an ordered set of all super datatypes of a datatype,
starting at the direct parent up to the root.
Note: Works only for single inheritance.

@param aDataType - A UML datatype whose supertype hierarchy
                   is to be retrieved.
/]
[query public OKu_allSuperDataTypes(aDataType : uml::DataType) : OrderedSet(uml::DataType) =
  let superTypes : OrderedSet(uml::DataType) =
  	aDataType.general->filter(uml::DataType)->asOrderedSet()
  	in
    if superTypes->notEmpty() then
      let superType : uml::DataType = superTypes->first()
      in
      superType->asOrderedSet()
        ->union(superType.OKu_allSuperDataTypes())
    else
      OrderedSet{}
    endif
/]

[**
Returns a sequence of all super classifiers of a classifier,
starting at the direct parent.
Note: Works only with classes and data types.

@param aClassifier A UML classifier
/]
[query public OKu_allSuperClassifiers(
		aClassifier : uml::Classifier) : Sequence(uml::Classifier) =
	let superClassifier : uml::Classifier =
		aClassifier.general->first()
	in
	if (superClassifier = null
			or not (superClassifier.oclIsTypeOf(uml::Class)
				or superClassifier.oclIsKindOf(uml::DataType)))
	then
		Sequence{}
	else
		superClassifier
			->asSequence()
			->union(superClassifier.OKu_allSuperClassifiers())
	endif
/]

[**
Returns all classes that are sources of incoming binary directed
associations pointing to the specified class. Alphabetically sorted,
deduplicated set of classes that have an outgoing association
pointing to this class. Uses eInverse() to
find all uml::Property elements whose type reference points to aClass,
then resolves the source class via getOtherEnd().type on the
association end that is owned by the source class (ownedAttribute).
Self-associations are excluded from the result.
---
AQL operations used:
  eInverse(uml::Property)    - Finds all Property instances whose type
                               EReference cross-references aClass; requires
                               all resources to be loaded in the same
                               resource set.
  ->select(p1 | cond)        - Keeps only association ends owned by a
                               class (not by the association itself).
  p1.association             - EReference: the owning Association element;
                               null if not an association end.
  eContainingFeature()       - Returns the EReference via which p is
                               contained; .name = 'ownedAttribute' confirms
                               the property is source-class-owned, not
                               owned by the Association (ownedEnd).
  ->collect(p2 | expr)       - Transforms each qualifying property.
  p2.getOtherEnd()           - Java method on uml::Property: returns the
                               opposite end of a binary association.
                               Not an EStructuralFeature; must be called
                               with explicit parentheses in AQL.
  .type                      - EReference: the classifier typing the other
                               end (i.e., the source class); typed as
                               uml::Type, narrowed by filter below.
  ->filter(uml::Class)       - Retains only uml::Class instances;
                               also drops null values safely.
  ->reject(c1 | c1 = aClass) - Excludes self-associations.
  ->asOrderedSet()           - Deduplicates the result collection.
  ->sortedBy(c2 | c2.name)   - Sorts alphabetically by class name.

@param aClass - The target class whose incoming association sources are to be retrieved.
/]
[query public OKu_incomingAssociatedClasses(aClass : uml::Class) : OrderedSet(uml::Class) =
  aClass.eInverse(uml::Property)
    ->select(p1 | p1.association <> null
           and p1.eContainingFeature().name = 'ownedAttribute')
    ->collect(p2 | p2.getOtherEnd().type)
    ->filter(uml::Class)
    ->reject(c1 | c1 = aClass)
    ->asOrderedSet()
    ->sortedBy(c2 | c2.name)
/]


[**
Returns an ordered set of all associations of the specified class,
combining both outgoing and incoming binary directed associations.
Delegates to getOutgoingAssociations() and getIncomingAssociations(),
merges the results, deduplicates, and sorts alphabetically by name.
Self-associations are excluded.
---
AQL operations used:
  getOutgoingAssociations()  - Query: returns associations where aClass
                               owns the source end via ownedAttribute.
  getIncomingAssociations()  - Query: returns associations where aClass
                               is the target type of the source end.
  ->union(col)               - Merges both collections into one;
                               returns OrderedSet matching return type.
  ->asOrderedSet()           - Deduplicates; an association could
                               theoretically appear in both directions
                               in a non-strict model.
  ->sortedBy(a | a.name)     - Sorts final result alphabetically by
                               association name.

@param aClass - The class whose outgoing and incoming associations
                are to be retrieved.
/]
[comment] [query public OKu_associations(aClass : uml::Class) : OrderedSet(uml::Association) =
    aClass.u_outgoingAssociations()
  ->union(aClass.u_incomingAssociations())
  ->asOrderedSet()
  ->sortedBy(a | a.name)
/]
[/comment]

[**
Returns an ordered set of all associations in which the specified
class participates as a typed end. This is the Acceleo 4 replacement
for aClass.eInverse(uml::Association) from Acceleo 3, which does not
work in AQL. Navigates cross-references via eInverse('type') to find
all properties typed by aClass, then collects their owning
associations.

Two associations between the same two classes are distinct EMF
objects and are both retained in the result. The ->asOrderedSet()
call only deduplicates cases where the same association object
appears more than once, which occurs when both ends of a
self-association are typed by aClass — in that case eInverse('type')
yields the same association twice and ->asOrderedSet() correctly
collapses it to one.

Note: excludes uml::Port instances since ->filter(uml::Property)
retains only exact uml::Property matches. Remove the filter or use
oclIsKindOf if ports should be included.
---
AQL operations used:
  aClass.eInverse('type')        - AQL operation on EObject: returns
                                   all EObjects that reference aClass
                                   via the 'type' EStructuralFeature,
                                   i.e. all typed elements whose type
                                   is aClass.
  ->filter(uml::Property)        - Retains only uml::Property
                                   instances, excluding other typed
                                   elements such as parameters or
                                   ports.
  ->select(p1 |                  - Retains only properties that
    p1.association->notEmpty())    belong to an association, excluding
                                   plain class attributes.
  ->collect(p2 | p2.association) - Collects the owning association
                                   of each retained property.
  ->asOrderedSet()               - Deduplicates cases where the same
                                   association object appears more
                                   than once (e.g. self-associations
                                   where both ends are typed by
                                   aClass). Two distinct associations
                                   between the same two classes are
                                   different objects and are both
                                   retained.
  ->sortedBy(a | a.name)         - Sorts result alphabetically by
                                   name.

@param aClass - A UML class whose participating associations are to
               be retrieved.
/]
[comment] [query public u_associations4(aClass : uml::Class) : OrderedSet(uml::Association) =
  aClass.eInverse('type')
    ->filter(uml::Property)
    ->select(p1 | p1.association->notEmpty())
    ->collect(p2 | p2.association)
    ->asOrderedSet()
    ->sortedBy(a | a.name)
/]
[/comment]

[**
Returns the qualified name of a UML type. For resolved types, returns
the name property directly. For unresolved UML primitive type proxies
(e.g. Boolean, Integer, String, Real from UMLPrimitiveTypes.xmi),
the name is extracted from the toString() representation since the
name property returns empty on unresolved proxies.
Note: this workaround is not necessary if UMLResourcesUtil.init(
resourceSet) is registered in the generator launcher, in which case
all primitive type proxies resolve correctly and name is always
accessible. The workaround degrades gracefully when registration
is present.

@param aType - A UML type whose simple name is to be returned,
               including unresolved primitive type proxies.
/]
[query public u_typeQualifiedName(aType : uml::Type) : String =
  if aType.eClass().name = 'PrimitiveType' then
    let s : String = aType.toString()
    in
      s.substring(s.lastIndex('#') + 1).replace('\\)', '')
  else
    aType.qualifiedName
  endif
/]


[**
Returns a sequence of inherited attributes of the specified data type.
Excludes own attributes.

@param aDataType - A UML data type whose inherited attributes are to
                   be retrieved.
/]
[query public u_inheritedDataTypeAttributes(
  aDataType : uml::DataType) : Sequence(uml::Property) =
  aDataType.inheritedMember
    ->filter(uml::Property)
    ->select(p1 | p1.association->isEmpty())
    ->sortedBy(p2 | p2.name)
/]


[**
Returns an ordered set of classifiers related to the specified
data type via usage, inheritance, and abstraction relationships.
Used for diagram context scoping.

@param aDataType A UML data type
/]
[query public u_contextClassesOrDataTypes(
		aDataType : uml::DataType) : OrderedSet(uml::Classifier) =
	aDataType.u_dataTypeUseProperties()
		->collect(p | p.owner.oclAsType(uml::Classifier))
	->union(aDataType.u_superDataTypes())
	->union(
		aDataType.u_superDataTypes()
			->collect(temp45 | temp45.e_limitedDataTypeUseProperties())
			->collect(temp46 |
				temp46.owner.oclAsType(uml::Classifier)))
	->union(aDataType.u_allSubDataTypes())
	->union(
		aDataType.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp47 | temp47.client))
	->union(
		aDataType.eInverse(uml::Abstraction)
			->asSequence()
			->collect(temp48 | temp48.supplier))
	->excluding(aDataType)
	->asOrderedSet()
	->sortedBy(temp49 | temp49.name)
/]
