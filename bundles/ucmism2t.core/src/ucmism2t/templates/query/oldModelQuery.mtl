[**
Returns the first 100 characters of the first owned comment body
of a named element, followed by a newline and "..." if truncated.
Returns an empty string if there are no owned comments.

@param aNamedElement A UML named element
/]
[query public e_shortDocumentation(
		aNamedElement : uml::NamedElement) : String =
	if aNamedElement.ownedComment->isEmpty()
	then ''
	else
		let d : String =
			aNamedElement.ownedComment->asOrderedSet()->first().body
		in
		if d.size() > 100
		then d.substring(1, 100) + '\n...'
		else d
		endif
	endif
/]

