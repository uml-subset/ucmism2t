[**
Returns an ordered set of associations of a superclass that are
not between the superclass and any of the subclass's ancestors.
Used to reduce diagram clutter by excluding associations that are
already represented through the inheritance path.

@param aSuperClass A UML class that is a superclass of aClass
@param aClass A UML class
/]
[comment] MIGRATED
[query public e_limitedAssociations2(
		aSuperClass : uml::Class,
		aClass : uml::Class) : OrderedSet(uml::Association) =
	aSuperClass.u_associations()
		->select(a |
			a.e_ownedEndClass() <> aClass
			and a.e_otherEndClass() <> aClass)
		->select(a |
			aClass.u_superClasses()->excludes(a.e_ownedEndClass())
			or aClass.u_superClasses()
				->excludes(a.e_otherEndClass()))
[/comment]/]
[query public e_limitedAssociations2(
		aSuperClass : uml::Class,
		aClass : uml::Class) : OrderedSet(uml::Association) =
	aSuperClass.u_associations()
		->select(a |
			a.e_ownedEndClass() <> aClass
			and a.e_otherEndClass() <> aClass)
		->select(a |
			aClass.u_superClasses()->excludes(a.e_ownedEndClass())
			or aClass.u_superClasses()
				->excludes(a.e_otherEndClass()))
/]

[**
Returns at most 3 associations from e_limitedAssociations2
to keep diagrams manageable.

@param aSuperClass A UML class that is a superclass of aClass
@param aClass A UML class
/]
[query public e_limitedAssociations3(
		aSuperClass : uml::Class,
		aClass : uml::Class) : OrderedSet(uml::Association) =
	if aSuperClass.e_limitedAssociations2(aClass)->size() > 3
	then
		aSuperClass.e_limitedAssociations2(aClass)
			->subOrderedSet(1, 3)
	else aSuperClass.e_limitedAssociations2(aClass)
	endif
/]

[**
Returns an ordered set of classifiers related to the specified
data type via usage, inheritance, and abstraction relationships.
Used for diagram context scoping.

@param aDataType A UML data type
/]
[query public uu_contextClassesOrDataTypes(
		aDataType : uml::DataType) : OrderedSet(uml::Classifier) =
	aDataType.u_dataTypeUseProperties()
		->collect(p | p.owner.oclAsType(uml::Classifier))
	->union(aDataType.u_superDataTypes())
	->union( 
		aDataType.u_superDataTypes()
			->collect(temp45 | temp45.e_limitedDataTypeUseProperties())
	->union(aDataType.u_allSubDataTypes())
	->union(aDataType.u_abstractionClientsDataType())
	->union(aDataType.u_abstractionSuppliersDataType())
	->excluding(aDataType)
	->asOrderedSet()
	->sortedBy(temp49 | temp49.name)
/]
