[module testFile('http://www.eclipse.org/emf/2002/Ecore', 'http://www.eclipse.org/uml2/5.0.0/Types', 'http://www.eclipse.org/uml2/5.0.0/UML', 'http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard')/]

[import ucmism2t::queries::associationQuery/]
[import ucmism2t::queries::classQuery/]
[import ucmism2t::queries::dataTypeQuery/]
[import ucmism2t::queries::elementQuery/]
[import ucmism2t::queries::modelQuery/]
[import ucmism2t::queries::packageQuery/]
[import ucmism2t::queries::typeQuery/]
[import ucmism2t::services::DateTimeService /]
[import ucmism2t::services::PropertiesService /]
[import ucmism2t::templates::query::oldModelQuery/]
[import ucmism2t::templates::target::rdf::commonRdf/]

[template public processModelTest(aModel : uml::Model)]
  [file ('test.txt', overwrite, 'UTF-8')]
    
    time: [aModel.getCurrentDateTime()/]
        
    e_modelAcronym '[aModel.e_modelAcronym()/]'
    e_modelShortName '[aModel.e_modelShortName()/]'
    
    'test'.isPropertyTrue() ['test'.isPropertyTrue()/]
    'xx'.getPropertyValue() ['xx'.getPropertyValue()/]

    #######################
    N client 1: [aModel.u_allAbstractionClients()->size()/]
		[for (c : uml::NamedElement | aModel.u_allAbstractionClients()->sortedBy(c2 | c2.qualifiedName))]
	  		client 1: [c.qualifiedName/]
		[/for]
    #######################
		[let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'InstanceVariable')->first()]
			[for (p : uml::Property | c.u_associationEndProperties())]
    		assoc name [p.association.name/]
			[/for]
		[/let]
    #######################
    [let d : uml::DataType = aModel.eAllContents(uml::DataType)->select(p | p.name = 'Identifier')->first()]
     	e_isGeneralDataType: [d.e_isGeneralDataType()/]
     	u_isGeneralDataType: [d.u_isGeneralDataType()/]
    [/let]
    [let d : uml::DataType = aModel.eAllContents(uml::DataType)->select(p | p.name = 'Selector')->first()]
     	e_isGeneralDataType: [d.e_isGeneralDataType()/]
     	u_isGeneralDataType: [d.u_isGeneralDataType()/]
    [/let]
    #######################
    [let p1 : uml::Package = 	aModel.eAllContents(uml::Package)->select(p2 | p2.name = 'Classes')->first()]
      	n 1: [p1.e_childrenPackages()->size()/]
		[for (p3 : uml::Package | p1.e_childrenPackages())]
	  		Package 1: [p3.qualifiedName/]
		[/for]
      	n 1: [p1.u_childPackages()->size()/]
		[for (p4 : uml::Package | p1.u_childPackages())]
	  		Package 2: [p4.qualifiedName/]
		[/for]
    [/let]
    #######################
		[let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'InstanceVariable')->first()]
	    e_simpleQualifiedClassName: [c.e_simpleQualifiedClassName()/]
	    u_packageQualifiedName: [c.u_packageQualifiedName()/]
	    u_parent: [c.u_parent()/]
	    u_parent: [c.u_parent().name/]
	    u_nearestPackage name: [c.u_nearestPackage().name/]
	    u_model name: [c.u_model().name/]
	    a u_parent: [c.u_attributes()->first().u_parent().name/]
	    a u_parent name: [c.u_attributes()->first().u_parent().name/]
	    a u_nearestPackage name: [c.u_attributes()->first().u_nearestPackage().name/]
			[for (a : uml::Association | c.u_associations())]
    		assoc name: [a.name/]
    		assoc u_ownedEndClass [a.u_ownedEndClass().name/]
    		assoc u_otherEndClass [a.u_otherEndClass().name/]
			[/for]
		[/let]
    #######################
    [let d : uml::DataType =
    	aModel.eAllContents(uml::DataType)->select(p | p.name = 'Identifier')->first()]
  		[for (ud : uml::Class | d.u_usingClasses()->sortedBy(ud2 | ud2.qualifiedName) )]
      	u_usingDataTypes: [ud.qualifiedName/]
			[/for]
    [/let]
	[let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept')->first()]
				test 6 [c.test6()/]
				class name: [c.qualifiedName/]
				SIZE: [c.u_inheritedAssociations()->size()/]
  		[for (p2 : uml::Class | c.u_subClasses())]
		       T subclass name: [p2.name/]
		[/for]
	
[comment] 		aClass.inheritedMember->filter(uml::Property)
			->select(p1 | p1.association->notEmpty())
			->collect(p | p.association) 
			->sortedBy(p2 | p2.name)

[/comment]
  		[for (p2 : uml::Association | c.u_inheritedAssociations())]
[comment]  		[for (p2 : uml::NamedElement | c.inheritedMember 	)][/comment]
		       assoc name: [p2.name/]
		[/for]


			[for (att : uml::Property | c.eAllContents(uml::Property)->select(p1 | p1.association = null)->sortedBy(p2 | p2.name))]
					att name: [att.name/]
						[att.type.eClass().name/]
						[att.type.name/]
						[att.type.getURIFragment()/]
						[att.type.toString()/]
						"[att.type.u_typeName()/]"
			[/for]
	
		[/let]
    #######################
		[let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'Individual')->first()]
    	e_isSuperClass [c.u_isSuperClass()/]
		[/let]
    #######################
		[let c1 : uml::Class = aModel.eAllContents(uml::Class)->select(c2 | c2.name = 'InstanceVariable')->first()]
	    [for (c2 : uml::Class | c1.u_outgoingAssociatedClasses()->sortedBy(c3 | c3.name))]
       c name: [c2.name/]
	    [/for]
	    [for (a1 : uml::Association | c1.u_associations())]
       a name: [a1.name/]
	    [/for]
		[/let]
    #######################
		[let p : uml::Package =
			aModel.eAllContents(uml::Package)->select(p | p.name = 'Conceptual')->first()]
	
				class name: [p.qualifiedName/]
	
			[for (c : uml::Class | aModel.u_rootSuperClasses()->sortedBy(c2 | c2.name))]
					c name: [c.name/]
			[/for]
	
		[/let]

				#######################
		[let d : uml::DataType =
			aModel.eAllContents(uml::DataType)->select(p | p.name = 'ObjectName')->first()]
	
				class name: [d.qualifiedName/]
	
			[for (p : uml::Property | d.u_dataTypeUseProperties()->sortedBy(p | p.qualifiedName))]
					p name: [p.qualifiedName/]
			[/for]
	
		[/let]

 	 [let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'InstanceVariable')->first()]
	    #######################
	    class name: [c.qualifiedName/]
	    eInverse analyze:
			[for (obj : ecore::EObject | c.eInverse()->sortedBy(o | o.eClass().name)->sortedBy(s | s.toString()))]
					 eClass().name: [obj.eClass().name/]
[comment] 					 [if (obj.eClass().name = 'Property' and obj.association <> null)]
							 type name: [obj.ownedEnd.type.name/]
							 other type: [obj.ownedEnd.getOtherEnd().type.name/]
        		[/if]
					 [if (obj.eClass().name = 'Property' and obj.association = null)]
							 name: [obj.name/]
        		[/if]
[/comment]					 toString: [obj.toString()/]
			[/for]
			[for (c3 : uml::Class | c.u_abstractionClients())]
					u_abstractionClients: [c3.name/] 
			[/for]
			[for (c3 : uml::Class | c.u_abstractionSupplierClasses())]
					u_abstractionClients: [c3.name/] 
			[/for]
			[for (c3 : uml::Class | c.u_contextClasses())]
					u_contextClasses: [c3.name/] 
			[/for]
	    #######################
				 X: [c.u_associatedClasses()->size()/]
			[for (a : uml::Association | c.u_incomingAssociations())]
				 u_incomingAssociations name: [a.name/]
			[/for]
			[for (a : uml::Association | c.u_outgoingAssociations())]
				 u_outgoingAssociations name: [a.name/]
			[/for]
			[for (a : uml::Association | c.u_associations())]
				 u_associations name: [a.name/]
			[/for]
		[/let]

    #######################
		[let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'AgentListing')->first()]
		  c.qualifiedName: [c.qualifiedName/]
		  [for (c2 : uml::Class | c.u_incomingAssociatedClasses())]
						u_incomingAssociatedClasses: [c2.name/] 
		  [/for]
		  [for (c3 : uml::Class | c.u_outgoingAssociatedClasses())]
						u_outgoingAssociatedClasses: [c3.name/] 
		  [/for]
		  [c.u_associatedClasses()/]
		  [for (c4 : uml::Class | c.u_associatedClasses())]
						u_associatedClasses: [c4.name/] 
		  [/for]
		  eInverse Association size: [c.eInverse(uml::Association)->size()/] 0
		  eInverse Property size: [c.eInverse(uml::Property)->size()/] 13
		  eInverse association ownedEnd size: [c.eInverse(uml::Property)->select(p | p.association <> null).association.ownedEnd->size()/]
		  eInverse association memberEnd: [c.eInverse(uml::Property)->select(p | p.association <> null).association.memberEnd->size()/]
		  eInverse association ownedEnd: [c.eInverse(uml::Property)->select(p | p.association <> null).association/]
		  [for (a : uml::Association | c.eInverse(uml::Property)->select(p | p.association <> null).association)]
						eInverse Property association (to) name: [a.name/], [a.ownedEnd.type.name/] 
						eInverse Property association (to) name: [a.name/], [a.memberEnd.type.name/] 
						eInverse Property association (to) name: [a.name/], [a.ownedEnd.type.oclIsTypeOf(uml::Class)/] 
		  [/for]
		  [for (c2 : uml::Type | c.eInverse(uml::Property)->select(p | p.association <> null).association.memberEnd.type)]
						eInverse type (to) name: [c2.name/] 
						eInverse type (to) name: [c2.oclIsTypeOf(uml::Class)/] 
						eInverse type (to) name: [c2.oclIsTypeOf(uml::Type)/] 
		  [/for]
		  eInverse association getOtherEnd: [c.eInverse(uml::Property)->select(p | p.association <> null).association.ownedEnd->first().getOtherEnd()->size()/]
		  Property size2: [c.eContents(uml::Property)->size()/]
		  Property attribute size2: [c.eContents(uml::Property)->select(p | p.association = null)->size()/]
		  Property association size2: [c.eContents(uml::Property)->select(p | p.association <> null)->size()/]
		  [for (a : uml::Association | c.eContents(uml::Property)->select(p | p.association <> null).association)]
						Property association (to) name: [a.name/], [a.ownedEnd->first().getOtherEnd().type.name/] 
		  [/for]
				OK
		  attribute size: [c.eInverse(uml::Property)->select(p | p.association = null)->size()/]
				association size: [c.eInverse(uml::Property)->select(p | p.association <> null)->size()/]
				association: [c.eInverse(uml::Property)->select(p | p.association <> null)/]
		  abstraction client: [c.eInverse(uml::Abstraction).client.name/]
		  abstraction supplier: [c.eInverse(uml::Abstraction).supplier.name/]
		[/let]

    #######################
    [let c : uml::Class = aModel.eAllContents(uml::Class)->select(p | p.name = 'InstanceVariable')->first()]
      c.qualifiedName: [c.qualifiedName/]
      [let im : Sequence(uml::NamedElement) = c.inheritedMember]
      		im size: [im->size()/]
      		[let ps : Sequence(uml::Property) = im->collect(p3 | p3.oclAsType(uml::Property)) ]
          	ps size: [ps->size()/]
          		[let ps2 : Sequence(uml::Property) =	ps->select(p4 | p4.association <> null)]
          				ps2 size: [ps2->size()/]
              			[let as : Sequence(uml::Association) = ps2->collect(p5 | p5.association)]
											[as->size()/] ps2 size
			          					[for (a : uml::Association | as)]
                    				[a.name/]
			          					[/for]
			          					[for (a : uml::Association | c.u_inheritedAssociations())]
                    				[a.name/]
			          					[/for]
										[/let]
							[/let]
					[/let]
			[/let]
		[/let]

    #######################
    [let agents : uml::Package =
    	aModel.eAllContents(uml::Package)->select(p | p.name = 'Conceptual')->first()]
    		agents [agents/]
		[let superclasses : Sequence(uml::Class) =
			agents.u_rootSuperClasses()]
    		superclasses->size():[superclasses->size()/]
		[for (sc : uml::Class | superclasses )]
			[sc.qualifiedName/]
		[/for]
    [/let]
    [/let]



    Agents: [aModel.eAllContents(uml::Package)->select(p | p.name = 'Agents')->first()/]
    Model: [aModel.eAllContents(uml::Package)->first() /]
    Ancestors package: [aModel.eAllContents(uml::Package)->select(p | p.name = 'Agents')->first().ancestors()->last()/]
    Ancestors class: [aModel.eAllContents(uml::Class)->select(p | p.name = 'Individual')->first().ancestors()->last()/]
    getModel(): [aModel.eAllContents(uml::Package)->select(p | p.name = 'Agents')->first().getModel().name/]
    eInverse: [aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept').eInverse(uml::Class)/]
		[for (subClass : uml::Class |
				aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept')
					.eInverse(uml::Generalization)
					.specific
					->select(cl | cl.oclIsTypeOf(uml::Class))
					->sortedBy(c | c.name)
			)]
    name: [subClass.name/]
[comment]     	Generalization: [subClass.eInverse(uml::Generalization)/]
    	specific: [subClass.eInverse(uml::Generalization).specific/]
    	specific name: [subClass.eInverse(uml::Generalization).specific.name/]
    	specific name: [subClass.eInverse(uml::Generalization).specific->select(cl | cl.oclIsTypeOf(uml::Class)).name/]
    	specific first name: [subClass.eInverse(uml::Generalization).specific->select(cl | cl.oclIsTypeOf(uml::Class))->first().name/]
[/comment]
		[/for]
		[for (subClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept').u_subClasses()
			 )]
			 Concept subclass name: [subClass.name/]
		[/for]
		[for (subClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'RepresentedVariable').u_subClasses()
			 )]
			 RepresentedVariable subclass name: [subClass.name/]
		[/for]
  		[for (subClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept').u_allSubClasses()
			 )]
									u2 subclass name: [subClass.name/]
		[/for]
  		[for (subClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'RepresentedVariable').u_allSubClasses()
			 )]
									RepresentedVariable u2 subclass name: [subClass.name/]
		[/for]
  		[for (subClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'Individual').u_allSubClasses()
			 )]
									Individual u2 subclass name: [subClass.name/]
		[/for]
  		[for (superClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'Individual').u_superClasses()
			 )]
									Individual Superclasses: [superClass.name/]
		[/for]
  		[for (superClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'InstanceVariable').u_superClasses()
			 )]
									InstanceVariable Superclasses: [superClass.name/]
		[/for]
  		[for (superClass : uml::Class |
			 aModel.eAllContents(uml::Class)->select(p | p.name = 'Concept').u_superClasses()
			 )]
									Concept Superclasses: [superClass.name/]
		[/for]
				---------- eInverse ----------
		[for ( p : uml::Property | 
			aModel.eAllContents(uml::Class)
				->select(p | p.name = 'AgentListing').eInverse(uml::Property)
				->select(p | p.association <> null)
		)]
		[aModel.name/]
		[p.association/] association
		[p.association.name/] association - name
		[p.associationEnd/] associationEnd -
		[p.type/] type
		[p.type.oclIsTypeOf(uml::Class)/] type is class
		[p.type.name/] type name
		[p.opposite.type/] opposite type
		[p.opposite.type.oclIsTypeOf(uml::Class)/] opposite type is class
		[p.opposite.type.name/] opposite type name
		[p.getOtherEnd().type/] getOtherEnd().type
		[p.getOtherEnd().type.oclIsTypeOf(uml::Class)/] getOtherEnd().type is class
		[p.getOtherEnd().type.name/] getOtherEnd().type name
		[p.owningAssociation/] owningAssociation
		[p.owner/] owner
		[/for]
				---------- eContents(uml::Property) ----------
		[for ( p : uml::Property | 
			aModel.eAllContents(uml::Class)
				->select(p | p.name = 'AgentListing').eContents(uml::Property)
				->select(p | p.association <> null)
		)]
		[aModel.name/]
		[p.association/] association
		[p.association.name/] association - name
		[p.associationEnd/] associationEnd -
		[p.type/] type
		[p.type.oclIsTypeOf(uml::Class)/] type is class
		[p.type.name/] type name
		[p.opposite.type/] opposite type
		[p.opposite.type.oclIsTypeOf(uml::Class)/] opposite type is class
		[p.opposite.type.name/] opposite type name
		[p.getOtherEnd().type/] getOtherEnd().type
		[p.getOtherEnd().type.oclIsTypeOf(uml::Class)/] getOtherEnd().type is class
		[p.getOtherEnd().type.name/] getOtherEnd().type name
		[p.owningAssociation/] owningAssociation
		[p.owner/] owner
		[/for]
  [/file]
[/template]



[template public test5(p : uml::Class)]
  this is a class: [p.name/]
[/template]

[template public test5(p : uml::DataType)]
  this is a data type: [p.name/]
[/template]

[template public test6(p : uml::Class)]
  eClass: [p.eClass().name/]
[/template]

