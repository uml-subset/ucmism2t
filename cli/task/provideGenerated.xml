<project name="provideGenerated" default="default">
	<target name="default">
		<echo message="BUILDDIR = ${BUILDDIR}" />
		<delete dir="${BUILDDIR}/field-level-documentation" />
		<copy todir="${BUILDDIR}/field-level-documentation">
			<fileset dir="generated/DDI-CDI_1-0/doc/_build">
				<include name="**" />
				<exclude name="_plantuml/**" />
				<exclude name="_sources/**" />
			</fileset>
		</copy>
		<delete dir="${BUILDDIR}/encoding" />
		<copy todir="${BUILDDIR}/encoding">
			<fileset dir="generated/DDI-CDI_1-0/encoding">
				<include name="**" />
			</fileset>
		</copy>
	</target>
</project>