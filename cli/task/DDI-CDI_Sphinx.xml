<project name="DDI-CDI_Sphinx" default="sphinx-build">
	<target name="sphinx-build">
		<property environment="env" />
		<!-- <record name="${env.LOG_FOLDER}/step3_sphinx_ant.log" /> -->
		<exec executable="sphinx-build" output="${env.LOG_FOLDER}/step3_sphinx_output.log">
		<!-- <exec executable="sphinx-build" error="${env.LOG_FOLDER}/step3_sphinx_error.log" output="${env.LOG_FOLDER}/step3_sphinx_output.log"> -->
			<arg line="-b html" />
			<arg line="-c ${env.UCMISM2T_DIR}/sphinx/bookTheme" />
			<arg line="-w ${env.LOG_FOLDER}/step3_sphinx_warning.log" />
			<arg line="-n" />
			<arg line="-D copyright=&quot;2026, DDI Alliance&quot;" />
			<arg line="-D html_logo=&quot;${env.UCMISM2T_DIR}/logo/cdi.svg&quot;" />
			<arg line="-D html_title=&quot;UML Model: DDI Cross Domain Integration (DDI-CDI 1.0)&quot;" />
			<arg line="${env.GENERATED_FOLDER}/DDI-CDI_1-0/doc/_rst" />
			<arg line="${env.GENERATED_FOLDER}/DDI-CDI_1-0/doc/_build" />
		</exec>
	</target>
</project>