<project name="allSteps" default="all">
	<target name="timestamp">
		<tstamp>
			<format property="current.time" pattern="yyyy-MM-dd'T'HH:mm:ss" />
		</tstamp>
		<echo message="*** ${message} ${current.time}" />
	</target>
	<target name="all">
		<echo message="*** ${basedir}" />
		<antcall target="timestamp">
			<param name="message" value="Start" />
		</antcall>
		<ant antfile="tasks/ucmis.m2t.xml" />
		<antcall target="timestamp">
			<param name="message" value="After step1" />
		</antcall>
		<ant antfile="tasks/preSphinx.xml" />
		<antcall target="timestamp">
			<param name="message" value="After step2" />
		</antcall>
		<ant antfile="tasks/DDI-CDI_Sphinx.xml" />
		<antcall target="timestamp">
			<param name="message" value="After step3" />
		</antcall>
	</target>
</project>