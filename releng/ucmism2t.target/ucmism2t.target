<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  Target Platform Definition for ucmism2t
  
  This file defines all Eclipse dependencies required to build and run
  the ucmism2t application. It specifies exact P2 repository locations
  for Eclipse 2025-12 and Acceleo 4.2.
  
  The target platform is resolved by Tycho during the build process
  to provide all required OSGi bundles and their transitive dependencies.
-->
<target name="ucmism2t Target Platform" sequenceNumber="1">
    <locations>
        <!-- 
          Eclipse 2025-12 Release
          
          This includes:
          - Eclipse Platform (core OSGi runtime)
          - EMF (Eclipse Modeling Framework) for model handling
          - UML2 5.0.0 for UML model support
          - Required Eclipse bundles for standalone execution
        -->
        <location includeAllPlatforms="false" 
                  includeConfigurePhase="true" 
                  includeMode="planner" 
                  includeSource="true" 
                  type="InstallableUnit">
            <repository location="https://download.eclipse.org/releases/2025-12/"/>
            
            <!-- Core Eclipse Platform -->
            <unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
            
            <!-- EMF Core (required for all model operations) -->
            <unit id="org.eclipse.emf.ecore.feature.group" version="0.0.0"/>
            <unit id="org.eclipse.emf.common.feature.group" version="0.0.0"/>
            <unit id="org.eclipse.emf.ecore.xmi" version="0.0.0"/>
            
            <!-- UML2 5.0.0 Support -->
            <unit id="org.eclipse.uml2.uml" version="0.0.0"/>
            <unit id="org.eclipse.uml2.types" version="0.0.0"/>
            <unit id="org.eclipse.uml2.common" version="0.0.0"/>
            <unit id="org.eclipse.uml2.uml.resources" version="0.0.0"/>
            
            <!-- Equinox runtime components for standalone execution -->
            <unit id="org.eclipse.equinox.launcher" version="0.0.0"/>
            <unit id="org.eclipse.equinox.app" version="0.0.0"/>
            
            <!-- Eclipse executable for native launchers (required by product) -->
            <unit id="org.eclipse.equinox.executable.feature.group" version="0.0.0"/>
        </location>
        
        <!-- 
          Acceleo 4.2 Release (R202602100910)
          
          MINIMAL APPROACH: Reference only main bundles, let Tycho resolve dependencies.
          
          We reference only the essential bundles:
          - org.eclipse.acceleo.aql (main template engine)
          - org.eclipse.acceleo.query (AQL runtime)
          
          Tycho will automatically resolve all transitive dependencies
          (parser, IDE components, etc.) from the P2 repository.
        -->
        <location includeAllPlatforms="false" 
                  includeConfigurePhase="true" 
                  includeMode="planner" 
                  includeSource="true" 
                  type="InstallableUnit">
            <repository location="https://download.eclipse.org/acceleo/updates/releases/4.2/R202602100910/"/>
            
            <!-- Main Acceleo 4.2 engine -->
            <unit id="org.eclipse.acceleo.aql" version="0.0.0"/>
            
            <!-- AQL query language runtime -->
            <unit id="org.eclipse.acceleo.query" version="0.0.0"/>
        </location>
    </locations>
</target>
